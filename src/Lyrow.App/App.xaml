<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Lyrow.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lyrow.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="LyrowAccentBrush" Color="#89B4FA" />
            <SolidColorBrush x:Key="LyrowSuccessBrush" Color="#10B981" />
            <SolidColorBrush x:Key="LyrowStoppedBrush" Color="#71717A" />
            <SolidColorBrush x:Key="LyrowSurfaceBrush" Color="#1E1E2E" />
            <SolidColorBrush x:Key="LyrowCardBorderBrush" Color="#313244" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
