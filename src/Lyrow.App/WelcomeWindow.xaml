<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lyrow.App.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Welcome to Lyrow"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="WelcomeRootLayout" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom WinUI 3 TitleBar -->
        <TitleBar x:Name="WelcomeTitleBar" Grid.Row="0" Canvas.ZIndex="100">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/lyrow.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Top 5-Step Progress Header -->
        <Grid Grid.Row="1" Padding="36,8,36,8" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" AutomationProperties.Name="Onboarding Step Progress">
                <Border x:Name="StepDot0" Width="28" Height="5" CornerRadius="2.5" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                <Border x:Name="StepDot1" Width="18" Height="5" CornerRadius="2.5" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Border x:Name="StepDot2" Width="18" Height="5" CornerRadius="2.5" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Border x:Name="StepDot3" Width="18" Height="5" CornerRadius="2.5" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Border x:Name="StepDot4" Width="18" Height="5" CornerRadius="2.5" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
            </StackPanel>
            <TextBlock x:Name="TxtWelcomeStepCounter" Grid.Column="1" Text="Step 1 of 5" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
        </Grid>

        <!-- Main Step Viewport (Scrollable safety on small displays, never clips) -->
        <ScrollViewer x:Name="WelcomeStepScrollViewer" Grid.Row="2"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="36,6,36,12">
            <Grid x:Name="StepContentHost" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="StepContentTranslate" Y="0" />
                </Grid.RenderTransform>

                <!-- ==================== STEP 1: WELCOME ==================== -->
                <Grid x:Name="StepPanelWelcome" Visibility="Visible" RowDefinitions="*,Auto" RowSpacing="16">
                    <!-- Hero Banner Card with v4.5 Artwork & Brand Logo -->
                    <Border Grid.Row="0" CornerRadius="14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" MinHeight="240">
                        <Grid>
                            <!-- Decorative Hero Artwork (aspect-preserved UniformToFill, soft opacity) -->
                            <Border CornerRadius="13">
                                <Image Stretch="UniformToFill" Opacity="0.34" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image.Source>
                                        <BitmapImage UriSource="ms-appx:///Assets/lyrow-welcome-hero.png" DecodePixelWidth="960" />
                                    </Image.Source>
                                </Image>
                            </Border>

                            <!-- Readability Scrim (adapts cleanly to Light & Dark theme) -->
                            <Border CornerRadius="13" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" Opacity="0.72" />

                            <!-- Left/Centered Brand & Copy -->
                            <Grid Padding="28,24" ColumnDefinitions="Auto,*" ColumnSpacing="22" VerticalAlignment="Center">
                                <Image Width="76" Height="76" Stretch="Uniform" VerticalAlignment="Center" AutomationProperties.Name="Lyrow Logo">
                                    <Image.Source>
                                        <BitmapImage UriSource="ms-appx:///Assets/lyrow-logo-300.png" DecodePixelWidth="152" />
                                    </Image.Source>
                                </Image>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtWelcomeStep1Title" Text="Welcome to Lyrow" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="TxtWelcomeStep1Subtitle" Text="Your music. Your atmosphere." FontSize="15" FontWeight="Medium"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="TxtWelcomeStep1Desc"
                                               Text="Discover a new way to experience your music with real-time lyrics, dynamic visuals and personalized audio-reactive lighting."
                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Three Feature Highlights -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Padding="14,12" CornerRadius="10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <FontIcon Glyph="&#xE8D2;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Left" />
                                <TextBlock x:Name="TxtWelcomeFeatLyrics" Text="Real-time Lyrics" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock x:Name="TxtWelcomeFeatLyricsDesc" Text="Word-by-word &amp; line-synced lyrics with instant click-to-seek."
                                           FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Padding="14,12" CornerRadius="10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <FontIcon Glyph="&#xEB9F;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Left" />
                                <TextBlock x:Name="TxtWelcomeFeatVisuals" Text="Dynamic Visuals" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock x:Name="TxtWelcomeFeatVisualsDesc" Text="Artwork-driven ambient colors across Normal, Compact, and Fullscreen."
                                           FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Padding="14,12" CornerRadius="10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <FontIcon Glyph="&#xE793;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Left" />
                                <TextBlock x:Name="TxtWelcomeFeatLighting" Text="Audio-Reactive Lighting" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock x:Name="TxtWelcomeFeatLightingDesc" Text="4-edge screen lighting synchronized to rhythm and album art."
                                           FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ==================== STEP 2: APPEARANCE ==================== -->
                <StackPanel x:Name="StepPanelAppearance" Visibility="Collapsed" Spacing="18">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="TxtWelcomeStep2Title" Text="Make Lyrow Yours" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtWelcomeStep2Desc" Text="Choose the look that feels right for you."
                                   FontSize="13.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14" Margin="0,6,0,0">
                        <!-- System Default Card -->
                        <Button x:Name="BtnThemeCardSystem" Grid.Column="0" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Background="Transparent" BorderThickness="0" CornerRadius="12"
                                AutomationProperties.Name="System Default Theme">
                            <Border x:Name="BorderThemeCardSystem" Padding="16" CornerRadius="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2">
                                <StackPanel Spacing="12">
                                    <!-- Split Light/Dark Visual Preview -->
                                    <Border Height="96" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="*,*">
                                            <Border Grid.Column="0" Background="#1A1B26" CornerRadius="7,0,0,7" Padding="10">
                                                <StackPanel Spacing="6" VerticalAlignment="Bottom">
                                                    <Border Height="6" Width="46" CornerRadius="3" Background="#89B4FA" HorizontalAlignment="Left" />
                                                    <Border Height="5" Width="64" CornerRadius="2.5" Background="#55FFFFFF" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="0,7,7,0" Padding="10">
                                                <StackPanel Spacing="6" VerticalAlignment="Bottom">
                                                    <Border Height="6" Width="46" CornerRadius="3" Background="#1E66F5" HorizontalAlignment="Left" />
                                                    <Border Height="5" Width="64" CornerRadius="2.5" Background="#440F172A" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock x:Name="TxtWelcomeThemeSystem" Text="System Default" FontWeight="SemiBold" FontSize="14" />
                                            <FontIcon x:Name="IconCheckThemeSystem" Grid.Column="1" Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </Grid>
                                        <TextBlock x:Name="TxtWelcomeThemeSystemDesc" Text="Automatically adapts to your Windows 11 theme"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Dark Theme Card -->
                        <Button x:Name="BtnThemeCardDark" Grid.Column="1" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Background="Transparent" BorderThickness="0" CornerRadius="12"
                                AutomationProperties.Name="Dark Theme">
                            <Border x:Name="BorderThemeCardDark" Padding="16" CornerRadius="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <Border Height="96" CornerRadius="8" Background="#141620" BorderBrush="#2EFFFFFF" BorderThickness="1" Padding="12">
                                        <StackPanel Spacing="7" VerticalAlignment="Bottom">
                                            <Border Width="28" Height="28" CornerRadius="6" Background="#2689B4FA" HorizontalAlignment="Left" Margin="0,0,0,6" />
                                            <Border Height="6" Width="80" CornerRadius="3" Background="#89B4FA" HorizontalAlignment="Left" />
                                            <Border Height="5" Width="110" CornerRadius="2.5" Background="#55FFFFFF" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock x:Name="TxtWelcomeThemeDark" Text="Dark" FontWeight="SemiBold" FontSize="14" />
                                            <FontIcon x:Name="IconCheckThemeDark" Grid.Column="1" Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
                                        </Grid>
                                        <TextBlock x:Name="TxtWelcomeThemeDarkDesc" Text="Deep, low-glare surfaces crafted for immersive listening"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Light Theme Card -->
                        <Button x:Name="BtnThemeCardLight" Grid.Column="2" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Background="Transparent" BorderThickness="0" CornerRadius="12"
                                AutomationProperties.Name="Light Theme">
                            <Border x:Name="BorderThemeCardLight" Padding="16" CornerRadius="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <Border Height="96" CornerRadius="8" Background="#F8FAFC" BorderBrush="#260F172A" BorderThickness="1" Padding="12">
                                        <StackPanel Spacing="7" VerticalAlignment="Bottom">
                                            <Border Width="28" Height="28" CornerRadius="6" Background="#221E66F5" HorizontalAlignment="Left" Margin="0,0,0,6" />
                                            <Border Height="6" Width="80" CornerRadius="3" Background="#1E66F5" HorizontalAlignment="Left" />
                                            <Border Height="5" Width="110" CornerRadius="2.5" Background="#440F172A" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock x:Name="TxtWelcomeThemeLight" Text="Light" FontWeight="SemiBold" FontSize="14" />
                                            <FontIcon x:Name="IconCheckThemeLight" Grid.Column="1" Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
                                        </Grid>
                                        <TextBlock x:Name="TxtWelcomeThemeLightDesc" Text="Clean, airy Fluent surfaces with crisp contrast"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- ==================== STEP 3: YOUR EXPERIENCE ==================== -->
                <StackPanel x:Name="StepPanelExperience" Visibility="Collapsed" Spacing="12">
                    <StackPanel Spacing="4" Margin="0,0,0,4">
                        <TextBlock x:Name="TxtWelcomeStep3Title" Text="Shape Your Experience" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtWelcomeStep3Desc" Text="Personalize the way Lyrow responds to your music."
                                   FontSize="13.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Edge Light Preference Card -->
                    <Border Padding="16,14" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                <FontIcon Grid.Column="0" Glyph="&#xE793;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock x:Name="TxtWelcomeEdgeLightLabel" Text="Enable Edge Light" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock x:Name="TxtWelcomeEdgeLightDesc"
                                               Text="Project soft, music-reactive colors along all four screen edges (can be toggled anytime from the toolbar)."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox x:Name="ChkWelcomeEdgeLight" Grid.Column="2" MinWidth="0" VerticalAlignment="Center"
                                          AutomationProperties.Name="Enable Edge Light" />
                            </Grid>
                            <TextBlock x:Name="TxtWelcomeEdgeLightNoAudio" Visibility="Collapsed"
                                       Text="No active audio output endpoint was detected yet. Edge Light will activate automatically once an audio device becomes available."
                                       FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="32,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Dynamic Background Preference Card -->
                    <Border Padding="16,14" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                            <FontIcon Grid.Column="0" Glyph="&#xEB9F;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="TxtWelcomeDynamicBgLabel" Text="Enable Dynamic Background" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock x:Name="TxtWelcomeDynamicBgDesc"
                                           Text="Blend subtle colors extracted from the current album cover into the window backdrop."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox x:Name="ChkWelcomeDynamicBg" Grid.Column="2" MinWidth="0" VerticalAlignment="Center"
                                      AutomationProperties.Name="Enable Dynamic Background" />
                        </Grid>
                    </Border>

                    <!-- Compact Mode Informational Card (No forced choice) -->
                    <Border x:Name="BorderWelcomeCompactInfo" Padding="16,14" CornerRadius="10"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalAlignment="Center">
                            <FontIcon Grid.Column="0" Glyph="&#xE73F;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="TxtWelcomeCompactTitle" Text="Compact Mode Ready Anytime" FontWeight="SemiBold" FontSize="13.5" />
                                <TextBlock x:Name="TxtWelcomeCompactDesc"
                                           Text="Switch effortlessly between the full 50/50 Lyrics view, Fullscreen (F11), and a minimal Compact desktop player directly from the transport bar."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ==================== STEP 4: AUDIO ==================== -->
                <StackPanel x:Name="StepPanelAudio" Visibility="Collapsed" Spacing="12">
                    <StackPanel Spacing="4" Margin="0,0,0,4">
                        <TextBlock x:Name="TxtWelcomeStep4Title" Text="Audio Experience" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtWelcomeStep4Desc" Text="Choose how Lyrow interacts with your audio."
                                   FontSize="13.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Friendly Empty-Device Notice (shown only when 0 endpoints exist) -->
                    <Border x:Name="BorderWelcomeNoAudioDevices" Visibility="Collapsed" Padding="14,12" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtWelcomeNoAudioDevices" Grid.Column="1"
                                       Text="No active audio playback devices were detected right now. Lyrow will automatically use your Windows default output when audio becomes available."
                                       FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <!-- Dynamic Audio Output Device List -->
                    <StackPanel x:Name="PanelWelcomeAudioDevices" Spacing="8" />

                    <!-- Privacy & Edge Light Audio Analysis Note -->
                    <Border Padding="14,12" CornerRadius="10"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                            <FontIcon Grid.Column="0" Glyph="&#xE793;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtWelcomeAudioEdgeLightNote" Grid.Column="1"
                                       Text="Edge Light analyzes output spectrum energy locally in memory in real time — audio is never recorded or transmitted."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ==================== STEP 5: READY ==================== -->
                <StackPanel x:Name="StepPanelReady" Visibility="Collapsed" Spacing="16" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,6,0,2">
                        <Image Width="68" Height="68" Stretch="Uniform" HorizontalAlignment="Center" AutomationProperties.Name="Lyrow Logo">
                            <Image.Source>
                                <BitmapImage UriSource="ms-appx:///Assets/lyrow-logo-300.png" DecodePixelWidth="136" />
                            </Image.Source>
                        </Image>
                        <TextBlock x:Name="TxtWelcomeStep5Title" Text="You're All Set!" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock x:Name="TxtWelcomeStep5Subtitle" Text="Your music experience starts here." FontSize="14.5" FontWeight="Medium"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock x:Name="TxtWelcomeStep5Desc"
                                   Text="Lyrow is ready. Enjoy your music with beautiful lyrics, visuals and lighting."
                                   FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="540" />
                    </StackPanel>

                    <!-- Selected Preferences Summary Card -->
                    <Border Padding="20,16" CornerRadius="12" MaxWidth="560" HorizontalAlignment="Stretch"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="TxtWelcomeSummaryTitle" Text="Your Setup Summary" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,2" />

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock x:Name="TxtSummaryLabelTheme" Text="Theme" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TxtSummaryValueTheme" Grid.Column="1" Text="System Default" FontSize="13" FontWeight="Medium" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock x:Name="TxtSummaryLabelEdgeLight" Text="Edge Light" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TxtSummaryValueEdgeLight" Grid.Column="1" Text="Off" FontSize="13" FontWeight="Medium" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock x:Name="TxtSummaryLabelDynamicBg" Text="Dynamic Background" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TxtSummaryValueDynamicBg" Grid.Column="1" Text="Enabled" FontSize="13" FontWeight="Medium" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                <TextBlock x:Name="TxtSummaryLabelAudio" Text="Audio Output" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TxtSummaryValueAudio" Grid.Column="1" Text="Default" FontSize="13" FontWeight="Medium"
                                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- Consistent Bottom Navigation Bar -->
        <Border Grid.Row="3" Padding="36,14,36,22"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Background="{ThemeResource LayerFillColorAltBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnWelcomeBack" Content="Back" Visibility="Collapsed" MinWidth="88" Height="36" CornerRadius="8"
                            AutomationProperties.Name="Back" />
                    <Button x:Name="BtnWelcomeSkip" Content="Skip Setup" Style="{StaticResource LyrowGhostButtonStyle}"
                            Padding="14,0" Height="36" CornerRadius="8"
                            AutomationProperties.Name="Skip Setup" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Button x:Name="BtnWelcomeGetStarted" Content="Get Started" Style="{ThemeResource AccentButtonStyle}"
                            MinWidth="136" Height="36" CornerRadius="8"
                            AutomationProperties.Name="Get Started" />
                    <Button x:Name="BtnWelcomeContinue" Content="Continue" Style="{ThemeResource AccentButtonStyle}"
                            Visibility="Collapsed" MinWidth="124" Height="36" CornerRadius="8"
                            AutomationProperties.Name="Continue" />
                    <Button x:Name="BtnWelcomeStartListening" Content="Start Listening" Style="{ThemeResource AccentButtonStyle}"
                            Visibility="Collapsed" MinWidth="152" Height="36" CornerRadius="8"
                            AutomationProperties.Name="Start Listening" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
