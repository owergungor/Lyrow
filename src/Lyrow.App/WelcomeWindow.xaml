<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lyrow.App.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Welcome to Lyrow"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="WelcomeRootLayout" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom WinUI 3 TitleBar -->
        <TitleBar x:Name="WelcomeTitleBar" Grid.Row="0" Canvas.ZIndex="100">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/lyrow.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Single-Screen Content Viewport (Scrollable safety only on extreme small displays) -->
        <ScrollViewer x:Name="WelcomeScrollViewer" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="36,4,36,24">
            <StackPanel x:Name="WelcomeContentHost" Spacing="16" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="WelcomeContentTranslate" Y="0" />
                </StackPanel.RenderTransform>

                <!-- Hero Banner with Lyrow Brand Artwork, Logo, Headline & One-Line Value Prop -->
                <Border CornerRadius="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Height="208">
                    <Grid>
                        <!-- Soft Ambient Hero Artwork -->
                        <Border CornerRadius="15">
                            <Image Stretch="UniformToFill" Opacity="0.32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image.Source>
                                    <BitmapImage UriSource="ms-appx:///Assets/lyrow-welcome-hero.png" DecodePixelWidth="960" />
                                </Image.Source>
                            </Image>
                        </Border>

                        <!-- Readability Scrim (adapts cleanly to Light & Dark system themes) -->
                        <Border CornerRadius="15" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" Opacity="0.72" />

                        <!-- Centered Brand Logo & Copy -->
                        <StackPanel Padding="28,20" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center" AutomationProperties.Name="Lyrow Logo">
                                <Image.Source>
                                    <BitmapImage UriSource="ms-appx:///Assets/lyrow-logo-300.png" DecodePixelWidth="128" />
                                </Image.Source>
                            </Image>
                            <TextBlock x:Name="TxtWelcomeHeadline"
                                       Text="Your Music. Your Lyrics. Your Atmosphere."
                                       FontSize="22" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock x:Name="TxtWelcomeSubtitle"
                                       Text="Lyrow brings your lyrics and music visuals together in one beautiful experience."
                                       FontSize="13.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="500" LineHeight="20" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Three Short, Clear Benefits -->
                <StackPanel Spacing="8">
                    <Border Padding="16,12" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalAlignment="Center">
                            <FontIcon Grid.Column="0" Glyph="&#xE8D2;" FontSize="17"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtWelcomeBenefit1" Grid.Column="1"
                                       Text="Follow lyrics in real time with your music."
                                       FontSize="13.5" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Padding="16,12" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalAlignment="Center">
                            <FontIcon Grid.Column="0" Glyph="&#xEB9F;" FontSize="17"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtWelcomeBenefit2" Grid.Column="1"
                                       Text="Discover visuals that move with your music."
                                       FontSize="13.5" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Padding="16,12" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalAlignment="Center">
                            <FontIcon Grid.Column="0" Glyph="&#xE793;" FontSize="17"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtWelcomeBenefit3" Grid.Column="1"
                                       Text="Experience audio-reactive lighting effects."
                                       FontSize="13.5" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Primary CTA & Quiet Secondary Option -->
                <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Button x:Name="BtnWelcomeStartListening"
                            Content="Start Listening"
                            Style="{ThemeResource AccentButtonStyle}"
                            MinWidth="248" Height="44" CornerRadius="10"
                            FontSize="15" FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Start Listening" />

                    <Button x:Name="BtnWelcomeCustomizeLater"
                            Content="Customize later"
                            Style="{StaticResource LyrowGhostButtonStyle}"
                            Padding="14,0" Height="32" CornerRadius="8"
                            FontSize="12.5"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Customize later" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
