<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="800"
        Width="880" Height="800"
        MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource LyrowWindowBackground}"
        Icon="avares://Lyrow.App/Assets/lyrow.ico"
        x:Class="Lyrow.App.MainWindow"
        Title="Lyrow — Multimedya Deneyim Merkezi">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28" Spacing="18">
            
            <!-- 1. Header Section -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Lyrow" Classes="header" Foreground="{DynamicResource LyrowTextPrimary}" />
                    <TextBlock Text="Ses-duyarlı görselleştirme ve senkronize şarkı sözü platformu" Classes="subheader" Foreground="{DynamicResource LyrowTextSecondary}" />
                </StackPanel>

                <!-- Current Execution Mode Badge -->
                <Border Grid.Column="1" 
                        x:Name="ModeBadgeBorder"
                        Background="{DynamicResource LyrowBadgeBackground}" 
                        CornerRadius="12" 
                        Padding="14,8"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="ModeBadgeText" 
                               Text="Mod: Yükleniyor..." 
                               FontWeight="SemiBold" 
                               FontSize="13" 
                               Foreground="#89B4FA" />
                </Border>
            </Grid>

            <!-- 2. Live Media & Audio Activity Banner -->
            <Border Background="{DynamicResource LyrowCardBackground}"
                    BorderBrush="{DynamicResource LyrowBorderBrush}"
                    BorderThickness="1"
                    Classes="neumorphic-card">
                <Grid ColumnDefinitions="*,Auto" Margin="4">
                    <!-- Left: Playing Song Info -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="10" Background="{DynamicResource LyrowInnerContainerBackground}" BorderBrush="{DynamicResource LyrowBorderBrush}" BorderThickness="1">
                            <TextBlock Text="🎵" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"/>
                        </Border>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="LiveTrackTitleText" Text="Şarkı Bekleniyor..." FontWeight="Bold" FontSize="15" Foreground="{DynamicResource LyrowTextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="340"/>
                                <Border x:Name="LivePlaybackBadge" Background="{DynamicResource LyrowBadgeBackground}" CornerRadius="6" Padding="6,2">
                                    <TextBlock x:Name="LivePlaybackText" Text="Boşta" FontSize="10" Foreground="{DynamicResource LyrowTextSecondary}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="LiveTrackArtistText" Text="Spotify veya Medya Oynatıcıyı Başlatın" FontSize="12" Foreground="{DynamicResource LyrowTextMuted}" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Live Lyrics & Audio Status Badges -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Background="{DynamicResource LyrowInnerContainerBackground}" CornerRadius="8" Padding="10,6" BorderBrush="{DynamicResource LyrowBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Söz Durumu" FontSize="10" Foreground="{DynamicResource LyrowTextMuted}"/>
                                <TextBlock x:Name="LiveLyricsStatusText" Text="Bekleniyor" FontWeight="SemiBold" FontSize="11" Foreground="#89B4FA"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource LyrowInnerContainerBackground}" CornerRadius="8" Padding="10,6" BorderBrush="{DynamicResource LyrowBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Ses Seviyesi" FontSize="10" Foreground="{DynamicResource LyrowTextMuted}"/>
                                <TextBlock x:Name="LiveAudioMeterText" Text="-90 dBFS" FontWeight="SemiBold" FontSize="11" Foreground="#A6E3A1"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. 4 Discrete Execution Modes Selector -->
            <Border Background="{DynamicResource LyrowCardBackground}"
                    BorderBrush="{DynamicResource LyrowBorderBrush}"
                    BorderThickness="1"
                    Classes="neumorphic-card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Hızlı Çalışma Durumları (4 Temel Mod)" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource LyrowTextPrimary}" />
                    <Grid ColumnDefinitions="*,*,*,*" Margin="0,2,0,0">
                        <Button Grid.Column="0" x:Name="BtnModeBothDisabled" Content="İkisi Kapalı" Classes="action-button" Margin="0,0,6,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnModeBothDisabledClick" />
                        <Button Grid.Column="1" x:Name="BtnModeLumnOnly" Content="Yalnızca Lumn" Classes="action-button" Margin="3,0,3,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnModeLumnOnlyClick" />
                        <Button Grid.Column="2" x:Name="BtnModeVerciOnly" Content="Yalnızca Verci" Classes="action-button" Margin="3,0,3,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnModeVerciOnlyClick" />
                        <Button Grid.Column="3" x:Name="BtnModeBothEnabled" Content="İkisi Birlikte" Classes="action-button" Margin="6,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnModeBothEnabledClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. Modules Grid -->
            <Grid ColumnDefinitions="*,*" Margin="0,2">
                <!-- Lumn Card -->
                <Border Grid.Column="0" 
                        Margin="0,0,8,0" 
                        Background="{DynamicResource LyrowCardBackground}"
                        BorderBrush="{DynamicResource LyrowBorderBrush}"
                        BorderThickness="1"
                        Classes="neumorphic-card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Lumn" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource LyrowTextPrimary}" />
                                <TextBlock Text="Ses Analizi &amp; Işık Efektleri" Classes="subheader" Foreground="{DynamicResource LyrowTextSecondary}" />
                            </StackPanel>
                            <Border Grid.Column="1" x:Name="LumnStatusBorder" CornerRadius="8" Padding="10,4" Background="#334155">
                                <TextBlock x:Name="LumnStatusText" Text="Stopped" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                            </Border>
                        </Grid>
                        <TextBlock Text="WASAPI Loopback ile sistem sesini donanım hızlandırmalı frekans spektrumuna ve ritmik ışık efektlerine dönüştürür."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource LyrowTextMuted}" />
                        
                        <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                            <TextBlock Text="Pencere Durumu:" FontSize="11" Foreground="{DynamicResource LyrowTextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="LumnWindowStateText" Text="Kapalı" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource LyrowTextSecondary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,*">
                            <Button x:Name="BtnToggleLumn" 
                                    Content="Lumn'u Başlat" 
                                    Classes="action-button" 
                                    HorizontalAlignment="Stretch" 
                                    HorizontalContentAlignment="Center" 
                                    Margin="0,0,4,0"
                                    Click="OnToggleLumnClick" />
                            <Button x:Name="BtnOpenVisualizer" 
                                    Grid.Column="1"
                                    Content="Spektrum Penceresi" 
                                    Classes="action-button" 
                                    HorizontalAlignment="Stretch" 
                                    HorizontalContentAlignment="Center"
                                    Margin="4,0,0,0"
                                    Click="OnOpenVisualizerClick" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Verci Card -->
                <Border Grid.Column="1" 
                        Margin="8,0,0,0" 
                        Background="{DynamicResource LyrowCardBackground}"
                        BorderBrush="{DynamicResource LyrowBorderBrush}"
                        BorderThickness="1"
                        Classes="neumorphic-card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Verci" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource LyrowTextPrimary}" />
                                <TextBlock Text="Senkronize Sözler &amp; Metadata" Classes="subheader" Foreground="{DynamicResource LyrowTextSecondary}" />
                            </StackPanel>
                            <Border Grid.Column="1" x:Name="VerciStatusBorder" CornerRadius="8" Padding="10,4" Background="#334155">
                                <TextBlock x:Name="VerciStatusText" Text="Stopped" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                            </Border>
                        </Grid>
                        <TextBlock Text="Windows GSMTC üzerinden çalan şarkıyı tespit eder; LRCLIB ile senkronize şarkı sözlerini yüzen pencerede gösterir."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource LyrowTextMuted}" />
                        
                        <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                            <TextBlock Text="Pencere Durumu:" FontSize="11" Foreground="{DynamicResource LyrowTextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="VerciWindowStateText" Text="Kapalı" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource LyrowTextSecondary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,*">
                            <Button x:Name="BtnToggleVerci" 
                                    Content="Verci'yi Başlat" 
                                    Classes="action-button" 
                                    HorizontalAlignment="Stretch" 
                                    HorizontalContentAlignment="Center"
                                    Margin="0,0,4,0"
                                    Click="OnToggleVerciClick" />
                            <Button x:Name="BtnOpenLyrics" 
                                    Grid.Column="1"
                                    Content="Sözler Penceresi" 
                                    Classes="action-button" 
                                    HorizontalAlignment="Stretch" 
                                    HorizontalContentAlignment="Center"
                                    Margin="4,0,0,0"
                                    Click="OnOpenLyricsClick" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 5. Advanced Settings & User Preferences Section -->
            <Border Background="{DynamicResource LyrowCardBackground}"
                    BorderBrush="{DynamicResource LyrowBorderBrush}"
                    BorderThickness="1"
                    Classes="neumorphic-card">
                <StackPanel Spacing="16">
                    <TextBlock Text="Görünüm, Monitör ve Kullanıcı Ayarları" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource LyrowTextPrimary}" />
                    
                    <!-- Theme Selector -->
                    <Grid ColumnDefinitions="200,*" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="Uygulama Teması:" VerticalAlignment="Center" Foreground="{DynamicResource LyrowTextSecondary}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
                            <RadioButton x:Name="RbThemeSystem" Content="Sistem Varsayılanı" IsChecked="True" IsCheckedChanged="OnThemeChanged" />
                            <RadioButton x:Name="RbThemeDark" Content="Koyu Tema" IsCheckedChanged="OnThemeChanged" />
                            <RadioButton x:Name="RbThemeLight" Content="Açık Tema" IsCheckedChanged="OnThemeChanged" />
                        </StackPanel>
                    </Grid>

                    <Separator Height="1" Background="{DynamicResource LyrowBorderBrush}" Opacity="0.5"/>

                    <!-- Monitor & Overlay Placement -->
                    <Grid ColumnDefinitions="200,*" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="Hedef Monitör:" VerticalAlignment="Center" Foreground="{DynamicResource LyrowTextSecondary}" />
                        <ComboBox x:Name="CboTargetMonitor" Grid.Column="1" Width="260" HorizontalAlignment="Left" />
                    </Grid>

                    <Grid ColumnDefinitions="200,*" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="Overlay Yerleşimi:" VerticalAlignment="Center" Foreground="{DynamicResource LyrowTextSecondary}" />
                        <ComboBox x:Name="CboOverlayPosition" Grid.Column="1" Width="260" HorizontalAlignment="Left" />
                    </Grid>

                    <Separator Height="1" Background="{DynamicResource LyrowBorderBrush}" Opacity="0.5"/>

                    <!-- Click-through Toggle -->
                    <Grid ColumnDefinitions="200,*" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="Tıklama Geçirgenliği:" VerticalAlignment="Center" Foreground="{DynamicResource LyrowTextSecondary}" />
                        <CheckBox x:Name="ChkClickThrough" 
                                  Content="Overlay pencerelerinde arka plana tıklamaya izin ver (Click-Through / WS_EX_TRANSPARENT)" 
                                  IsCheckedChanged="OnClickThroughChanged" />
                    </Grid>

                    <!-- Lumn Sensitivity Slider -->
                    <Grid ColumnDefinitions="200,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="Lumn Spektrum Hassasiyeti:" VerticalAlignment="Center" Foreground="{DynamicResource LyrowTextSecondary}" />
                        <Slider x:Name="SliderLumnSensitivity" Grid.Column="1" Minimum="0.5" Maximum="2.5" Value="1.0" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtSensitivityValue" Grid.Column="2" Text="1.0x" Width="40" FontSize="12" Foreground="{DynamicResource LyrowTextMuted}" VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Height="1" Background="{DynamicResource LyrowBorderBrush}" Opacity="0.5"/>

                    <!-- Verci Lyrics Preferences -->
                    <Grid ColumnDefinitions="200,*" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="Şarkı Sözü Tercihleri:" VerticalAlignment="Center" Foreground="{DynamicResource LyrowTextSecondary}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20">
                            <CheckBox x:Name="ChkAutoFetchLyrics" Content="Otomatik Söz Çekme (LRCLIB)" IsChecked="True" />
                            <CheckBox x:Name="ChkCacheLyrics" Content="Yerel Diske Önbellekle" IsChecked="True" />
                        </StackPanel>
                    </Grid>

                    <!-- Status Notification Text -->
                    <Border Background="{DynamicResource LyrowInnerContainerBackground}" CornerRadius="8" Padding="12,10" BorderBrush="{DynamicResource LyrowBorderBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="ℹ️" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="StatusMessageText" 
                                       Text="Lyrow hazır. Modüller ve overlay pencereleri bağımsız olarak yönetilebilir." 
                                       FontSize="12" 
                                       Foreground="{DynamicResource LyrowTextSecondary}" 
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
