<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="840"
        Width="880" Height="840"
        MinWidth="760" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource LyrowWindowBackground}"
        Icon="avares://Lyrow.App/Assets/lyrow.ico"
        x:Class="Lyrow.App.MainWindow"
        Title="Lyrow v1.2 — Multimedya Deneyim Merkezi">

    <Grid>
        <!-- Scrollable Main Dashboard Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28" Spacing="20">
                
                <!-- 1. Header Section (Clean Vercel/Apple Minimalist Top Bar) -->
                <StackPanel Spacing="4" Margin="0,0,0,2">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Lyrow" Classes="header" />
                        <Border Background="{DynamicResource LyrowInnerContainerBackground}" 
                                BorderBrush="{DynamicResource LyrowBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6" 
                                Padding="8,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="v1.2" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource LyrowAccent}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Masaüstü ortam ses görselleştirme ve senkronize şarkı sözü platformu" Classes="subheader" />
                </StackPanel>

                <!-- 2. Live Media & Currently Playing Track Card (Fixed Geometry: 76px) -->
                <Border Classes="vercel-card" Height="76" MinHeight="76" MaxHeight="76">
                    <Grid ColumnDefinitions="Auto,*" Margin="2" VerticalAlignment="Center">
                        <!-- Album Cover Art / Icon -->
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10" ClipToBounds="True"
                                Background="{DynamicResource LyrowInnerContainerBackground}" 
                                BorderBrush="{DynamicResource LyrowBorderBrush}" 
                                BorderThickness="1"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center">
                            <Panel>
                                <Image x:Name="LiveArtworkImage" Width="48" Height="48" Stretch="UniformToFill" IsVisible="False"/>
                                <TextBlock x:Name="LiveArtworkPlaceholder" Text="🎵" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85"/>
                            </Panel>
                        </Border>

                        <!-- Song Info -->
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock x:Name="LiveTrackTitleText" Text="Şarkı Bekleniyor..." FontWeight="Bold" FontSize="15" Foreground="{DynamicResource LyrowTextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="440"/>
                                <Border x:Name="LivePlaybackBadge" Background="{DynamicResource LyrowInnerContainerBackground}" BorderBrush="{DynamicResource LyrowBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="LivePlaybackText" Text="Boşta" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource LyrowTextSecondary}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="LiveTrackArtistText" Text="Spotify veya Medya Oynatıcıyı Başlatın" FontSize="13" Foreground="{DynamicResource LyrowTextMuted}" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. Main Metrics: Equal visual weight (Fixed Geometry: 104px) -->
                <Grid ColumnDefinitions="*,*" Height="104" Margin="0,2">
                    <!-- Sol: Ses Seviyesi (Volume) -->
                    <Border Grid.Column="0" Margin="0,0,8,0" Classes="vercel-card" Height="104">
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="SES SEVİYESİ" Classes="metric-label" />
                                <TextBlock Grid.Column="1" Text="🔊" FontSize="13" Opacity="0.6"/>
                            </Grid>
                            <TextBlock x:Name="LiveAudioMeterText" Text="-90 dBFS (Sessiz)" Classes="metric-value" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                            <ProgressBar x:Name="VolumeProgressBar" Minimum="0" Maximum="100" Value="0" Height="4" CornerRadius="2" Foreground="{DynamicResource LyrowSuccess}" Background="{DynamicResource LyrowInnerContainerBackground}"/>
                        </StackPanel>
                    </Border>

                    <!-- Sağ: Söz Durumu (Lyrics Status) -->
                    <Border Grid.Column="1" Margin="8,0,0,0" Classes="vercel-card" Height="104">
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="SÖZ DURUMU" Classes="metric-label" />
                                <TextBlock Grid.Column="1" Text="💬" FontSize="13" Opacity="0.6"/>
                            </Grid>
                            <TextBlock x:Name="LiveLyricsStatusText" Text="Bekleniyor" Classes="metric-value" Foreground="{DynamicResource LyrowAccent}" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                            <TextBlock Text="LRCLIB Senkronizasyon" FontSize="11" Foreground="{DynamicResource LyrowTextMuted}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 4. Interactive Modules Grid (Fixed Geometry: 200px) -->
                <Grid ColumnDefinitions="*,*" Height="200" Margin="0,2">
                    <!-- Glow Card -->
                    <Border Grid.Column="0" Margin="0,0,8,0" Classes="vercel-card" Height="200">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Glow" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource LyrowTextPrimary}" />
                                    <TextBlock Text="Ortam Işıklandırma &amp; Ses Spektrumu" Classes="subheader" />
                                </StackPanel>
                                <Border Grid.Column="1" x:Name="LumnStatusBorder" CornerRadius="8" Padding="10,4" Background="{DynamicResource LyrowInnerContainerBackground}" BorderBrush="{DynamicResource LyrowBorderBrush}" BorderThickness="1">
                                    <TextBlock x:Name="LumnStatusText" Text="Durduruldu" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource LyrowTextMuted}" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" Spacing="6" Margin="0,10,0,0">
                                <TextBlock Text="Müziğin ritmine ve bas frekanslarına tepki veren 4 kenarlı ortam ışıklandırması ve WASAPI ses analizi."
                                           TextWrapping="Wrap" MaxHeight="36" FontSize="12" Foreground="{DynamicResource LyrowTextMuted}" TextTrimming="CharacterEllipsis" />
                                <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                    <TextBlock Text="Pencere Durumu:" FontSize="11" Foreground="{DynamicResource LyrowTextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="LumnWindowStateText" Text="Kapalı" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource LyrowTextSecondary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <Grid Grid.Row="2" ColumnDefinitions="*,*">
                                <Button x:Name="BtnToggleLumn" 
                                        Content="Glow'u Başlat" 
                                        Classes="action-button" 
                                        HorizontalAlignment="Stretch" 
                                        HorizontalContentAlignment="Center" 
                                        Margin="0,0,4,0"
                                        Click="OnToggleLumnClick" />
                                <Button x:Name="BtnOpenVisualizer" 
                                        Grid.Column="1"
                                        Content="Kenar Işığı Aç" 
                                        Classes="action-button" 
                                        HorizontalAlignment="Stretch" 
                                        HorizontalContentAlignment="Center"
                                        Margin="4,0,0,0"
                                        Click="OnOpenVisualizerClick" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Lyrics Card -->
                    <Border Grid.Column="1" Margin="8,0,0,0" Classes="vercel-card" Height="200">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Lyrics" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource LyrowTextPrimary}" />
                                    <TextBlock Text="Senkronize Sözler &amp; Metadata" Classes="subheader" />
                                </StackPanel>
                                <Border Grid.Column="1" x:Name="VerciStatusBorder" CornerRadius="8" Padding="10,4" Background="{DynamicResource LyrowInnerContainerBackground}" BorderBrush="{DynamicResource LyrowBorderBrush}" BorderThickness="1">
                                    <TextBlock x:Name="VerciStatusText" Text="Durduruldu" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource LyrowTextMuted}" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" Spacing="6" Margin="0,10,0,0">
                                <TextBlock Text="Windows GSMTC üzerinden çalan şarkıyı tespit eder; şarkı sözlerini ekranın merkezinde odaklı gösterir."
                                           TextWrapping="Wrap" MaxHeight="36" FontSize="12" Foreground="{DynamicResource LyrowTextMuted}" TextTrimming="CharacterEllipsis" />
                                <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                    <TextBlock Text="Pencere Durumu:" FontSize="11" Foreground="{DynamicResource LyrowTextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="VerciWindowStateText" Text="Kapalı" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource LyrowTextSecondary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <Grid Grid.Row="2" ColumnDefinitions="*,*">
                                <Button x:Name="BtnToggleVerci" 
                                        Content="Lyrics'i Başlat" 
                                        Classes="action-button" 
                                        HorizontalAlignment="Stretch" 
                                        HorizontalContentAlignment="Center" 
                                        Margin="0,0,4,0"
                                        Click="OnToggleVerciClick" />
                                <Button x:Name="BtnOpenLyrics" 
                                        Grid.Column="1"
                                        Content="Sözler Penceresi" 
                                        Classes="action-button" 
                                        HorizontalAlignment="Stretch" 
                                        HorizontalContentAlignment="Center"
                                        Margin="4,0,0,0"
                                        Click="OnOpenLyricsClick" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 5. Advanced Settings & System Controls (Vercel Style Card) -->
                <Border Classes="vercel-card">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Görünüm, Monitör ve Kullanıcı Ayarları" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource LyrowTextPrimary}" />
                        
                        <!-- Theme Selector -->
                        <Grid ColumnDefinitions="220,*" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="Uygulama Teması:" VerticalAlignment="Center" Foreground="{DynamicResource LyrowTextSecondary}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
                                <RadioButton x:Name="RbThemeSystem" Content="Sistem Varsayılanı" IsChecked="True" IsCheckedChanged="OnThemeChanged" />
                                <RadioButton x:Name="RbThemeDark" Content="Koyu Tema" IsCheckedChanged="OnThemeChanged" />
                                <RadioButton x:Name="RbThemeLight" Content="Açık Tema" IsCheckedChanged="OnThemeChanged" />
                            </StackPanel>
                        </Grid>

                        <Separator Height="1" Background="{DynamicResource LyrowBorderBrush}"/>

                        <!-- Monitor & Overlay Placement -->
                        <Grid ColumnDefinitions="220,*" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="Hedef Monitör:" VerticalAlignment="Center" Foreground="{DynamicResource LyrowTextSecondary}" />
                            <ComboBox x:Name="CboTargetMonitor" Grid.Column="1" Width="280" HorizontalAlignment="Left" />
                        </Grid>

                        <Grid ColumnDefinitions="220,*" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="Overlay Yerleşimi:" VerticalAlignment="Center" Foreground="{DynamicResource LyrowTextSecondary}" />
                            <ComboBox x:Name="CboOverlayPosition" Grid.Column="1" Width="280" HorizontalAlignment="Left" />
                        </Grid>

                        <Separator Height="1" Background="{DynamicResource LyrowBorderBrush}"/>

                        <!-- Click-through Toggle (Apple Switch Style) -->
                        <Grid ColumnDefinitions="220,*,Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="Tıklama Geçirgenliği:" VerticalAlignment="Center" Foreground="{DynamicResource LyrowTextSecondary}" />
                            <TextBlock Grid.Column="1" Text="Overlay pencerelerinde fare tıklamalarını arkadaki uygulamalara geçir (Click-Through)" FontSize="12" Foreground="{DynamicResource LyrowTextMuted}" VerticalAlignment="Center"/>
                            <ToggleSwitch x:Name="ChkClickThrough" Grid.Column="2" IsCheckedChanged="OnClickThroughChanged" />
                        </Grid>

                        <!-- Glow Sensitivity Slider -->
                        <Grid ColumnDefinitions="220,*,Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="Glow Hassasiyeti:" VerticalAlignment="Center" Foreground="{DynamicResource LyrowTextSecondary}" />
                            <Slider x:Name="SliderLumnSensitivity" Grid.Column="1" Minimum="0.5" Maximum="2.5" Value="1.0" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSensitivityValue" Grid.Column="2" Text="1.0x" Width="40" FontSize="12" Foreground="{DynamicResource LyrowTextMuted}" VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Height="1" Background="{DynamicResource LyrowBorderBrush}"/>

                        <!-- Lyrics Preferences & Offset -->
                        <Grid ColumnDefinitions="220,*" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="Şarkı Sözü Tercihleri:" VerticalAlignment="Center" Foreground="{DynamicResource LyrowTextSecondary}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ToggleSwitch x:Name="ChkAutoFetchLyrics" IsChecked="True" />
                                    <TextBlock Text="Otomatik Söz Çekme (LRCLIB)" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource LyrowTextSecondary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ToggleSwitch x:Name="ChkCacheLyrics" IsChecked="True" />
                                    <TextBlock Text="Yerel Diske Önbellekle" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource LyrowTextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="220,*,Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="Söz Senkronizasyon Kaydırması:" VerticalAlignment="Center" Foreground="{DynamicResource LyrowTextSecondary}" />
                            <Slider x:Name="SliderSyncOffset" Grid.Column="1" Minimum="-2000" Maximum="2000" Value="0" TickFrequency="100" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSyncOffsetValue" Grid.Column="2" Text="0 ms" Width="60" FontSize="12" Foreground="{DynamicResource LyrowTextMuted}" VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Height="1" Background="{DynamicResource LyrowBorderBrush}"/>

                        <!-- System Tray & Windows Startup -->
                        <Grid ColumnDefinitions="220,*" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="Sistem &amp; Başlangıç:" VerticalAlignment="Center" Foreground="{DynamicResource LyrowTextSecondary}" />
                            <StackPanel Grid.Column="1" Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ToggleSwitch x:Name="ChkMinimizeToTray" IsChecked="True" IsCheckedChanged="OnTraySettingsChanged"/>
                                    <TextBlock Text="Kapatıldığında ('X') Sistem Tepsisine (Tray) küçült" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource LyrowTextSecondary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ToggleSwitch x:Name="ChkStartWithWindows" IsChecked="False" IsCheckedChanged="OnStartupSettingChanged"/>
                                    <TextBlock Text="Windows oturumu açıldığında Lyrow'u otomatik başlat" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource LyrowTextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Separator Height="1" Background="{DynamicResource LyrowBorderBrush}"/>

                        <!-- Global Hotkeys Interactive Customization Section -->
                        <Grid ColumnDefinitions="220,*" VerticalAlignment="Top">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Global Kısayol Tuşları:" VerticalAlignment="Center" Foreground="{DynamicResource LyrowTextSecondary}" />
                                <TextBlock Text="İsteğe bağlı özel kısayollar" FontSize="11" Foreground="{DynamicResource LyrowTextMuted}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="12">
                                <!-- Glow Hotkey Row -->
                                <Border Background="{DynamicResource LyrowInnerContainerBackground}" CornerRadius="8" Padding="12,8" BorderBrush="{DynamicResource LyrowBorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="160,*,Auto,Auto" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="Glow (Aç/Kapat):" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource LyrowTextPrimary}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="TxtGlowHotkey" PlaceholderText="Örn: Ctrl+Shift+L" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" x:Name="BtnSaveGlowHotkey" Content="Ata" Classes="action-button" Padding="10,4" Margin="0,0,6,0" Click="OnSaveGlowHotkeyClick"/>
                                        <Button Grid.Column="3" x:Name="BtnClearGlowHotkey" Content="✕" ToolTip.Tip="Kısayolu Kaldır" Classes="action-button" Padding="8,4" Click="OnClearGlowHotkeyClick"/>
                                    </Grid>
                                </Border>

                                <!-- Lyrics Hotkey Row -->
                                <Border Background="{DynamicResource LyrowInnerContainerBackground}" CornerRadius="8" Padding="12,8" BorderBrush="{DynamicResource LyrowBorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="160,*,Auto,Auto" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="Lyrics (Aç/Kapat):" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource LyrowTextPrimary}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="TxtLyricsHotkey" PlaceholderText="Örn: Ctrl+Shift+V" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" x:Name="BtnSaveLyricsHotkey" Content="Ata" Classes="action-button" Padding="10,4" Margin="0,0,6,0" Click="OnSaveLyricsHotkeyClick"/>
                                        <Button Grid.Column="3" x:Name="BtnClearLyricsHotkey" Content="✕" ToolTip.Tip="Kısayolu Kaldır" Classes="action-button" Padding="8,4" Click="OnClearLyricsHotkeyClick"/>
                                    </Grid>
                                </Border>

                                <!-- Click-Through Hotkey Row -->
                                <Border Background="{DynamicResource LyrowInnerContainerBackground}" CornerRadius="8" Padding="12,8" BorderBrush="{DynamicResource LyrowBorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="160,*,Auto,Auto" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="Tıklama Geçirgenliği:" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource LyrowTextPrimary}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="TxtClickThroughHotkey" PlaceholderText="Örn: Ctrl+Shift+C" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" x:Name="BtnSaveClickThroughHotkey" Content="Ata" Classes="action-button" Padding="10,4" Margin="0,0,6,0" Click="OnSaveClickThroughHotkeyClick"/>
                                        <Button Grid.Column="3" x:Name="BtnClearClickThroughHotkey" Content="✕" ToolTip.Tip="Kısayolu Kaldır" Classes="action-button" Padding="8,4" Click="OnClearClickThroughHotkeyClick"/>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="TxtHotkeyStatus" Text="Varsayılan olarak hiçbir global kısayol atanmamıştır. Dilediğiniz kombinasyonu tanımlayabilirsiniz." FontSize="11" Foreground="{DynamicResource LyrowTextMuted}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Floating Top-Right Toast Notification Host (Apple / Vercel Minimalist Feedback) -->
        <StackPanel x:Name="ToastContainer" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top" 
                    Margin="0,20,24,0" 
                    Spacing="8" 
                    ZIndex="999" 
                    IsHitTestVisible="True" 
                    MaxWidth="360" />
    </Grid>
</Window>
