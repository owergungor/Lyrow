<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Lyrow.App.VerciWindow"
        Title="Lyrow — Verci Synced Lyrics"
        Width="540" Height="680"
        MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#181825"
        CanResize="True"
        WindowDecorations="None">

    <Border BorderBrush="#313244" BorderThickness="1" CornerRadius="16" Background="#181825">
        <Grid RowDefinitions="Auto,*,Auto" Margin="20">
            
            <!-- 1. Header & Track Metadata -->
            <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,16">
                <!-- Window Drag Handle & Controls -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="5" Background="#F38BA8" />
                        <TextBlock Text="Verci" FontSize="16" FontWeight="SemiBold" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                        <Border x:Name="SourceBadge" Background="#252538" CornerRadius="6" Padding="6,2">
                            <TextBlock x:Name="SourceText" Text="LRCLIB" FontSize="10" Foreground="#A6ADC8" />
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="1" x:Name="StatusBadge" HorizontalAlignment="Center" Background="#1E1E2E" CornerRadius="8" Padding="10,3" BorderBrush="#313244" BorderThickness="1">
                        <TextBlock x:Name="StatusText" Text="Müzik Bekleniyor..." FontSize="11" Foreground="#A6ADC8"/>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="MinimizeButton" Content="—" Width="28" Height="28" CornerRadius="6"
                                Background="#252538" Foreground="#CDD6F4" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button x:Name="CloseButton" Content="✕" Width="28" Height="28" CornerRadius="6"
                                Background="#252538" Foreground="#CDD6F4" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Track Title & Artist -->
                <StackPanel Grid.Row="1" Spacing="3" Margin="0,4,0,10">
                    <TextBlock x:Name="TrackTitleText" Text="Şarkı Çalınmıyor" FontSize="20" FontWeight="Bold" Foreground="#CDD6F4" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TrackArtistText" Text="Spotify veya Medya Oynatıcıyı Başlatın" FontSize="13" Foreground="#89B4FA" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Timeline Progress Bar -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                    <TextBlock x:Name="PositionText" Grid.Column="0" Text="00:00" FontSize="11" Foreground="#6C7086" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="TimelineProgress" Grid.Column="1" Margin="10,0" Minimum="0" Maximum="100" Value="0" Height="4" Foreground="#89B4FA" Background="#313244"/>
                    <TextBlock x:Name="DurationText" Grid.Column="2" Text="00:00" FontSize="11" Foreground="#6C7086" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- 2. Synchronized Lyrics View Container -->
            <Border Grid.Row="1" Background="#11111B" CornerRadius="14" Padding="16,12" BorderBrush="#252538" BorderThickness="1">
                <Grid>
                    <!-- Empty/Waiting State Placeholder -->
                    <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" IsVisible="True">
                        <TextBlock Text="🎵" FontSize="36" HorizontalAlignment="Center" Opacity="0.5"/>
                        <TextBlock Text="Şarkı sözleri bekleniyor..." FontSize="14" Foreground="#6C7086" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Scrollable Lyrics List -->
                    <ScrollViewer x:Name="LyricsScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="LyricsPanel" Spacing="14" VerticalAlignment="Center" Margin="0,60"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 3. Bottom Sync & Offset Controls -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Zaman Kaydırma:" FontSize="11" Foreground="#6C7086" VerticalAlignment="Center"/>
                    <Button x:Name="BtnOffsetMinus" Content="-0.5s" FontSize="11" Padding="6,2" CornerRadius="6" Background="#252538" Foreground="#CDD6F4"/>
                    <TextBlock x:Name="OffsetLabelText" Text="0 ms" FontSize="11" Foreground="#A6ADC8" VerticalAlignment="Center" Width="45" TextAlignment="Center"/>
                    <Button x:Name="BtnOffsetPlus" Content="+0.5s" FontSize="11" Padding="6,2" CornerRadius="6" Background="#252538" Foreground="#CDD6F4"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkAutoScroll" Content="Otomatik Kaydır" IsChecked="True" FontSize="11" Foreground="#A6ADC8" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
