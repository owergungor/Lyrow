<?xml version="1.0" encoding="utf-8"?>

<Window

    x:Class="Lyrow.App.MainWindow"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    Title="Lyrow"

    mc:Ignorable="d">



    <Window.SystemBackdrop>

        <MicaBackdrop Kind="Base" />

    </Window.SystemBackdrop>



    <Grid x:Name="RootShellGrid" RowDefinitions="Auto,*" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- Dynamic Artwork Ambient Background Layer (Apple Music 26 Reference) -->
        <Grid x:Name="HomeAmbientBackgroundLayer" Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0.55">
            <Grid.Background>
                <LinearGradientBrush x:Name="HomeAmbientBrush" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="HomeStopTopLeft" Color="#121218" Offset="0.0" />
                    <GradientStop x:Name="HomeStopCenter" Color="#0C0E14" Offset="0.5" />
                    <GradientStop x:Name="HomeStopBottomRight" Color="#08080C" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Rectangle Fill="#35000000" />
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                        <GradientStop Color="#00000000" Offset="0.0" />
                        <GradientStop Color="#25000000" Offset="0.6" />
                        <GradientStop Color="#60000000" Offset="1.0" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Windows 11 Native Custom TitleBar -->

        <TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Lyrow">

            <TitleBar.IconSource>

                <ImageIconSource ImageSource="Assets/lyrow.ico" />

            </TitleBar.IconSource>

        </TitleBar>



        <!-- Mac-Style Floating Toast Notification Container (Top-Right, Zero Layout Shift) -->

        <StackPanel x:Name="ToastContainer" Grid.Row="1"

                    HorizontalAlignment="Right" VerticalAlignment="Top"

                    Margin="0,16,24,0" Spacing="8"

                    IsHitTestVisible="True"

                    Canvas.ZIndex="1000" />



        <!-- Compact Modern Navigation View (OpenPaneLength=188 for generous content area) -->

        <NavigationView x:Name="NavView" Grid.Row="1"

                        PaneDisplayMode="Left"

                        OpenPaneLength="188"

                        CompactPaneLength="48"

                        IsPaneToggleButtonVisible="True"

                        IsBackButtonVisible="Collapsed"

                        IsSettingsVisible="True">

            <NavigationView.MenuItems>

                <NavigationViewItem x:Name="NavHome" Content="Home" Tag="Home">

                    <NavigationViewItem.Icon>

                        <FontIcon Glyph="&#xE80F;" />

                    </NavigationViewItem.Icon>

                </NavigationViewItem>



                <NavigationViewItem x:Name="NavPlayback" Content="Playback" Tag="Playback">

                    <NavigationViewItem.Icon>

                        <FontIcon Glyph="&#xE768;" />

                    </NavigationViewItem.Icon>

                </NavigationViewItem>



                <NavigationViewItem x:Name="NavGlow" Content="Glow" Tag="Glow">

                    <NavigationViewItem.Icon>

                        <FontIcon Glyph="&#xE706;" />

                    </NavigationViewItem.Icon>

                </NavigationViewItem>



                <NavigationViewItem x:Name="NavLyrics" Content="Lyrics" Tag="Lyrics">

                    <NavigationViewItem.Icon>

                        <FontIcon Glyph="&#xEC4F;" />

                    </NavigationViewItem.Icon>

                </NavigationViewItem>

            </NavigationView.MenuItems>



            <ScrollViewer x:Name="MainScrollViewer"

                          VerticalScrollMode="Enabled"

                          VerticalScrollBarVisibility="Auto"

                          HorizontalScrollMode="Disabled"

                          HorizontalScrollBarVisibility="Disabled"

                          IsTabStop="True"

                          Background="Transparent">

                <Grid x:Name="RootContentGrid" Margin="24,14,24,28" MaxWidth="920" HorizontalAlignment="Stretch" Background="Transparent">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>



                    <!-- Global Top InfoBar Toast (Deprecated / Fallback) -->

                    <InfoBar x:Name="TopToastBar" Grid.Row="0" IsOpen="False" Severity="Informational" IsClosable="True" Visibility="Collapsed" Margin="0,0,0,12" />



                    <!-- PAGE: HOME / DASHBOARD -->

                    <StackPanel x:Name="PageHome" Grid.Row="1" Spacing="16" Visibility="Visible" Background="Transparent">

                        <!-- 1. Current Track & Playback Card -->

                        <Border x:Name="CardCurrentTrack" Padding="20" CornerRadius="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid x:Name="GridCardCurrentTrack" ColumnDefinitions="96,*,Auto" RowDefinitions="Auto,Auto">
                                <!-- Album Artwork -->
                                <Border x:Name="BorderHomeTrackArtwork" Grid.RowSpan="2" Grid.Column="0" Width="84" Height="84" CornerRadius="12"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Grid>
                                        <Image x:Name="HomeTrackArtwork" Stretch="UniformToFill" />
                                        <FontIcon x:Name="HomeArtworkPlaceholder" Glyph="&#xE8D6;" FontSize="32"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Track Metadata (Title, Artist, Album) -->
                                <StackPanel x:Name="StackHomeTrackMeta" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,16,0" Spacing="3">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="TransHomeTrackMeta" Y="0" />
                                    </StackPanel.RenderTransform>
                                    <TextBlock x:Name="HomeTxtTitle" Text="Waiting for playback..."
                                               FontWeight="SemiBold" FontSize="19" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="HomeTxtArtist" Text="Play music in Spotify, Apple Music, or your browser"
                                               FontSize="13.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="HomeTxtAlbum" Text="" Visibility="Collapsed"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Playback Controls (Previous, Play/Pause, Next) -->
                                <StackPanel x:Name="StackHomeControls" Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="BtnPrevTrack" AutomationProperties.Name="Previous Track" Width="38" Height="38" Padding="0" CornerRadius="19" ToolTipService.ToolTip="Previous Track">
                                        <FontIcon Glyph="&#xE892;" FontSize="15" />
                                    </Button>
                                    <Button x:Name="BtnPlayPause" AutomationProperties.Name="Play or Pause" Width="46" Height="46" Padding="0" CornerRadius="23" Style="{ThemeResource AccentButtonStyle}" ToolTipService.ToolTip="Play / Pause">
                                        <FontIcon x:Name="IconPlayPause" Glyph="&#xE768;" FontSize="18" />
                                    </Button>
                                    <Button x:Name="BtnNextTrack" AutomationProperties.Name="Next Track" Width="38" Height="38" Padding="0" CornerRadius="19" ToolTipService.ToolTip="Next Track">
                                        <FontIcon Glyph="&#xE893;" FontSize="15" />
                                    </Button>
                                </StackPanel>

                                <!-- Timeline Progress with Interactive Hit Box -->
                                <Grid x:Name="GridHomeProgressRow" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="16,12,0,0" ColumnDefinitions="*,Auto">
                                    <Grid x:Name="GridHomeProgressHitBox" Grid.Column="0" Height="20" Background="Transparent" VerticalAlignment="Center" Margin="0,0,14,0"
                                          ToolTipService.ToolTip="Playback Progress">
                                        <ProgressBar x:Name="HomeProgressTimeline" Minimum="0" Maximum="100" Value="0"
                                                     VerticalAlignment="Center" Height="4" CornerRadius="2" IsHitTestVisible="False" />
                                    </Grid>
                                    <TextBlock x:Name="HomeTxtTimestamp" Grid.Column="1" Text="00:00 / 00:00"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 2. Dual Volume Controls (Playback Session & System Master 0% - 100%) -->

                        <Border x:Name="CardVolume" Padding="18,16" CornerRadius="12"

                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">

                            <Grid ColumnDefinitions="*,16,*" VerticalAlignment="Center">

                                <!-- Column 0: Playback / Media App Session Volume -->

                                <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">

                                    <Button x:Name="BtnMutePlayback" AutomationProperties.Name="Mute Playback Volume" Width="36" Height="36" Padding="0" CornerRadius="8"

                                            ToolTipService.ToolTip="Mute / Unmute Playback">

                                        <FontIcon x:Name="IconPlaybackMute" Glyph="&#xE767;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                    </Button>



                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">

                                            <TextBlock Text="Playback Volume" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />

                                            <TextBlock x:Name="TxtPlaybackTarget" Grid.Column="1" Text="Media App" FontSize="11"

                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                            <TextBlock x:Name="TxtPlaybackVolumePercent" Grid.Column="2" Text="78%" FontWeight="SemiBold"

                                                       FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />

                                        </Grid>

                                        <Slider x:Name="SliderPlaybackVolume" AutomationProperties.Name="Playback Volume Slider" Minimum="0" Maximum="100" Value="78" StepFrequency="1"

                                                Margin="0,2,0,0" IsThumbToolTipEnabled="False" />

                                    </StackPanel>

                                </Grid>



                                <!-- Column 1: System Endpoint Master Volume -->

                                <Grid Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">

                                    <Button x:Name="BtnMuteSystem" AutomationProperties.Name="Mute System Volume" Width="36" Height="36" Padding="0" CornerRadius="8"

                                            ToolTipService.ToolTip="Mute / Unmute System Master Volume">

                                        <FontIcon x:Name="IconSystemMute" Glyph="&#xE767;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                    </Button>



                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">

                                            <TextBlock Text="System Master" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />

                                            <TextBlock x:Name="TxtSystemTarget" Grid.Column="1" Text="Speakers" FontSize="11"

                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                            <TextBlock x:Name="TxtSystemVolumePercent" Grid.Column="2" Text="78%" FontWeight="SemiBold"

                                                       FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />

                                        </Grid>

                                        <Slider x:Name="SliderSystemVolume" AutomationProperties.Name="System Master Volume Slider" Minimum="0" Maximum="100" Value="78" StepFrequency="1"

                                                Margin="0,2,0,0" IsThumbToolTipEnabled="False" />

                                    </StackPanel>

                                </Grid>

                            </Grid>

                        </Border>



                        <!-- 3. Glow & Lyrics Module Cards -->

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

                            <!-- Ambient Glow Card -->

                            <Border x:Name="CardGlow" Grid.Column="0" Padding="18" CornerRadius="12"

                                     Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                     BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">

                                <StackPanel Spacing="12">

                                    <Grid ColumnDefinitions="Auto,*,Auto">

                                        <FontIcon Glyph="&#xE706;" FontSize="22" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">

                                            <TextBlock Text="Ambient Glow" FontWeight="SemiBold" FontSize="16" />

                                            <TextBlock x:Name="TxtGlowStatus" Text="Stopped" FontSize="12"

                                                       Foreground="{StaticResource LyrowStoppedBrush}" />

                                        </StackPanel>

                                        <ToggleSwitch x:Name="SwitchHomeGlow" AutomationProperties.Name="Toggle Ambient Glow" Grid.Column="2" IsOn="False" OffContent="" OnContent="" MinWidth="0" Margin="0" />

                                    </Grid>



                                    <TextBlock x:Name="TxtGlowVisualState"

                                               Text="Standby — 4-edge ambient lighting ready"

                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />



                                    <!-- Live 4-Edge Palette Swatches -->

                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6" VerticalAlignment="Center"

                                          Padding="10,7" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">

                                        <TextBlock Text="4-Edge Palette" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                        <Border x:Name="SwatchTop" Grid.Column="2" Width="14" Height="14" CornerRadius="7" Background="#5EB2FF" ToolTipService.ToolTip="Top Edge" />

                                        <Border x:Name="SwatchBottom" Grid.Column="3" Width="14" Height="14" CornerRadius="7" Background="#FF5388" ToolTipService.ToolTip="Bottom Edge" />

                                        <Border x:Name="SwatchLeft" Grid.Column="4" Width="14" Height="14" CornerRadius="7" Background="#38EF7D" ToolTipService.ToolTip="Left Edge" />

                                        <Border x:Name="SwatchRight" Grid.Column="5" Width="14" Height="14" CornerRadius="7" Background="#8A2BE2" ToolTipService.ToolTip="Right Edge" />

                                    </Grid>

                                </StackPanel>

                            </Border>



                            <!-- Synchronized Lyrics Card -->

                            <Border x:Name="CardLyrics" Grid.Column="1" Padding="18" CornerRadius="12"

                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">

                                <StackPanel Spacing="12">

                                    <Grid ColumnDefinitions="Auto,*,Auto">

                                        <FontIcon Glyph="&#xEC4F;" FontSize="22" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">

                                            <TextBlock Text="Synchronized Lyrics" FontWeight="SemiBold" FontSize="16" />

                                            <TextBlock x:Name="TxtLyricsStatus" Text="Stopped" FontSize="12"

                                                       Foreground="{StaticResource LyrowStoppedBrush}" />

                                        </StackPanel>

                                        <ToggleSwitch x:Name="SwitchHomeLyrics" AutomationProperties.Name="Toggle Synchronized Lyrics" Grid.Column="2" IsOn="False" OffContent="" OnContent="" MinWidth="0" Margin="0" />

                                    </Grid>



                                    <TextBlock x:Name="TxtLyricsAvailability"

                                               Text="Waiting for active track..."

                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />



                                    <Border Padding="10,7" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">

                                        <TextBlock x:Name="TxtHomeCurrentLyricLine"

                                                   Text="♪ Play a song to see live synchronized lyrics"

                                                   FontSize="12" FontWeight="Medium"

                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"

                                                   TextTrimming="CharacterEllipsis" />

                                    </Border>

                                </StackPanel>

                            </Border>

                        </Grid>

                    </StackPanel>



                    <!-- PAGE: GLOW -->

                    <StackPanel x:Name="PageGlow" Grid.Row="1" Spacing="16" Visibility="Collapsed" Background="Transparent">

                        <TextBlock Text="Ambient Edge Lighting" FontSize="22" FontWeight="SemiBold" />



                        <InfoBar IsOpen="True" Severity="Informational" IsClosable="False"

                                 Message="Modern 4-edge ambient lighting renders on a click-through layered surface (WS_EX_TRANSPARENT). Clicks, keyboard shortcuts, and scrolling pass effortlessly to underlying apps." />



                        <!-- Master Toggle -->

                        <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">

                            <Grid ColumnDefinitions="*,Auto">

                                <StackPanel Spacing="2">

                                    <TextBlock Text="Enable Ambient Glow" FontWeight="SemiBold" FontSize="15" />

                                    <TextBlock Text="Continuous 4-edge bloom reacting to bass, mid, treble, and beat transients"

                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                </StackPanel>

                                <ToggleSwitch x:Name="SwitchGlowMaster" AutomationProperties.Name="Master Ambient Glow Toggle" Grid.Column="1" IsOn="False" OffContent="" OnContent="" MinWidth="0" Margin="0" />

                            </Grid>

                        </Border>



                        <!-- Intensity, Thickness & Response Sensitivity -->

                        <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">

                            <StackPanel Spacing="14">

                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock Text="Glow Brightness Intensity" FontWeight="Medium" FontSize="14" />

                                    <TextBlock x:Name="TxtGlowIntensityVal" Grid.Column="1" Text="80%" FontWeight="SemiBold"

                                               FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                </Grid>

                                <Slider x:Name="SliderGlowIntensity" AutomationProperties.Name="Ambient Glow Brightness Multiplier" Minimum="10" Maximum="100" Value="80" StepFrequency="1" />



                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock Text="Edge Bloom Thickness" FontWeight="Medium" FontSize="14" />

                                    <TextBlock x:Name="TxtGlowThicknessVal" Grid.Column="1" Text="24 px" FontWeight="SemiBold"

                                               FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                </Grid>

                                <Slider x:Name="SliderGlowThickness" AutomationProperties.Name="Ambient Glow Edge Thickness" Minimum="0" Maximum="256" Value="24" StepFrequency="2" />



                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock Text="Beat &amp; Transient Reactivity" FontWeight="Medium" FontSize="14" />

                                    <TextBlock x:Name="TxtGlowSensitivityVal" Grid.Column="1" Text="250%" FontWeight="SemiBold"

                                               FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                </Grid>

                                <Slider x:Name="SliderGlowSensitivity" AutomationProperties.Name="Ambient Glow Audio Sensitivity" Minimum="0" Maximum="500" Value="250" StepFrequency="5" />

                            </StackPanel>

                        </Border>



                        <!-- Color Palette & Album Art Sync -->

                        <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">

                            <StackPanel Spacing="14">

                                <Grid ColumnDefinitions="*,Auto">

                                    <StackPanel Spacing="2">

                                        <TextBlock Text="Sync with Album Artwork" FontWeight="SemiBold" FontSize="14" />

                                        <TextBlock Text="Extracts dominant and vibrant accent colors from track cover with smooth crossfade"

                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    </StackPanel>

                                    <ToggleSwitch x:Name="SwitchAlbumArtSync" AutomationProperties.Name="Sync Ambient Glow With Album Artwork" Grid.Column="1" IsOn="True" OffContent="" OnContent="" MinWidth="0" Margin="0" />

                                </Grid>



                                <StackPanel Spacing="6">

                                    <TextBlock Text="Fallback Palette Preset" FontWeight="Medium" FontSize="13" />

                                    <ComboBox x:Name="ComboPalettePreset" AutomationProperties.Name="Ambient Glow Fallback Palette Preset" HorizontalAlignment="Stretch" />

                                </StackPanel>

                                <Grid ColumnDefinitions="*,200" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TxtGlowAcousticProfileHeader" Text="Acoustic Frequency Profile" FontWeight="Medium" FontSize="14" />
                                        <TextBlock x:Name="TxtGlowAcousticProfileDesc" Text="Tailors ambient edge reactivity to musical sub-bands"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ComboSettingsGlowAcousticProfile" AutomationProperties.Name="Ambient Glow Acoustic Profile" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch">
                                        <ComboBoxItem x:Name="ComboItemProfileBalanced" Content="Balanced" Tag="Balanced" />
                                        <ComboBoxItem x:Name="ComboItemProfileBassBoost" Content="Bass Boost" Tag="BassBoost" />
                                        <ComboBoxItem x:Name="ComboItemProfileVocalFocus" Content="Vocal Focus" Tag="VocalFocus" />
                                        <ComboBoxItem x:Name="ComboItemProfileHighFidelity" Content="High Fidelity" Tag="HighFidelity" />
                                    </ComboBox>
                                </Grid>

                            </StackPanel>

                        </Border>



                        <!-- Inactivity / Music Stop Graceful Shutdown Delay -->

                        <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">

                            <Grid ColumnDefinitions="*,200" VerticalAlignment="Center">

                                <StackPanel Spacing="2">

                                    <TextBlock Text="Inactivity Shutdown Delay" FontWeight="SemiBold" FontSize="14" />

                                    <TextBlock Text="Wait time after music stops before gracefully fading out ambient glow"

                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                </StackPanel>

                                <ComboBox x:Name="ComboGlowShutdownDelay" AutomationProperties.Name="Ambient Glow Inactivity Shutdown Delay" Grid.Column="1" HorizontalAlignment="Stretch">

                                    <ComboBoxItem Content="Immediately (0s)" Tag="0" />

                                    <ComboBoxItem Content="1 second" Tag="1" />

                                    <ComboBoxItem Content="3 seconds (Default)" Tag="3" />

                                    <ComboBoxItem Content="5 seconds" Tag="5" />

                                    <ComboBoxItem Content="10 seconds" Tag="10" />

                                    <ComboBoxItem Content="30 seconds" Tag="30" />

                                    <ComboBoxItem Content="1 minute" Tag="60" />

                                </ComboBox>

                            </Grid>

                        </Border>



                        <!-- Multi-Monitor Target -->

                        <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">

                            <StackPanel Spacing="8">

                                <TextBlock Text="Target Displays" FontWeight="SemiBold" FontSize="14" />

                                <TextBlock Text="Select which monitors receive 4-edge ambient lighting"

                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <CheckBox x:Name="ChkMultiMonitor" Content="Enable on All Connected Displays" IsChecked="True" />

                            </StackPanel>

                        </Border>

                    </StackPanel>



                    <!-- PAGE: LYRICS -->

                    <StackPanel x:Name="PageLyrics" Grid.Row="1" Spacing="16" Visibility="Collapsed" Background="Transparent">

                        <TextBlock Text="Synchronized Lyrics" FontSize="22" FontWeight="SemiBold" />



                        <!-- Master Toggle -->

                        <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">

                            <Grid ColumnDefinitions="*,Auto">

                                <StackPanel Spacing="2">

                                    <TextBlock Text="Lyrics Overlay Window" FontWeight="SemiBold" FontSize="15" />

                                    <TextBlock Text="Open Apple Music-style lyrics window with vertically centered active line"

                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                </StackPanel>

                                <ToggleSwitch x:Name="SwitchLyricsMaster" AutomationProperties.Name="Master Synchronized Lyrics Toggle" Grid.Column="1" IsOn="False" OffContent="" OnContent="" MinWidth="0" Margin="0" />

                            </Grid>

                        </Border>



                        <!-- Sync Offset Adjustment -->

                        <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">

                            <StackPanel Spacing="12">

                                <Grid ColumnDefinitions="*,Auto">

                                    <StackPanel Spacing="2">

                                        <TextBlock Text="Lyrics Timestamp Offset" FontWeight="SemiBold" FontSize="14" />

                                        <TextBlock Text="Fine-tune lyrics synchronization against audio playback"

                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    </StackPanel>

                                    <TextBlock x:Name="TxtPageLyricsOffset" Grid.Column="1" Text="0 ms"

                                               FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                </Grid>



                                <Slider x:Name="SliderLyricsOffset" AutomationProperties.Name="Lyrics Synchronization Offset" Minimum="-3000" Maximum="3000" Value="0" StepFrequency="50" />



                                <StackPanel Orientation="Horizontal" Spacing="8">

                                    <Button x:Name="BtnOffsetMinus500" AutomationProperties.Name="Decrease Lyrics Offset by 500 ms" Content="−500 ms" />

                                    <Button x:Name="BtnOffsetReset" AutomationProperties.Name="Reset Lyrics Offset to 0 ms" Content="Reset (0 ms)" />

                                    <Button x:Name="BtnOffsetPlus500" AutomationProperties.Name="Increase Lyrics Offset by 500 ms" Content="+500 ms" />

                                </StackPanel>

                            </StackPanel>

                        </Border>



                        <!-- Typography & Auto Scroll -->

                        <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">

                            <StackPanel Spacing="14">

                                <Grid ColumnDefinitions="*,Auto">

                                    <StackPanel Spacing="2">

                                        <TextBlock Text="Apple Music Fluid Motion" FontWeight="SemiBold" FontSize="14" />

                                        <TextBlock Text="Active lyric line is dynamically scaled and vertically centered at 60 FPS"

                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    </StackPanel>

                                    <FontIcon Grid.Column="1" Glyph="&#xE73E;" FontSize="15" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Margin="8,0" />

                                </Grid>



                                <StackPanel Spacing="10">

                                    <Grid ColumnDefinitions="*,Auto">

                                        <StackPanel Spacing="2">

                                            <TextBlock Text="Focused Line Font Size" FontWeight="Medium" FontSize="14" />

                                            <TextBlock Text="Font size of the active playing lyric line (default 28 px)"

                                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        </StackPanel>

                                        <TextBlock x:Name="TxtFocusedFontSize" Grid.Column="1" Text="28 px" FontWeight="SemiBold"

                                                   FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />

                                    </Grid>

                                    <Slider x:Name="SliderFocusedFontSize" AutomationProperties.Name="Focused Lyric Font Size" Minimum="20" Maximum="48" Value="28" StepFrequency="1" />



                                    <Grid ColumnDefinitions="*,Auto">

                                        <StackPanel Spacing="2">

                                            <TextBlock Text="Unfocused Lines Font Size" FontWeight="Medium" FontSize="14" />

                                            <TextBlock Text="Font size of surrounding inactive lyric lines (default 20 px)"

                                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        </StackPanel>

                                        <TextBlock x:Name="TxtUnfocusedFontSize" Grid.Column="1" Text="20 px" FontWeight="SemiBold"

                                                   FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />

                                    </Grid>

                                    <Slider x:Name="SliderUnfocusedFontSize" AutomationProperties.Name="Unfocused Lyric Font Size" Minimum="14" Maximum="36" Value="20" StepFrequency="1" />

                                </StackPanel>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TxtLyricsLineSpacingHeader" Text="Lyrics Line Spacing" FontWeight="Medium" FontSize="14" />
                                        <TextBlock x:Name="TxtLyricsLineSpacingDesc" Text="Vertical distance between adjacent lyric lines"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtSettingsLyricsLineSpacing" Grid.Column="1" Text="20 px" FontWeight="SemiBold"
                                               FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="SliderSettingsLyricsLineSpacing" AutomationProperties.Name="Lyrics Line Spacing" Minimum="8" Maximum="36" Value="20" StepFrequency="2" />

                                <Grid ColumnDefinitions="*,200" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TxtLyricsAlignmentHeader" Text="Lyrics Alignment" FontWeight="Medium" FontSize="14" />
                                        <TextBlock x:Name="TxtLyricsAlignmentDesc" Text="Horizontal alignment of lyric lines in the viewport"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ComboSettingsLyricsAlignment" AutomationProperties.Name="Lyrics Text Alignment" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch">
                                        <ComboBoxItem x:Name="ComboItemAlignLeft" Content="Left" Tag="Left" />
                                        <ComboBoxItem x:Name="ComboItemAlignCenter" Content="Center" Tag="Center" />
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TxtLyricsBackdropOpacityHeader" Text="Lyrics Window Backdrop Opacity" FontWeight="Medium" FontSize="14" />
                                        <TextBlock x:Name="TxtLyricsBackdropOpacityDesc" Text="Canvas translucency of the dedicated lyrics window"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtSettingsLyricsBackdropOpacity" Grid.Column="1" Text="85%" FontWeight="SemiBold"
                                               FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="SliderSettingsLyricsBackdropOpacity" AutomationProperties.Name="Lyrics Window Backdrop Opacity" Minimum="40" Maximum="100" Value="85" StepFrequency="5" />

                            </StackPanel>

                        </Border>

                    </StackPanel>



                    <!-- PAGE: PLAYBACK -->

                    <StackPanel x:Name="PagePlayback" Grid.Row="1" Spacing="16" Visibility="Collapsed" Background="Transparent">

                        <TextBlock x:Name="TxtPlaybackPageHeader" Text="Playback &amp; Volume" FontSize="22" FontWeight="SemiBold" />



                        <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">

                            <StackPanel Spacing="14">

                                <TextBlock Text="Media Sessions &amp; Master Audio" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />



                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock x:Name="TxtPagePlaybackActiveLabel" Text="Active Session Playback Volume" FontWeight="Medium" FontSize="14" />

                                    <TextBlock x:Name="TxtPagePlaybackVolumePercent" Grid.Column="1" Text="78%" FontWeight="SemiBold"

                                               FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                </Grid>

                                <Slider x:Name="SliderPagePlaybackVolume" AutomationProperties.Name="Active Media Session Playback Volume" Minimum="0" Maximum="100" Value="78" StepFrequency="1" IsThumbToolTipEnabled="False" />



                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock x:Name="TxtPagePlaybackSystemLabel" Text="System Endpoint Master Volume" FontWeight="Medium" FontSize="14" />

                                    <TextBlock x:Name="TxtPageSystemVolumePercent" Grid.Column="1" Text="78%" FontWeight="SemiBold"

                                               FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                </Grid>

                                <Slider x:Name="SliderPageSystemVolume" AutomationProperties.Name="System Endpoint Master Volume" Minimum="0" Maximum="100" Value="78" StepFrequency="1" IsThumbToolTipEnabled="False" />



                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">

                                    <TextBlock x:Name="TxtPageMediaStatus" Text="Media Transport Controls"

                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">

                                        <Button x:Name="BtnPagePrev" ToolTipService.ToolTip="Previous Track" AutomationProperties.Name="Previous Track" Width="40" Height="40" Padding="0">

                                            <FontIcon Glyph="&#xE892;" FontSize="16" />

                                        </Button>

                                        <Button x:Name="BtnPagePlayPause" Style="{ThemeResource AccentButtonStyle}" ToolTipService.ToolTip="Play / Pause" AutomationProperties.Name="Play / Pause" Width="44" Height="44" Padding="0">

                                            <FontIcon x:Name="IconPagePlayPause" Glyph="&#xE768;" FontSize="18" />

                                        </Button>

                                        <Button x:Name="BtnPageNext" ToolTipService.ToolTip="Next Track" AutomationProperties.Name="Next Track" Width="40" Height="40" Padding="0">

                                            <FontIcon Glyph="&#xE893;" FontSize="16" />

                                        </Button>

                                    </StackPanel>

                                </Grid>

                            </StackPanel>

                        </Border>

                        <!-- Playback & Transport Preferences -->
                        <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Playback &amp; Transport" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                <Grid ColumnDefinitions="*,200" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Seek Step Sensitivity" FontWeight="Medium" FontSize="14" />
                                        <TextBlock Text="Seconds to jump when seeking forward or backward"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ComboSeekStep" AutomationProperties.Name="Seek Step Sensitivity" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="5 seconds" Tag="5" />
                                        <ComboBoxItem Content="10 seconds" Tag="10" />
                                        <ComboBoxItem Content="15 seconds" Tag="15" />
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Auto-Pause on System Mute" FontWeight="Medium" FontSize="14" />
                                        <TextBlock Text="Pause media playback when system volume is muted"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SwitchAutoPauseOnMute" AutomationProperties.Name="Auto Pause Playback on System Mute" Grid.Column="1" IsOn="False" OffContent="" OnContent="" MinWidth="0" Margin="0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>



                    <!-- PAGE: SETTINGS -->

                    <StackPanel x:Name="PageSettings" Grid.Row="1" Spacing="16" Visibility="Collapsed" Background="Transparent">

                        <TextBlock x:Name="TxtSettingsHeader" Text="Settings" FontSize="22" FontWeight="SemiBold" />

                        <!-- Settings Category Selector Bar -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                <Button x:Name="BtnFilterAllSettings" AutomationProperties.Name="Filter All Settings" Content="All" CornerRadius="8" Style="{ThemeResource AccentButtonStyle}" />
                                <Button x:Name="BtnFilterAppearance" AutomationProperties.Name="Filter Appearance Settings" Content="Appearance" CornerRadius="8" />
                                <Button x:Name="BtnFilterSystem" AutomationProperties.Name="Filter System Settings" Content="System" CornerRadius="8" />
                                <Button x:Name="BtnFilterArtwork" AutomationProperties.Name="Filter Artwork Settings" Content="Artwork" CornerRadius="8" />
                                <Button x:Name="BtnFilterAudio" AutomationProperties.Name="Filter Audio Settings" Content="Audio" CornerRadius="8" />
                                <Button x:Name="BtnFilterUpdates" AutomationProperties.Name="Filter Updates Settings" Content="Updates" CornerRadius="8" />
                                <Button x:Name="BtnFilterShortcuts" AutomationProperties.Name="Filter Shortcuts Settings" Content="Shortcuts" CornerRadius="8" />
                                <Button x:Name="BtnFilterAbout" AutomationProperties.Name="Filter About Settings" Content="About" CornerRadius="8" />

                                <!-- Backwards compatibility aliases (collapsed) -->
                                <Button x:Name="BtnFilterPlayback" AutomationProperties.Name="Filter Playback Settings" Content="Playback" Visibility="Collapsed" />
                                <Button x:Name="BtnFilterLyrics" AutomationProperties.Name="Filter Lyrics Settings" Content="Lyrics" Visibility="Collapsed" />
                                <Button x:Name="BtnFilterGlow" AutomationProperties.Name="Filter Ambient Glow Settings" Content="Ambient Glow" Visibility="Collapsed" />
                                <Button x:Name="BtnFilterGeneral" AutomationProperties.Name="Filter General Settings" Content="General" Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 1. Appearance (Theme, Language, Window Opacity, Fluid Motion) -->
                        <Border x:Name="SectionGeneral" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="TxtSectionGeneral" Text="Appearance &amp; Window" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                <Grid ColumnDefinitions="*,200" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TxtAppTheme" Text="App Theme" FontWeight="Medium" FontSize="14" />
                                        <TextBlock x:Name="TxtAppThemeDesc" Text="Choose Windows 11 system theme, dark, or light appearance"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ComboTheme" AutomationProperties.Name="App Theme Selector" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Windows Default" Tag="SystemDefault" />
                                        <ComboBoxItem Content="Dark" Tag="Dark" />
                                        <ComboBoxItem Content="Light" Tag="Light" />
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnDefinitions="*,200" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TxtLanguageLabel" Text="Language" FontWeight="Medium" FontSize="14" />
                                        <TextBlock x:Name="TxtLanguageDesc" Text="Application user interface language"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ComboLanguage" AutomationProperties.Name="Application Language Selector" Grid.Column="1" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="English" Tag="en" />
                                        <ComboBoxItem Content="Français" Tag="fr" />
                                        <ComboBoxItem Content="Español" Tag="es" />
                                        <ComboBoxItem Content="Deutsch" Tag="de" />
                                        <ComboBoxItem Content="Türkçe" Tag="tr" />
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Window Master Opacity" FontWeight="Medium" FontSize="14" />
                                        <TextBlock Text="Adjust transparency and backdrop blend level"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtMasterOpacityPercent" Grid.Column="1" Text="95%" FontWeight="SemiBold"
                                               FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="SliderMasterOpacity" AutomationProperties.Name="Window Master Opacity" Minimum="50" Maximum="100" Value="95" StepFrequency="1" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Fluid Motion &amp; Animations" FontWeight="Medium" FontSize="14" />
                                        <TextBlock Text="Enable smooth visual transitions, artwork crossfades, and interactive physics"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SwitchEnableAnimations" AutomationProperties.Name="Fluid Motion and Animations" Grid.Column="1" IsOn="True" OffContent="" OnContent="" MinWidth="0" Margin="0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2. System & Integration (Startup, Tray, Notifications) -->
                        <Border x:Name="SectionSystem" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="TxtSectionSystem" Text="System &amp; Integration" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TxtStartupLabel" Text="Launch on Windows Startup" FontWeight="Medium" FontSize="14" />
                                        <TextBlock x:Name="TxtStartupDesc" Text="Start Lyrow automatically when signing into Windows"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SwitchStartWithWindows" AutomationProperties.Name="Launch Lyrow on Windows Startup" Grid.Column="1" IsOn="False" OffContent="" OnContent="" MinWidth="0" Margin="0" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TxtSystemTrayLabel" Text="System Tray Integration" FontWeight="Medium" FontSize="14" />
                                        <TextBlock x:Name="TxtSystemTrayDesc" Text="Keep Lyrow accessible in the Windows notification area"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SwitchSystemTray" AutomationProperties.Name="System Tray Integration" Grid.Column="1" IsOn="True" OffContent="" OnContent="" MinWidth="0" Margin="0" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Desktop Notifications" FontWeight="Medium" FontSize="14" />
                                        <TextBlock Text="Show Windows notifications for updates and system events"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SwitchNotifications" AutomationProperties.Name="Desktop Notifications" Grid.Column="1" IsOn="True" OffContent="" OnContent="" MinWidth="0" Margin="0" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Notify on Track Change" FontWeight="Medium" FontSize="14" />
                                        <TextBlock Text="Display a brief notification when the playing track changes"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SwitchNotifyOnTrackChange" AutomationProperties.Name="Notify on Track Change" Grid.Column="1" IsOn="True" OffContent="" OnContent="" MinWidth="0" Margin="0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SectionSettingsArtwork" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Artwork &amp; Dynamic Background" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Dynamic Ambient Background Layer" FontWeight="Medium" FontSize="14" />
                                        <TextBlock Text="Subtle, fluidly tinted blurred artwork atmosphere across the window"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SwitchArtworkDynamicBackground" AutomationProperties.Name="Dynamic Ambient Background Layer" Grid.Column="1" IsOn="True" OffContent="" OnContent="" MinWidth="0" Margin="0" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Ambient Background Saturation" FontWeight="Medium" FontSize="14" />
                                        <TextBlock Text="Intensity of the background artwork color aura"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtArtworkSaturationPercent" Grid.Column="1" Text="100%" FontWeight="SemiBold"
                                               FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="SliderArtworkBackgroundSaturation" AutomationProperties.Name="Ambient Artwork Background Saturation" Minimum="10" Maximum="150" Value="100" StepFrequency="5" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Artwork Corner Radius" FontWeight="Medium" FontSize="14" />
                                        <TextBlock Text="Apple Music inspired rounded corners on album artwork"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtArtworkRadiusValue" Grid.Column="1" Text="12 px" FontWeight="SemiBold"
                                               FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="SliderArtworkCornerRadius" AutomationProperties.Name="Album Artwork Corner Radius" Minimum="4" Maximum="24" Value="12" StepFrequency="1" />

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="In-Memory Cache Capacity" FontWeight="Medium" FontSize="14" />
                                        <TextBlock x:Name="TxtArtworkCacheStatus" Text="Bounded cache: 50 items max (Zero memory leakage)"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="1" Glyph="&#xE753;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Margin="8,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 6. Audio Engine & Frequency Analysis -->
                        <Border x:Name="SectionSettingsAudio" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Audio Engine &amp; Frequency Analysis" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Capture Endpoint" FontWeight="Medium" FontSize="14" />
                                        <TextBlock x:Name="TxtAudioEndpointStatus" Text="Windows Default Audio Loopback (Real-Time WASAPI)"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="1" Glyph="&#xE720;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Margin="8,0" />
                                </Grid>

                                <Grid ColumnDefinitions="*,200" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="FFT Analysis Window Size" FontWeight="Medium" FontSize="14" />
                                        <TextBlock Text="Sample window for Fast Fourier Transform frequency bins"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ComboFftSize" AutomationProperties.Name="FFT Analysis Window Size" Grid.Column="1" SelectedIndex="1" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="1024 samples" Tag="1024" />
                                        <ComboBoxItem Content="2048 samples (Standard)" Tag="2048" />
                                        <ComboBoxItem Content="4096 samples (High Res)" Tag="4096" />
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="DSP Target Refresh Rate" FontWeight="Medium" FontSize="14" />
                                        <TextBlock x:Name="TxtTargetFpsStatus" Text="60 FPS Fluid High-DPI Timer"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="1" Glyph="&#xE773;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Margin="8,0" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Silence Threshold" FontWeight="Medium" FontSize="14" />
                                        <TextBlock x:Name="TxtSilenceThresholdStatus" Text="-65.0 dB Auto-Sleep Standby"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="1" Glyph="&#xE74F;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Margin="8,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 7. Updates (Auto Update) -->
                        <Border x:Name="SectionUpdates" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="TxtSectionUpdates" Text="Updates" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TxtAutoUpdatesLabel" Text="Automatic Update Checks" FontWeight="Medium" FontSize="14" />
                                        <TextBlock x:Name="TxtAutoUpdatesDesc" Text="Check GitHub Releases in the background without interrupting playback or auto-installing"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SwitchAutoUpdate" AutomationProperties.Name="Automatic Update Checks" Grid.Column="1" IsOn="True" OffContent="" OnContent="" MinWidth="0" Margin="0" />
                                </Grid>

                                <Grid ColumnDefinitions="*,200" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TxtUpdateFrequencyLabel" Text="Check Frequency" FontWeight="Medium" FontSize="14" />
                                        <TextBlock x:Name="TxtUpdateFrequencyDesc" Text="Choose how often Lyrow checks for updates"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ComboUpdateFrequency" AutomationProperties.Name="Update Check Frequency" Grid.Column="1" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="On Startup" Tag="OnStartup" />
                                        <ComboBoxItem Content="Daily" Tag="Daily" />
                                        <ComboBoxItem Content="Weekly" Tag="Weekly" />
                                        <ComboBoxItem Content="Monthly" Tag="Monthly" />
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TxtCurrentVersion" Text="Current Version: v3.5" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock x:Name="TxtUpdateStatusSummary" Text="Release channel: GitHub Releases (Stable)"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="BtnDownloadAndInstallUpdate" AutomationProperties.Name="Download and Install Lyrow Update" Content="Download &amp; Install" Visibility="Collapsed" Style="{ThemeResource AccentButtonStyle}" />
                                        <Button x:Name="BtnOpenUpdateRelease" AutomationProperties.Name="View Update Release Details on GitHub" Content="View Release" Visibility="Collapsed" />
                                        <Button x:Name="BtnCheckUpdates" AutomationProperties.Name="Check for Updates" Content="Check for Updates" />
                                    </StackPanel>
                                </Grid>

                                <ProgressBar x:Name="ProgressUpdateDownload" Height="4" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Margin="0,4,0,0" />
                                <TextBlock x:Name="TxtUpdateDownloadProgress" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />

                                <InfoBar x:Name="UpdateStatusInfoBar" IsOpen="False" IsClosable="True" Severity="Informational" />
                            </StackPanel>
                        </Border>

                        <!-- 8. Shortcuts -->
                        <Border x:Name="SectionShortcuts" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="TxtSectionShortcuts" Text="Shortcuts" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock x:Name="TxtShortcutsDesc" Text="User-defined global hotkeys. No default hotkeys are forced to prevent key collisions."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                                    <TextBlock x:Name="TxtShortcutGlowLabel" Text="Toggle Glow:" VerticalAlignment="Center" />
                                    <TextBox x:Name="TxtHotkeyGlow" AutomationProperties.Name="Global Shortcut for Ambient Glow Toggle" Grid.Column="1" Width="160" PlaceholderText="e.g. Ctrl+Alt+G" />

                                    <TextBlock x:Name="TxtShortcutLyricsLabel" Grid.Row="1" Text="Toggle Lyrics:" VerticalAlignment="Center" />
                                    <TextBox x:Name="TxtHotkeyLyrics" AutomationProperties.Name="Global Shortcut for Synchronized Lyrics Toggle" Grid.Row="1" Grid.Column="1" Width="160" PlaceholderText="e.g. Ctrl+Alt+L" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
                                    <Button x:Name="BtnClearHotkeys" AutomationProperties.Name="Clear Global Shortcuts" Content="Clear" />
                                    <Button x:Name="BtnSaveHotkeys" AutomationProperties.Name="Save Global Shortcuts" Content="Apply Shortcuts" Style="{ThemeResource AccentButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 9. About & Diagnostics -->
                        <Border x:Name="SectionAbout" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Lyrow v3.5" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="Windows 11 Native Ambient Edge Lighting &amp; Apple Music 26/27 Inspired Synchronized Lyrics"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Powered by .NET 10, WinUI 3, Windows App SDK, GSMTC Media Engine, and Real-Time WASAPI Loopback DSP."
                                           FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button x:Name="BtnResetSettings" AutomationProperties.Name="Reset Settings to Defaults" Content="Reset Settings to Defaults" />
                                    <Button x:Name="BtnOpenLogs" AutomationProperties.Name="Open Diagnostic Log" Content="Open Diagnostic Log" />
                                    <Button x:Name="BtnRestartWizard" AutomationProperties.Name="Restart Setup Wizard" Content="Restart Setup Wizard" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                </Grid>

            </ScrollViewer>

                </NavigationView>

        <!-- Setup Wizard Overlay (First-run Experience) -->
        <Grid x:Name="SetupWizardOverlay" Grid.Row="1" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="720" MinHeight="520" MaxHeight="660"
                    Padding="32" CornerRadius="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Wizard Header / Step Breadcrumbs -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Image Source="Assets/lyrow-logo.png" Width="24" Height="24" />
                            <TextBlock Text="Lyrow" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="• Setup" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Step indicator dots -->
                        <StackPanel x:Name="StackWizardBreadcrumbs" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border x:Name="DotStep0" Width="8" Height="8" CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                            <Border x:Name="DotStep1" Width="8" Height="8" CornerRadius="4" Background="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Border x:Name="DotStep2" Width="8" Height="8" CornerRadius="4" Background="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Border x:Name="DotStep3" Width="8" Height="8" CornerRadius="4" Background="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Border x:Name="DotStep4" Width="8" Height="8" CornerRadius="4" Background="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Border x:Name="DotStep5" Width="8" Height="8" CornerRadius="4" Background="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Wizard Step Panels -->
                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <!-- Step 0: Welcome Screen -->
                        <StackPanel x:Name="PanelWizardStep0" Spacing="16" HorizontalAlignment="Center" MaxWidth="540" Visibility="Visible">
                            <Image Source="Assets/lyrow-logo.png" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Lyrow" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TxtWizardSlogan" Text="Your music. Your atmosphere." FontSize="18" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TxtWizardSubtitle" Text="Elevate your desktop with real-time ambient lighting and cinematic lyrics."
                                       FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />

                            <Grid ColumnDefinitions="Auto,*" Margin="0,12,0,0" HorizontalAlignment="Center">
                                <TextBlock Text="Language:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Medium" />
                                <ComboBox x:Name="ComboWizardWelcomeLanguage" Grid.Column="1" Width="180" AutomationProperties.Name="Wizard Welcome Language Selector">
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="Français" Tag="fr" />
                                    <ComboBoxItem Content="Español" Tag="es" />
                                    <ComboBoxItem Content="Deutsch" Tag="de" />
                                    <ComboBoxItem Content="Türkçe" Tag="tr" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>

                        <!-- Step 1: Appearance -->
                        <StackPanel x:Name="PanelWizardStep1" Spacing="16" MaxWidth="540" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="Appearance &amp; Style" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="Choose your preferred theme, interface language, and fluid animations."
                                       FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />

                            <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Margin="0,8,0,0">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Theme Appearance" FontWeight="SemiBold" FontSize="14" />
                                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                        <RadioButton x:Name="RadioWizardThemeSystem" Content="System Default" IsChecked="True" GroupName="WizardThemeGroup" />
                                        <RadioButton x:Name="RadioWizardThemeDark" Content="Dark" GroupName="WizardThemeGroup" />
                                        <RadioButton x:Name="RadioWizardThemeLight" Content="Light" GroupName="WizardThemeGroup" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Fluid Motion &amp; Animations" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="Enable smooth visual transitions and interactive physics"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SwitchWizardAnimations" AutomationProperties.Name="Enable Fluid Motion and Animations in Setup Wizard" Grid.Column="1" IsOn="True" OffContent="" OnContent="" MinWidth="0" Margin="0" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Step 2: Music Player -->
                        <StackPanel x:Name="PanelWizardStep2" Spacing="16" MaxWidth="540" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="Music Player Integration" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="Lyrow seamlessly links with Windows Media Session (GSMTC)."
                                       FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />

                            <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Margin="0,8,0,0">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <FontIcon x:Name="IconWizardPlayerStatus" Glyph="&#xE768;" FontSize="24" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock x:Name="TxtWizardPlayerHeader" Text="Detection Status" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock x:Name="TxtWizardPlayerStatus" Text="Searching for active media sessions..."
                                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <Button x:Name="BtnWizardPlayerRefresh" AutomationProperties.Name="Refresh Media Player Session in Setup Wizard" Content="Refresh Detection" HorizontalAlignment="Right" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Supported: Apple Music, Spotify, Windows Media Player, Edge, Chrome, and all GSMTC-compatible players."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>

                        <!-- Step 3: Synchronized Lyrics -->
                        <StackPanel x:Name="PanelWizardStep3" Spacing="16" MaxWidth="540" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="Cinematic Lyrics" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="LRCLIB provides millisecond-accurate lyrics with word-by-word karaoke highlighting."
                                       FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />

                            <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Margin="0,8,0,0">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <FontIcon Glyph="&#xE8D6;" FontSize="24" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="LRCLIB Database" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock x:Name="TxtWizardLyricsStatus" Text="LRCLIB Service: Connected"
                                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="6" Margin="36,4,0,0">
                                        <TextBlock Text="• Real-time word-by-word fill and smooth line centering" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="• Interactive lyrics seeking (click line to jump in supported players)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="• Offline caching keeps previously viewed lyrics ready anytime" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Step 4: Ambient Glow -->
                        <StackPanel x:Name="PanelWizardStep4" Spacing="16" MaxWidth="540" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="Ambient Edge Glow" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="Four-edge real-time lighting reacts directly to bass, mids, and highs."
                                       FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />

                            <!-- 4-Edge Preview Box -->
                            <Border Margin="0,8,0,0" Height="100" CornerRadius="12" Padding="2"
                                    BorderThickness="3" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                                <Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                        <FontIcon Glyph="&#xE706;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="Reactive four-edge glow around your screen" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Enable Ambient Glow on startup" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="Can also be toggled anytime from the Home page or system tray"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SwitchWizardGlow" AutomationProperties.Name="Enable Ambient Edge Glow in Setup Wizard" Grid.Column="1" IsOn="False" OffContent="" OnContent="" MinWidth="0" Margin="0" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Step 5: Finish -->
                        <StackPanel x:Name="PanelWizardStep5" Spacing="16" MaxWidth="540" HorizontalAlignment="Center" Visibility="Collapsed">
                            <FontIcon Glyph="&#xE73E;" FontSize="48" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="You're All Set!" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="Your music. Your atmosphere." FontSize="15" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Lyrow is configured and ready to elevate your listening experience."
                                       FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />

                            <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Margin="0,8,0,0">
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="16">
                                    <TextBlock Text="Theme:" FontWeight="Medium" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtSummaryTheme" Grid.Column="1" Text="System Default" FontWeight="SemiBold" FontSize="12" />

                                    <TextBlock Grid.Row="1" Text="Language:" FontWeight="Medium" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtSummaryLanguage" Grid.Row="1" Grid.Column="1" Text="English" FontWeight="SemiBold" FontSize="12" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Wizard Footer Action Buttons -->
                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Button x:Name="BtnWizardSkip" AutomationProperties.Name="Skip Setup Wizard" Content="Skip Introduction" Style="{ThemeResource SubtleButtonStyle}" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <Button x:Name="BtnWizardBack" AutomationProperties.Name="Previous Step in Setup Wizard" Content="Back" Visibility="Collapsed" />
                            <Button x:Name="BtnWizardNext" AutomationProperties.Name="Next Step in Setup Wizard" Content="Get Started" Style="{ThemeResource AccentButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>

</Window>

