<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lyrow.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Lyrow"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootShellGrid" RowDefinitions="Auto,*" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- Windows 11 Native Custom TitleBar -->
        <TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Lyrow">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/lyrow.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Mac-Style Floating Toast Notification Container (Top-Right, Zero Layout Shift) -->
        <StackPanel x:Name="ToastContainer" Grid.Row="1"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,16,24,0" Spacing="8"
                    IsHitTestVisible="True"
                    Canvas.ZIndex="1000" />

        <!-- Compact Modern Navigation View (OpenPaneLength=188 for generous content area) -->
        <NavigationView x:Name="NavView" Grid.Row="1"
                        PaneDisplayMode="Left"
                        OpenPaneLength="188"
                        CompactPaneLength="48"
                        IsPaneToggleButtonVisible="True"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavHome" Content="Home" Tag="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavPlayback" Content="Playback" Tag="Playback">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavGlow" Content="Glow" Tag="Glow">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE781;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavLyrics" Content="Lyrics" Tag="Lyrics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC4F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer x:Name="MainScrollViewer"
                          VerticalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          IsTabStop="True"
                          Background="Transparent">
                <Grid x:Name="RootContentGrid" Margin="24,14,24,28" MaxWidth="920" HorizontalAlignment="Stretch" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Global Top InfoBar Toast (Deprecated / Fallback) -->
                    <InfoBar x:Name="TopToastBar" Grid.Row="0" IsOpen="False" Severity="Informational" IsClosable="True" Visibility="Collapsed" Margin="0,0,0,12" />

                    <!-- PAGE: HOME / DASHBOARD -->
                    <StackPanel x:Name="PageHome" Grid.Row="1" Spacing="16" Visibility="Visible" Background="Transparent">
                        <!-- 1. Current Track & Playback Card -->
                        <Border x:Name="CardCurrentTrack" Padding="20" CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="80,*,Auto" RowDefinitions="Auto,Auto">
                                <!-- Album Artwork -->
                                <Border Grid.RowSpan="2" Grid.Column="0" Width="72" Height="72" CornerRadius="10"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Grid>
                                        <Image x:Name="HomeTrackArtwork" Stretch="UniformToFill" />
                                        <FontIcon x:Name="HomeArtworkPlaceholder" Glyph="&#xE8D6;" FontSize="28"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Track Metadata (Title, Artist, Album) -->
                                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="14,0,16,0" Spacing="2">
                                    <TextBlock x:Name="HomeTxtTitle" Text="Waiting for playback..."
                                               FontWeight="SemiBold" FontSize="18" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="HomeTxtArtist" Text="Play music in Spotify, Apple Music, or your browser"
                                               FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="HomeTxtAlbum" Text="" Visibility="Collapsed"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Playback Controls (Previous, Play/Pause, Next) -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="BtnPrevTrack" Width="38" Height="38" Padding="0" CornerRadius="8" ToolTipService.ToolTip="Previous Track">
                                        <FontIcon Glyph="&#xE892;" FontSize="14" />
                                    </Button>
                                    <Button x:Name="BtnPlayPause" Width="42" Height="42" Padding="0" CornerRadius="10" Style="{ThemeResource AccentButtonStyle}" ToolTipService.ToolTip="Play / Pause">
                                        <FontIcon x:Name="IconPlayPause" Glyph="&#xE768;" FontSize="16" />
                                    </Button>
                                    <Button x:Name="BtnNextTrack" Width="38" Height="38" Padding="0" CornerRadius="8" ToolTipService.ToolTip="Next Track">
                                        <FontIcon Glyph="&#xE893;" FontSize="14" />
                                    </Button>
                                </StackPanel>

                                <!-- Timeline Progress -->
                                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="14,12,0,0" ColumnDefinitions="*,Auto">
                                    <ProgressBar x:Name="HomeProgressTimeline" Minimum="0" Maximum="100" Value="0"
                                                 VerticalAlignment="Center" Height="4" Margin="0,0,12,0" />
                                    <TextBlock x:Name="HomeTxtTimestamp" Grid.Column="1" Text="00:00 / 00:00"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 2. Dual Volume Controls (Playback Session & System Master 0% - 100%) -->
                        <Border x:Name="CardVolume" Padding="18,16" CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="*,16,*" VerticalAlignment="Center">
                                <!-- Column 0: Playback / Media App Session Volume -->
                                <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <Button x:Name="BtnMutePlayback" Width="36" Height="36" Padding="0" CornerRadius="8"
                                            ToolTipService.ToolTip="Mute / Unmute Playback">
                                        <FontIcon x:Name="IconPlaybackMute" Glyph="&#xE767;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </Button>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <TextBlock Text="Playback Volume" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtPlaybackTarget" Grid.Column="1" Text="Media App" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtPlaybackVolumePercent" Grid.Column="2" Text="78%" FontWeight="SemiBold"
                                                       FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                        <Slider x:Name="SliderPlaybackVolume" Minimum="0" Maximum="100" Value="78" StepFrequency="1"
                                                Margin="0,2,0,0" IsThumbToolTipEnabled="False" />
                                    </StackPanel>
                                </Grid>

                                <!-- Column 1: System Endpoint Master Volume -->
                                <Grid Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <Button x:Name="BtnMuteSystem" Width="36" Height="36" Padding="0" CornerRadius="8"
                                            ToolTipService.ToolTip="Mute / Unmute System Master Volume">
                                        <FontIcon x:Name="IconSystemMute" Glyph="&#xE767;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </Button>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <TextBlock Text="System Master" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtSystemTarget" Grid.Column="1" Text="Speakers" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtSystemVolumePercent" Grid.Column="2" Text="78%" FontWeight="SemiBold"
                                                       FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                        <Slider x:Name="SliderSystemVolume" Minimum="0" Maximum="100" Value="78" StepFrequency="1"
                                                Margin="0,2,0,0" IsThumbToolTipEnabled="False" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 3. Glow & Lyrics Module Cards -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <!-- Ambient Glow Card -->
                            <Border x:Name="CardGlow" Grid.Column="0" Padding="18" CornerRadius="12"
                                     Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                     BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <FontIcon Glyph="&#xE781;" FontSize="22" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="Ambient Glow" FontWeight="SemiBold" FontSize="16" />
                                            <TextBlock x:Name="TxtGlowStatus" Text="Stopped" FontSize="12"
                                                       Foreground="{StaticResource LyrowStoppedBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="SwitchHomeGlow" Grid.Column="2" IsOn="False" OffContent="" OnContent="" MinWidth="0" Margin="0" />
                                    </Grid>

                                    <TextBlock x:Name="TxtGlowVisualState"
                                               Text="Standby — 4-edge ambient lighting ready"
                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                                    <!-- Live 4-Edge Palette Swatches -->
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6" VerticalAlignment="Center"
                                          Padding="10,7" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                        <TextBlock Text="4-Edge Palette" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <Border x:Name="SwatchTop" Grid.Column="2" Width="14" Height="14" CornerRadius="7" Background="#5EB2FF" ToolTipService.ToolTip="Top Edge" />
                                        <Border x:Name="SwatchBottom" Grid.Column="3" Width="14" Height="14" CornerRadius="7" Background="#FF5388" ToolTipService.ToolTip="Bottom Edge" />
                                        <Border x:Name="SwatchLeft" Grid.Column="4" Width="14" Height="14" CornerRadius="7" Background="#38EF7D" ToolTipService.ToolTip="Left Edge" />
                                        <Border x:Name="SwatchRight" Grid.Column="5" Width="14" Height="14" CornerRadius="7" Background="#8A2BE2" ToolTipService.ToolTip="Right Edge" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Synchronized Lyrics Card -->
                            <Border x:Name="CardLyrics" Grid.Column="1" Padding="18" CornerRadius="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <FontIcon Glyph="&#xEC4F;" FontSize="22" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="Synchronized Lyrics" FontWeight="SemiBold" FontSize="16" />
                                            <TextBlock x:Name="TxtLyricsStatus" Text="Stopped" FontSize="12"
                                                       Foreground="{StaticResource LyrowStoppedBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="SwitchHomeLyrics" Grid.Column="2" IsOn="False" OffContent="" OnContent="" MinWidth="0" Margin="0" />
                                    </Grid>

                                    <TextBlock x:Name="TxtLyricsAvailability"
                                               Text="Waiting for active track..."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />

                                    <Border Padding="10,7" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                        <TextBlock x:Name="TxtHomeCurrentLyricLine"
                                                   Text="♪ Play a song to see live synchronized lyrics"
                                                   FontSize="12" FontWeight="Medium"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- PAGE: GLOW -->
                    <StackPanel x:Name="PageGlow" Grid.Row="1" Spacing="16" Visibility="Collapsed" Background="Transparent">
                        <TextBlock Text="Ambient Edge Lighting" FontSize="22" FontWeight="SemiBold" />

                        <InfoBar IsOpen="True" Severity="Informational" IsClosable="False"
                                 Message="Modern 4-edge ambient lighting renders on a click-through layered surface (WS_EX_TRANSPARENT). Clicks, keyboard shortcuts, and scrolling pass effortlessly to underlying apps." />

                        <!-- Master Toggle -->
                        <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Enable Ambient Glow" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="Continuous 4-edge bloom reacting to bass, mid, treble, and beat transients"
                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="SwitchGlowMaster" Grid.Column="1" IsOn="False" OffContent="" OnContent="" MinWidth="0" Margin="0" />
                            </Grid>
                        </Border>

                        <!-- Intensity, Thickness & Response Sensitivity -->
                        <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Glow Brightness Intensity" FontWeight="Medium" FontSize="14" />
                                    <TextBlock x:Name="TxtGlowIntensityVal" Grid.Column="1" Text="80%" FontWeight="SemiBold"
                                               FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                </Grid>
                                <Slider x:Name="SliderGlowIntensity" Minimum="10" Maximum="100" Value="80" StepFrequency="1" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Edge Bloom Thickness" FontWeight="Medium" FontSize="14" />
                                    <TextBlock x:Name="TxtGlowThicknessVal" Grid.Column="1" Text="48 px" FontWeight="SemiBold"
                                               FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                </Grid>
                                <Slider x:Name="SliderGlowThickness" Minimum="0" Maximum="256" Value="48" StepFrequency="2" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Beat &amp; Transient Reactivity" FontWeight="Medium" FontSize="14" />
                                    <TextBlock x:Name="TxtGlowSensitivityVal" Grid.Column="1" Text="250%" FontWeight="SemiBold"
                                               FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                </Grid>
                                <Slider x:Name="SliderGlowSensitivity" Minimum="0" Maximum="500" Value="250" StepFrequency="5" />
                            </StackPanel>
                        </Border>

                        <!-- Color Palette & Album Art Sync -->
                        <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Sync with Album Artwork" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="Extracts dominant and vibrant accent colors from track cover with smooth crossfade"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SwitchAlbumArtSync" Grid.Column="1" IsOn="True" OffContent="" OnContent="" MinWidth="0" Margin="0" />
                                </Grid>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Fallback Palette Preset" FontWeight="Medium" FontSize="13" />
                                    <ComboBox x:Name="ComboPalettePreset" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Inactivity / Music Stop Graceful Shutdown Delay -->
                        <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="*,200" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Inactivity Shutdown Delay" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="Wait time after music stops before gracefully fading out ambient glow"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="ComboGlowShutdownDelay" Grid.Column="1" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Immediately (0s)" Tag="0" />
                                    <ComboBoxItem Content="1 second" Tag="1" />
                                    <ComboBoxItem Content="3 seconds (Default)" Tag="3" />
                                    <ComboBoxItem Content="5 seconds" Tag="5" />
                                    <ComboBoxItem Content="10 seconds" Tag="10" />
                                    <ComboBoxItem Content="30 seconds" Tag="30" />
                                    <ComboBoxItem Content="1 minute" Tag="60" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Multi-Monitor Target -->
                        <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Target Displays" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="Select which monitors receive 4-edge ambient lighting"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <CheckBox x:Name="ChkMultiMonitor" Content="Enable on All Connected Displays" IsChecked="True" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- PAGE: LYRICS -->
                    <StackPanel x:Name="PageLyrics" Grid.Row="1" Spacing="16" Visibility="Collapsed" Background="Transparent">
                        <TextBlock Text="Synchronized Lyrics" FontSize="22" FontWeight="SemiBold" />

                        <!-- Master Toggle -->
                        <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Lyrics Overlay Window" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="Open Apple Music-style lyrics window with vertically centered active line"
                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="SwitchLyricsMaster" Grid.Column="1" IsOn="False" OffContent="" OnContent="" MinWidth="0" Margin="0" />
                            </Grid>
                        </Border>

                        <!-- Sync Offset Adjustment -->
                        <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Lyrics Timestamp Offset" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="Fine-tune lyrics synchronization against audio playback"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtPageLyricsOffset" Grid.Column="1" Text="0 ms"
                                               FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                </Grid>

                                <Slider x:Name="SliderLyricsOffset" Minimum="-3000" Maximum="3000" Value="0" StepFrequency="50" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="BtnOffsetMinus500" Content="−500 ms" />
                                    <Button x:Name="BtnOffsetReset" Content="Reset (0 ms)" />
                                    <Button x:Name="BtnOffsetPlus500" Content="+500 ms" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Typography & Auto Scroll -->
                        <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Apple Music Fluid Motion" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="Active lyric line is dynamically scaled and vertically centered at 60 FPS"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="1" Glyph="&#xE73E;" FontSize="15" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Margin="8,0" />
                                </Grid>

                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Focused Line Font Size" FontWeight="Medium" FontSize="14" />
                                            <TextBlock Text="Font size of the active playing lyric line (default 28 px)"
                                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock x:Name="TxtFocusedFontSize" Grid.Column="1" Text="28 px" FontWeight="SemiBold"
                                                   FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Slider x:Name="SliderFocusedFontSize" Minimum="20" Maximum="48" Value="28" StepFrequency="1" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Unfocused Lines Font Size" FontWeight="Medium" FontSize="14" />
                                            <TextBlock Text="Font size of surrounding inactive lyric lines (default 20 px)"
                                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock x:Name="TxtUnfocusedFontSize" Grid.Column="1" Text="20 px" FontWeight="SemiBold"
                                                   FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Slider x:Name="SliderUnfocusedFontSize" Minimum="14" Maximum="36" Value="20" StepFrequency="1" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- PAGE: PLAYBACK -->
                    <StackPanel x:Name="PagePlayback" Grid.Row="1" Spacing="16" Visibility="Collapsed" Background="Transparent">
                        <TextBlock x:Name="TxtPlaybackPageHeader" Text="Playback &amp; Volume" FontSize="22" FontWeight="SemiBold" />

                        <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Media Sessions &amp; Master Audio" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="TxtPagePlaybackActiveLabel" Text="Active Session Playback Volume" FontWeight="Medium" FontSize="14" />
                                    <TextBlock x:Name="TxtPagePlaybackVolumePercent" Grid.Column="1" Text="78%" FontWeight="SemiBold"
                                               FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                </Grid>
                                <Slider x:Name="SliderPagePlaybackVolume" Minimum="0" Maximum="100" Value="78" StepFrequency="1" IsThumbToolTipEnabled="False" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="TxtPagePlaybackSystemLabel" Text="System Endpoint Master Volume" FontWeight="Medium" FontSize="14" />
                                    <TextBlock x:Name="TxtPageSystemVolumePercent" Grid.Column="1" Text="78%" FontWeight="SemiBold"
                                               FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                </Grid>
                                <Slider x:Name="SliderPageSystemVolume" Minimum="0" Maximum="100" Value="78" StepFrequency="1" IsThumbToolTipEnabled="False" />

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtPageMediaStatus" Text="Media Transport Controls"
                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="BtnPagePrev" ToolTipService.ToolTip="Previous Track" AutomationProperties.Name="Previous Track" Width="40" Height="40" Padding="0">
                                            <FontIcon Glyph="&#xE892;" FontSize="16" />
                                        </Button>
                                        <Button x:Name="BtnPagePlayPause" Style="{ThemeResource AccentButtonStyle}" ToolTipService.ToolTip="Play / Pause" AutomationProperties.Name="Play / Pause" Width="44" Height="44" Padding="0">
                                            <FontIcon x:Name="IconPagePlayPause" Glyph="&#xE768;" FontSize="18" />
                                        </Button>
                                        <Button x:Name="BtnPageNext" ToolTipService.ToolTip="Next Track" AutomationProperties.Name="Next Track" Width="40" Height="40" Padding="0">
                                            <FontIcon Glyph="&#xE893;" FontSize="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- PAGE: SETTINGS -->
                    <StackPanel x:Name="PageSettings" Grid.Row="1" Spacing="16" Visibility="Collapsed" Background="Transparent">
                        <TextBlock x:Name="TxtSettingsHeader" Text="Settings" FontSize="22" FontWeight="SemiBold" />

                        <!-- Settings Category Selector Bar -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                <Button x:Name="BtnFilterAllSettings" Content="All" CornerRadius="8" Style="{ThemeResource AccentButtonStyle}" />
                                <Button x:Name="BtnFilterGeneral" Content="General" CornerRadius="8" />
                                <Button x:Name="BtnFilterUpdates" Content="Updates" CornerRadius="8" />
                                <Button x:Name="BtnFilterShortcuts" Content="Shortcuts" CornerRadius="8" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 1. General (Theme, Language, Startup, Tray) -->
                        <Border x:Name="SectionGeneral" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="TxtSectionGeneral" Text="General" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                <Grid ColumnDefinitions="*,200" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TxtAppTheme" Text="App Theme" FontWeight="Medium" FontSize="14" />
                                        <TextBlock x:Name="TxtAppThemeDesc" Text="Choose Windows 11 system theme, dark, or light appearance"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ComboTheme" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Windows Default" Tag="SystemDefault" />
                                        <ComboBoxItem Content="Dark" Tag="Dark" />
                                        <ComboBoxItem Content="Light" Tag="Light" />
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnDefinitions="*,200" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TxtLanguageLabel" Text="Language" FontWeight="Medium" FontSize="14" />
                                        <TextBlock x:Name="TxtLanguageDesc" Text="Application user interface language"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ComboLanguage" Grid.Column="1" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="English" Tag="en" />
                                        <ComboBoxItem Content="Français" Tag="fr" />
                                        <ComboBoxItem Content="Español" Tag="es" />
                                        <ComboBoxItem Content="Deutsch" Tag="de" />
                                        <ComboBoxItem Content="Türkçe" Tag="tr" />
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TxtStartupLabel" Text="Launch on Windows Startup" FontWeight="Medium" FontSize="14" />
                                        <TextBlock x:Name="TxtStartupDesc" Text="Start Lyrow automatically when signing into Windows"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SwitchStartWithWindows" Grid.Column="1" IsOn="False" OffContent="" OnContent="" MinWidth="0" Margin="0" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TxtSystemTrayLabel" Text="System Tray Integration" FontWeight="Medium" FontSize="14" />
                                        <TextBlock x:Name="TxtSystemTrayDesc" Text="Keep Lyrow accessible in the Windows notification area"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SwitchSystemTray" Grid.Column="1" IsOn="True" OffContent="" OnContent="" MinWidth="0" Margin="0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 5. Updates (Auto Update) -->
                        <Border x:Name="SectionUpdates" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="TxtSectionUpdates" Text="Updates" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TxtAutoUpdatesLabel" Text="Automatic Update Checks" FontWeight="Medium" FontSize="14" />
                                        <TextBlock x:Name="TxtAutoUpdatesDesc" Text="Check GitHub Releases in the background without interrupting playback or auto-installing"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SwitchAutoUpdate" Grid.Column="1" IsOn="True" OffContent="" OnContent="" MinWidth="0" Margin="0" />
                                </Grid>

                                <Grid ColumnDefinitions="*,200" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TxtUpdateFrequencyLabel" Text="Check Frequency" FontWeight="Medium" FontSize="14" />
                                        <TextBlock x:Name="TxtUpdateFrequencyDesc" Text="Choose how often Lyrow checks for updates"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ComboUpdateFrequency" Grid.Column="1" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="On Startup" Tag="OnStartup" />
                                        <ComboBoxItem Content="Daily" Tag="Daily" />
                                        <ComboBoxItem Content="Weekly" Tag="Weekly" />
                                        <ComboBoxItem Content="Monthly" Tag="Monthly" />
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TxtCurrentVersion" Text="Current Version: v2.8" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock x:Name="TxtUpdateStatusSummary" Text="Release channel: GitHub Releases (Stable)"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="BtnDownloadAndInstallUpdate" Content="Download &amp; Install" Visibility="Collapsed" Style="{ThemeResource AccentButtonStyle}" />
                                        <Button x:Name="BtnOpenUpdateRelease" Content="View Release" Visibility="Collapsed" />
                                        <Button x:Name="BtnCheckUpdates" Content="Check for Updates" />
                                    </StackPanel>
                                </Grid>

                                <ProgressBar x:Name="ProgressUpdateDownload" Height="4" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Margin="0,4,0,0" />
                                <TextBlock x:Name="TxtUpdateDownloadProgress" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />

                                <InfoBar x:Name="UpdateStatusInfoBar" IsOpen="False" IsClosable="True" Severity="Informational" />
                            </StackPanel>
                        </Border>

                        <!-- 6. Shortcuts -->
                        <Border x:Name="SectionShortcuts" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="TxtSectionShortcuts" Text="Shortcuts" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock x:Name="TxtShortcutsDesc" Text="User-defined global hotkeys. No default hotkeys are forced to prevent key collisions."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                                    <TextBlock x:Name="TxtShortcutGlowLabel" Text="Toggle Glow:" VerticalAlignment="Center" />
                                    <TextBox x:Name="TxtHotkeyGlow" Grid.Column="1" Width="160" PlaceholderText="e.g. Ctrl+Alt+G" />

                                    <TextBlock x:Name="TxtShortcutLyricsLabel" Grid.Row="1" Text="Toggle Lyrics:" VerticalAlignment="Center" />
                                    <TextBox x:Name="TxtHotkeyLyrics" Grid.Row="1" Grid.Column="1" Width="160" PlaceholderText="e.g. Ctrl+Alt+L" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
                                    <Button x:Name="BtnClearHotkeys" Content="Clear" />
                                    <Button x:Name="BtnSaveHotkeys" Content="Apply Shortcuts" Style="{ThemeResource AccentButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Diagnostics & Reset -->
                        <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Lyrow v2.8" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="Windows 11 Native Ambient Edge Lighting &amp; Apple Music-Style Synchronized Lyrics"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="BtnResetSettings" Content="Reset Settings to Defaults" />
                                    <Button x:Name="BtnOpenLogs" Content="Open Diagnostic Log" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
