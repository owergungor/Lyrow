                                            <ToggleSwitch x:Name="SwitchModalNotifyOnTrackChange" Grid.Column="2" IsOn="True" OffContent="" OnContent="" MinWidth="0" Margin="0" AutomationProperties.Name="Modal Notify on Track Change Toggle" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- TAB 7: ABOUT (Hakkında: Uygulama Bilgisi, Güncellemeler, Karşılama Ekranı, Tanılama ve Lisans) -->
                                <StackPanel x:Name="ModalSectionAbout" Spacing="8" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtModalSectionAbout" Text="About" FontWeight="SemiBold" FontSize="20" Margin="0,0,0,4" />

                                    <!-- Group 1: Application Info & Actions -->
