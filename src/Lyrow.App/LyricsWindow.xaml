<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lyrow.App.LyricsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Lyrow Lyrics"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout">
        <!-- Ambient Dynamic Artwork Gradient Background with Cinematic Vignette (Preserved) -->
        <Grid x:Name="AmbientBackgroundLayer" IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush x:Name="AmbientBrush" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="StopTopLeft" Color="#121218" Offset="0.0" />
                    <GradientStop x:Name="StopCenter" Color="#0C0E14" Offset="0.5" />
                    <GradientStop x:Name="StopBottomRight" Color="#08080C" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Rectangle Fill="#50000000" />
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                        <GradientStop Color="#00000000" Offset="0.0" />
                        <GradientStop Color="#30000000" Offset="0.6" />
                        <GradientStop Color="#70000000" Offset="1.0" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Main Window Container -->
        <Grid RowDefinitions="Auto,*">
            <!-- Custom WinUI 3 TitleBar -->
            <TitleBar x:Name="LyricsTitleBar" Grid.Row="0" Canvas.ZIndex="100">
                <TitleBar.LeftHeader>
                    <Button x:Name="BtnOpenSettingsModal"
                            Style="{StaticResource LyrowGhostButtonStyle}"
                            Width="32" Height="28" Margin="4,0,2,0"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Settings"
                            AutomationProperties.Name="Open Settings">
                        <FontIcon x:Name="IconOpenSettingsModal" Glyph="&#xE712;" FontSize="14" />
                    </Button>
                </TitleBar.LeftHeader>
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="Assets/lyrow.ico" />
                </TitleBar.IconSource>
            </TitleBar>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" x:Name="MainViewportArea">
                <!-- VIEW 1: HORIZONTAL 50/50 PLAYER & LYRICS -->
                <Grid x:Name="HorizontalView" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColPlayer" Width="*" />
                        <ColumnDefinition x:Name="ColLyrics" Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column (50%): Player / Artwork Container -->
                    <Grid x:Name="PlayerColumnContainer" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="24,8">
                        <ScrollViewer x:Name="PlayerScrollViewer"
                                      VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <StackPanel x:Name="PlayerInnerPanel" Width="300" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                                <!-- 1. Album Artwork -->
                                <Border x:Name="BorderTrackArtwork" Width="300" Height="300" CornerRadius="16"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        HorizontalAlignment="Center">
                                    <Grid>
                                        <Image x:Name="ImgTrackArtwork" Stretch="UniformToFill" />
                                        <FontIcon x:Name="IconArtworkPlaceholder" Glyph="&#xE8D6;" FontSize="64"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- 2. Song Title -->
                                <TextBlock x:Name="TxtSongTitle" Text="Waiting for playback..." FontWeight="Bold"
                                           FontSize="22" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"
                                           Width="300" Margin="0,10,0,0" />

                                <!-- 3. Artist / Album -->
                                <TextBlock x:Name="TxtArtistAlbum" Text="No active media session" FontSize="14"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"
                                           Width="300" Margin="0,3,0,0" />

                                <!-- 4. Playback Progress Bar (Interactive Click/Drag Seek) -->
                                <Grid x:Name="GridProgressHitBox" Width="300" Height="16" Margin="0,8,0,0" Background="Transparent">
                                    <ProgressBar x:Name="ProgressTimeline" Width="300" Height="4" CornerRadius="2"
                                                 Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                </Grid>

                                <!-- 5. Elapsed / Remaining Time -->
                                <Grid x:Name="GridTimestamps" Width="300" Margin="0,2,0,0">
                                    <TextBlock x:Name="TxtElapsed" Text="0:00" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="TxtRemaining" Text="--:--" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                </Grid>

                                <!-- 6. Playback Device (Ghost Dropdown Selector) -->
                                <DropDownButton x:Name="BtnDeviceSelector"
                                                HorizontalAlignment="Center"
                                                Margin="0,6,0,0"
                                                Padding="10,4,10,4"
                                                CornerRadius="8"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                Opacity="0.75"
                                                ToolTipService.ToolTip="Audio Output &amp; Analysis Endpoint (Click to change)">
                                    <DropDownButton.Content>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon x:Name="IconDevice" Glyph="&#xE767;" FontSize="12"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="TxtDevice" Text="Speakers" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       MaxWidth="240" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DropDownButton.Content>
                                    <DropDownButton.Flyout>
                                        <MenuFlyout x:Name="FlyoutAudioDevices" Placement="Bottom">
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>

                                <!-- 7. Controls Row: Dar Mod button on left, Prev/Play/Next centered, Fullscreen button on right -->
                                <Grid x:Name="GridControlsRow" Width="300" Margin="0,8,0,0">
                                    <!-- Dar Mod (Compact) Button: Y-aligned with Prev, X at artwork left edge -->
                                    <Button x:Name="BtnDarMod" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Style="{StaticResource LyrowGhostButtonStyle}"
                                            Width="34" Height="34" Padding="0" CornerRadius="8"
                                            ToolTipService.ToolTip="Compact Mode"
                                            AutomationProperties.Name="Compact Mode">
                                        <FontIcon x:Name="IconDarMod" Glyph="&#xE73F;" FontSize="13" />
                                    </Button>

                                    <!-- Playback Controls Centered (Ghost Button Style, Play/Pause size hierarchy preserved) -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                                        <Button x:Name="BtnPrev" Width="36" Height="36" Padding="0" CornerRadius="18"
                                                Style="{StaticResource LyrowGhostButtonStyle}"
                                                ToolTipService.ToolTip="Previous Track" AutomationProperties.Name="Previous Track">
                                            <FontIcon Glyph="&#xE892;" FontSize="14" />
                                        </Button>
                                        <Button x:Name="BtnPlayPause" Width="46" Height="46" Padding="0" CornerRadius="23"
                                                Style="{StaticResource LyrowGhostButtonStyle}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                ToolTipService.ToolTip="Play / Pause"
                                                AutomationProperties.Name="Play or Pause">
                                            <FontIcon x:Name="IconPlayPause" Glyph="&#xE768;" FontSize="18" />
                                        </Button>
                                        <Button x:Name="BtnNext" Width="36" Height="36" Padding="0" CornerRadius="18"
                                                Style="{StaticResource LyrowGhostButtonStyle}"
                                                ToolTipService.ToolTip="Next Track" AutomationProperties.Name="Next Track">
                                            <FontIcon Glyph="&#xE893;" FontSize="14" />
                                        </Button>
                                    </StackPanel>

                                    <!-- Fullscreen Button: Y-aligned with Next, X at artwork right edge -->
                                    <Button x:Name="BtnFullscreen" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Style="{StaticResource LyrowGhostButtonStyle}"
                                            Width="34" Height="34" Padding="0" CornerRadius="8"
                                            ToolTipService.ToolTip="Fullscreen (F11)"
                                            AutomationProperties.Name="Toggle Fullscreen">
                                        <FontIcon x:Name="IconFullscreen" Glyph="&#xE740;" FontSize="13" />
                                    </Button>
                                </Grid>

                                <!-- 8. Volume Bar (Centered, width equals artwork) -->
                                <Grid x:Name="GridVolumeRow" Width="300" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnVolumeMute" Grid.Column="0" Width="28" Height="28" Padding="0"
                                            CornerRadius="6" Background="Transparent" BorderThickness="0"
                                            ToolTipService.ToolTip="Mute / Unmute" AutomationProperties.Name="Mute or Unmute">
                                        <FontIcon x:Name="IconVolumeMute" Glyph="&#xE767;" FontSize="12" />
                                    </Button>
                                    <Slider x:Name="SliderVolume" Grid.Column="1" Margin="6,0" Minimum="0" Maximum="100"
                                            Value="78" StepFrequency="1" IsThumbToolTipEnabled="False"
                                            AutomationProperties.Name="Volume Slider" />
                                    <TextBlock x:Name="TxtVolumePercent" Grid.Column="2" Text="78%" FontSize="11" Width="32"
                                               VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>

                                <!-- 9. Below Volume Bar: Left Edge Light, Center -/+ ms (aligned with Play/Pause), Right Lyrics Glow & Toggle Lyrics -->
                                <Grid x:Name="GridOffsetRow" Width="300" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 1. Edge Light (Kenar Işığı) Button + Click-to-Toggle Thickness Slider Flyout (0-64 px) -->
                                    <Button x:Name="BtnToggleEdgeGlow" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Width="28" Height="28" Padding="0" CornerRadius="6"
                                            Style="{StaticResource LyrowGhostButtonStyle}"
                                            ToolTipService.ToolTip="Edge Light"
                                            AutomationProperties.Name="Edge Light Thickness">
                                        <FontIcon x:Name="IconToggleEdgeGlow" Glyph="&#xE793;" FontSize="13" />
                                        <FlyoutBase.AttachedFlyout>
                                            <Flyout x:Name="FlyoutEdgeGlowThickness" Placement="Top" LightDismissOverlayMode="Off" ShouldConstrainToRootBounds="True">
                                                <Flyout.FlyoutPresenterStyle>
                                                    <Style TargetType="FlyoutPresenter">
                                                        <Setter Property="Padding" Value="12,8" />
                                                        <Setter Property="MinWidth" Value="220" />
                                                        <Setter Property="MinHeight" Value="40" />
                                                        <Setter Property="CornerRadius" Value="10" />
                                                        <Setter Property="Background" Value="{ThemeResource LyrowModalSurfaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="{ThemeResource LyrowModalBorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                    </Style>
                                                </Flyout.FlyoutPresenterStyle>
                                                <Grid x:Name="GridEdgeThicknessPopup" Width="204" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                                    <FontIcon Grid.Column="0" Glyph="&#xE793;" FontSize="12"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                              VerticalAlignment="Center" />
                                                    <Slider x:Name="SliderEdgeGlowThickness" Grid.Column="1"
                                                            Minimum="0" Maximum="64" Value="24" StepFrequency="1"
                                                            IsThumbToolTipEnabled="False"
                                                            VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                            AutomationProperties.Name="Edge Light Thickness Slider" />
                                                    <TextBlock x:Name="TxtEdgeGlowThicknessHoverValue" Grid.Column="2"
                                                               Text="24 px" FontSize="11" MinWidth="36" TextAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Grid>
                                            </Flyout>
                                        </FlyoutBase.AttachedFlyout>
                                    </Button>

                                    <!-- 2. Offset Group (- ms / value / + ms): True geometric center aligned with Play/Pause -->
                                    <Grid x:Name="GridOffsetCenterGroup" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnOffsetMinus" Grid.Column="0" Style="{StaticResource LyrowGhostButtonStyle}"
                                                AutomationProperties.Name="Decrease Lyrics Offset by 250 ms" Content="−" Width="28" Height="28" Padding="0"
                                                CornerRadius="6" FontSize="12" ToolTipService.ToolTip="−250ms Delay" />
                                        <TextBlock x:Name="TxtOffsetMs" Grid.Column="1" Text="0 ms" FontSize="10.5" MinWidth="40" TextAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,0" />
                                        <Button x:Name="BtnOffsetPlus" Grid.Column="2" Style="{StaticResource LyrowGhostButtonStyle}"
                                                AutomationProperties.Name="Increase Lyrics Offset by 250 ms" Content="+" Width="28" Height="28" Padding="0"
                                                CornerRadius="6" FontSize="12" ToolTipService.ToolTip="+250ms Advance" />
                                    </Grid>

                                    <!-- 3. Right Actions: Lyrics Glow Toggle (left of Show/Hide Lyrics) + Show/Hide Lyrics Toggle (same 28x28 size) -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                                        <Button x:Name="BtnToggleLyricsGlow"
                                                Width="28" Height="28" Padding="0" CornerRadius="6"
                                                Style="{StaticResource LyrowGhostButtonStyle}"
                                                ToolTipService.ToolTip="Lyrics Glow: Off"
                                                AutomationProperties.Name="Toggle Lyrics Glow">
                                            <FontIcon x:Name="IconToggleLyricsGlow" Glyph="&#xE708;" FontSize="13" />
                                        </Button>

                                        <!-- Lyrics Toggle Button: Below volume bar, X at artwork right edge -->
                                        <Button x:Name="BtnToggleLyrics" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Width="28" Height="28" Padding="0" CornerRadius="6"
                                                Style="{ThemeResource AccentButtonStyle}"
                                                ToolTipService.ToolTip="Hide Lyrics"
                                                AutomationProperties.Name="Toggle Lyrics">
                                            <FontIcon x:Name="IconToggleLyrics" Glyph="&#xEC4F;" FontSize="13" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Right Column (50%): Lyrics Viewport -->
                    <Grid x:Name="LyricsColumnContainer" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent">
                        <!-- Lightweight GPU-accelerated Lyrics Glow Aura (defaults OFF in v4.1; toggled by BtnToggleLyricsGlow) -->
                        <Border x:Name="LyricsGlowAuraLayer" IsHitTestVisible="False" Visibility="Collapsed" Opacity="0.0" Margin="8,24">
                            <Border.Background>
                                <RadialGradientBrush Center="0.45,0.5" RadiusX="0.62" RadiusY="0.34">
                                    <GradientStop x:Name="LyricsGlowStopCenter" Color="#8089B4FA" Offset="0.0" />
                                    <GradientStop x:Name="LyricsGlowStopMid" Color="#3389B4FA" Offset="0.52" />
                                    <GradientStop Color="#00000000" Offset="1.0" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>

                        <ScrollViewer x:Name="LyricsScrollViewer"
                                      VerticalScrollMode="Enabled"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollMode="Disabled"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsTabStop="True"
                                      Background="Transparent">
                            <StackPanel x:Name="LyricsPanel" Spacing="20" HorizontalAlignment="Stretch" Background="Transparent" />
                        </ScrollViewer>

                        <!-- Empty State Message -->
                        <Border x:Name="PanelEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                CornerRadius="16" Padding="32,28" MaxWidth="380"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                Visibility="Visible" IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" Spacing="14">
                                <Border Width="56" Height="56" CornerRadius="28"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center">
                                    <FontIcon x:Name="IconEmptyState" Glyph="&#xEC4F;" FontSize="26"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtEmptyState" Text="Waiting for playback..."
                                               FontWeight="SemiBold" FontSize="15"
                                               HorizontalAlignment="Center" TextAlignment="Center" />
                                    <TextBlock x:Name="TxtEmptyStateSub" Text="Play a song in Spotify, Apple Music, or your browser"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12.5"
                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" LineHeight="18" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- VIEW 2: DAR MOD (Compact Player Window Mode — Target Horizontal Reference Layout) -->
                <Grid x:Name="CompactPlayerView" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="12,20,12,6">
                    <Border x:Name="CompactPlayerCard" CornerRadius="0" Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="0">
                        <Grid x:Name="CompactGridContent" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Left Artwork + Right Song Title, Artist/Album, and Progress Scrubber with Elapsed/Remaining Time -->
                            <Grid x:Name="CompactTopRow" Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Album Artwork on the Left (~90x90 px at 150% DPI) -->
                                <Border x:Name="BorderTrackArtworkCompact" Width="60" Height="60" CornerRadius="8"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Grid>
                                        <Image x:Name="ImgTrackArtworkCompact" Stretch="UniformToFill" />
                                        <FontIcon x:Name="IconArtworkPlaceholderCompact" Glyph="&#xE8D6;" FontSize="22"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Right Side: Song Title (top), Artist/Album (below title), Progress Bar + Timestamps (below artist) -->
                                <StackPanel x:Name="CompactTrackAndProgressPanel" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1" HorizontalAlignment="Stretch">
                                    <TextBlock x:Name="TxtSongTitleCompact" Text="Waiting for playback..." FontWeight="SemiBold"
                                               FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock x:Name="TxtArtistAlbumCompact" Text="No active media session" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />

                                    <!-- Scrubber Progress Bar and Elapsed (bottom-left) / Remaining (bottom-right) Time -->
                                    <Grid x:Name="GridProgressCompactContainer" Margin="0,3,0,0" HorizontalAlignment="Stretch">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid x:Name="GridProgressCompactHitBox" Height="8" Background="Transparent" HorizontalAlignment="Stretch">
                                            <ProgressBar x:Name="ProgressTimelineCompact" Height="3" CornerRadius="1.5"
                                                         Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsHitTestVisible="False" />
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,1,0,0" HorizontalAlignment="Stretch">
                                            <TextBlock x:Name="TxtElapsedCompact" Text="0:00" FontSize="9.5"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                                            <TextBlock x:Name="TxtRemainingCompact" Text="--:--" FontSize="9.5"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Row 1: Expandable Middle Lyrics Area (Strictly 3 Lines: Previous, Active, Next) -->
                            <Grid x:Name="GridCompactLyrics" Grid.Row="1" Visibility="Collapsed" Height="60" Margin="0,4,0,0">
                                <ScrollViewer x:Name="CompactLyricsScrollViewer" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="CompactLyricsPanel" Spacing="2" VerticalAlignment="Center"
                                                HorizontalAlignment="Stretch" Padding="4,0" />
                                </ScrollViewer>
                            </Grid>

                            <!-- Row 2: Bottom Horizontal Control Bar: Left Volume/Device, Center Prev/Play-Pause/Next, Right Edge Light, Lyrics & Normal Mode -->
                            <Grid x:Name="CompactControlsRow" Grid.Row="2" Margin="0,4,0,0" ColumnDefinitions="Auto,*,Auto">
                                <!-- Left: Volume/Mute + Icon-Only Audio Output Device Selector (Identical 26x26 Ghost Buttons) -->
                                <StackPanel x:Name="CompactLeftControlsPanel" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="4">
                                    <Button x:Name="BtnVolumeMuteCompact" Width="26" Height="26" Padding="0" CornerRadius="6"
                                            Style="{StaticResource LyrowGhostButtonStyle}"
                                            ToolTipService.ToolTip="Volume &amp; Mute"
                                            AutomationProperties.Name="Volume and Mute">
                                        <FontIcon x:Name="IconVolumeMuteCompact" Glyph="&#xE767;" FontSize="11" />
                                        <Button.Flyout>
                                            <Flyout x:Name="FlyoutVolumeCompact" Placement="TopEdgeAlignedLeft" ShouldConstrainToRootBounds="False">
                                                <Flyout.FlyoutPresenterStyle>
                                                    <Style TargetType="FlyoutPresenter">
                                                        <Setter Property="Padding" Value="10,4,10,4" />
                                                        <Setter Property="MinWidth" Value="204" />
                                                        <Setter Property="MaxWidth" Value="228" />
                                                        <Setter Property="MinHeight" Value="38" />
                                                        <Setter Property="CornerRadius" Value="12" />
                                                        <Setter Property="Background" Value="{ThemeResource LyrowModalSurfaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="{ThemeResource LyrowModalBorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                    </Style>
                                                </Flyout.FlyoutPresenterStyle>
                                                <Grid x:Name="GridVolumePopupCompact" Width="192" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                                    <Button x:Name="BtnPopupMuteCompact" Grid.Column="0" Width="26" Height="26" Padding="0"
                                                            CornerRadius="6" Style="{StaticResource LyrowGhostButtonStyle}"
                                                            ToolTipService.ToolTip="Mute / Unmute" AutomationProperties.Name="Mute or Unmute">
                                                        <FontIcon x:Name="IconPopupMuteCompact" Glyph="&#xE74F;" FontSize="12" />
                                                    </Button>
                                                    <Slider x:Name="SliderVolumeCompact" Grid.Column="1" Minimum="0" Maximum="100" Value="80"
                                                            VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                                                    <Button x:Name="BtnPopupVolumeMaxCompact" Grid.Column="2" Width="26" Height="26" Padding="0"
                                                            CornerRadius="6" Style="{StaticResource LyrowGhostButtonStyle}"
                                                            ToolTipService.ToolTip="Max Volume" AutomationProperties.Name="Max Volume">
                                                        <FontIcon x:Name="IconPopupVolumeRightCompact" Glyph="&#xE767;" FontSize="12" />
                                                    </Button>
                                                </Grid>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>

                                    <Button x:Name="BtnDeviceSelectorCompact"
                                            Width="26" Height="26" Padding="0" CornerRadius="6"
                                            Style="{StaticResource LyrowGhostButtonStyle}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Audio Output"
                                            AutomationProperties.Name="Audio Output">
                                        <FontIcon x:Name="IconDeviceCompact" Glyph="&#xE7F5;" FontSize="11" />
                                        <Button.Flyout>
                                            <MenuFlyout x:Name="FlyoutAudioDevicesCompact" Placement="Bottom" />
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>

                                <!-- Center: Prev, Play/Pause, Next (Ghost Buttons) -->
                                <StackPanel x:Name="CompactCenterTransportPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                    <Button x:Name="BtnPrevCompact" Width="26" Height="26" Padding="0" CornerRadius="6"
                                            Style="{StaticResource LyrowGhostButtonStyle}"
                                            ToolTipService.ToolTip="Previous Track" AutomationProperties.Name="Previous Track">
                                        <FontIcon Glyph="&#xE892;" FontSize="11" />
                                    </Button>
                                    <Button x:Name="BtnPlayPauseCompact" Width="30" Height="30" Padding="0" CornerRadius="8"
                                            Style="{StaticResource LyrowGhostButtonStyle}"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            ToolTipService.ToolTip="Play / Pause"
                                            AutomationProperties.Name="Play or Pause">
                                        <FontIcon x:Name="IconPlayPauseCompact" Glyph="&#xE768;" FontSize="13" />
                                    </Button>
                                    <Button x:Name="BtnNextCompact" Width="26" Height="26" Padding="0" CornerRadius="6"
                                            Style="{StaticResource LyrowGhostButtonStyle}"
                                            ToolTipService.ToolTip="Next Track" AutomationProperties.Name="Next Track">
                                        <FontIcon Glyph="&#xE893;" FontSize="11" />
                                    </Button>
                                </StackPanel>

                                <!-- Right: Edge Light Thickness Flyout + Compact Lyrics Toggle + Normal Mode (Ghost Buttons, 26x26) -->
                                <StackPanel x:Name="CompactRightControlsPanel" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                                    <Button x:Name="BtnToggleEdgeGlowCompact" Width="26" Height="26" Padding="0" CornerRadius="6"
                                            Style="{StaticResource LyrowGhostButtonStyle}"
                                            ToolTipService.ToolTip="Edge Light"
                                            AutomationProperties.Name="Edge Light Thickness">
                                        <FontIcon x:Name="IconToggleEdgeGlowCompact" Glyph="&#xE793;" FontSize="11" />
                                        <FlyoutBase.AttachedFlyout>
                                            <Flyout x:Name="FlyoutEdgeGlowThicknessCompact" Placement="TopEdgeAlignedRight" LightDismissOverlayMode="Off" ShouldConstrainToRootBounds="False">
                                                <Flyout.FlyoutPresenterStyle>
                                                    <Style TargetType="FlyoutPresenter">
                                                        <Setter Property="Padding" Value="12,8" />
                                                        <Setter Property="MinWidth" Value="212" />
                                                        <Setter Property="MaxWidth" Value="232" />
                                                        <Setter Property="MinHeight" Value="40" />
                                                        <Setter Property="CornerRadius" Value="10" />
                                                        <Setter Property="Background" Value="{ThemeResource LyrowModalSurfaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="{ThemeResource LyrowModalBorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                    </Style>
                                                </Flyout.FlyoutPresenterStyle>
                                                <Grid x:Name="GridEdgeThicknessPopupCompact" Width="196" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                                    <FontIcon Grid.Column="0" Glyph="&#xE793;" FontSize="12"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                              VerticalAlignment="Center" />
                                                    <Slider x:Name="SliderEdgeGlowThicknessCompact" Grid.Column="1"
                                                            Minimum="0" Maximum="64" Value="24" StepFrequency="1"
                                                            IsThumbToolTipEnabled="False"
                                                            VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                            AutomationProperties.Name="Compact Edge Light Thickness Slider" />
                                                    <TextBlock x:Name="TxtEdgeGlowThicknessCompactValue" Grid.Column="2"
                                                               Text="24 px" FontSize="11" MinWidth="36" TextAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Grid>
                                            </Flyout>
                                        </FlyoutBase.AttachedFlyout>
                                    </Button>
                                    <Button x:Name="BtnExpandFromCompact" Width="26" Height="26" Padding="0" CornerRadius="6"
                                            Style="{StaticResource LyrowGhostButtonStyle}"
                                            ToolTipService.ToolTip="Show / Hide Compact Lyrics"
                                            AutomationProperties.Name="Toggle Compact Lyrics">
                                        <FontIcon x:Name="IconExpandFromCompact" Glyph="&#xEC4F;" FontSize="11" />
                                    </Button>
                                    <Button x:Name="BtnNormalModeCompact" Width="26" Height="26" Padding="0" CornerRadius="6"
                                            Style="{StaticResource LyrowGhostButtonStyle}"
                                            ToolTipService.ToolTip="Normal mode"
                                            AutomationProperties.Name="Normal mode">
                                        <FontIcon x:Name="IconNormalModeCompact" Glyph="&#xE740;" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Window-Scoped Toast Notification Overlay for LyricsWindow & Compact Player -->
                <StackPanel x:Name="LyricsToastContainer"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                            Margin="0,12,16,0"
                            Spacing="8"
                            Canvas.ZIndex="1000" />
            </Grid>
        </Grid>

        <!-- Centered Modern Windows 11 Settings Modal Dialog Overlay (v4.2) -->
        <Grid x:Name="SettingsModalOverlay" Visibility="Collapsed" Canvas.ZIndex="2000" IsHitTestVisible="True">
            <!-- Semi-transparent Dimming Backdrop (blocks all pointer interaction with main window) -->
            <Border x:Name="SettingsModalBackdrop"
                    Background="{ThemeResource LyrowModalBackdropBrush}"
                    Opacity="0"
                    IsHitTestVisible="True" />

            <!-- Centered Fixed-Size Fluent Windows 11 Settings Modal Container (v4.3: 3 Tabs, Left-Aligned Sidebar) -->
            <Border x:Name="SettingsModalCard"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="740"
                    Height="520"
                    MaxWidth="780"
                    MaxHeight="600"
                    Margin="20,40,20,20"
                    CornerRadius="12"
                    Background="{ThemeResource LyrowModalSurfaceBrush}"
                    BorderBrush="{ThemeResource LyrowModalBorderBrush}"
                    BorderThickness="1"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="SettingsModalCardScale" ScaleX="0.96" ScaleY="0.96" />
                </Border.RenderTransform>

                <Grid RowDefinitions="Auto,*">
                    <!-- Top Header Bar -->
                    <Grid Grid.Row="0" Padding="20,14,14,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock x:Name="TxtSettingsModalTitle" Text="Settings" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="BtnCloseSettingsModal"
                                Style="{StaticResource LyrowGhostButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="32" Height="32" CornerRadius="6"
                                ToolTipService.ToolTip="Close (Esc)"
                                AutomationProperties.Name="Close Settings Modal">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- Windows 11 Two-Pane Body: Left-Aligned 3-Tab Sidebar + Right Fixed-Height Scrollable Content -->
                    <Grid x:Name="SettingsModalBodyGrid" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColSettingsSidebar" Width="212" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Sidebar Category Navigation (Strictly 3 Tabs: General, Lyrics, System & Notifications) -->
                        <Border x:Name="SettingsModalSidebar" Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Padding="10,12,10,12"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,1,0"
                                Background="{ThemeResource LayerFillColorAltBrush}">
                            <StackPanel HorizontalAlignment="Stretch" Spacing="4">
                                <Button x:Name="BtnModalTabGeneral" Tag="General" Style="{StaticResource LyrowGhostButtonStyle}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                                        Height="38" Padding="8,0,12,0" CornerRadius="6"
                                        AutomationProperties.Name="General">
                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border x:Name="NavIndicatorGeneral" Width="3" Height="16" CornerRadius="1.5" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Visible" />
                                        <FontIcon Grid.Column="1" Glyph="&#xE713;" FontSize="15" />
                                        <TextBlock x:Name="TxtModalNavGeneral" Grid.Column="2" Text="General" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>

                                <Button x:Name="BtnModalTabLyrics" Tag="Lyrics" Style="{StaticResource LyrowGhostButtonStyle}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                                        Height="38" Padding="8,0,12,0" CornerRadius="6"
                                        AutomationProperties.Name="Lyrics">
                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border x:Name="NavIndicatorLyrics" Width="3" Height="16" CornerRadius="1.5" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                        <FontIcon Grid.Column="1" Glyph="&#xE8D2;" FontSize="15" />
                                        <TextBlock x:Name="TxtModalNavLyrics" Grid.Column="2" Text="Lyrics" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>

                                <Button x:Name="BtnModalTabSystem" Tag="System" Style="{StaticResource LyrowGhostButtonStyle}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                                        Height="38" Padding="8,0,12,0" CornerRadius="6"
                                        AutomationProperties.Name="System &amp; Notifications">
                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border x:Name="NavIndicatorSystem" Width="3" Height="16" CornerRadius="1.5" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                        <FontIcon Grid.Column="1" Glyph="&#xE7F4;" FontSize="15" />
                                        <TextBlock x:Name="TxtModalNavSystem" Grid.Column="2" Text="System &amp; Notifications" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Right Content Pane: Fixed-Area Independently Scrollable Windows 11 Settings Cards -->
                        <ScrollViewer x:Name="SettingsModalScrollViewer"
                                      Grid.Column="1"
                                      VerticalScrollMode="Enabled"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Disabled"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="24,18,24,24">
                            <StackPanel x:Name="SettingsModalContentPanel" Spacing="16">

                                <!-- TAB 1: GENERAL (Appearance, Artwork, Audio & Edge Light) -->
                                <StackPanel x:Name="ModalSectionGeneral" Spacing="4">
                                    <TextBlock x:Name="TxtModalSectionGeneral" Text="General" FontWeight="SemiBold" FontSize="20" Margin="0,0,0,10" />

                                    <TextBlock x:Name="TxtModalSectionAppearance" Text="Appearance &amp; Personalization" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="2,4,0,4" />

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,164" ColumnSpacing="14" VerticalAlignment="Center">
                                            <FontIcon Grid.Column="0" Glyph="&#xF2B7;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock x:Name="TxtModalLanguageLabel" Text="Language" FontWeight="Normal" FontSize="14" />
                                                <TextBlock x:Name="TxtModalLanguageDesc" Text="Interface display language" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ComboBox x:Name="ComboModalLanguage" Grid.Column="2" HorizontalAlignment="Stretch" AutomationProperties.Name="Modal Language Selector">
                                                <ComboBoxItem Content="English" Tag="en" />
                                                <ComboBoxItem Content="Français" Tag="fr" />
                                                <ComboBoxItem Content="Español" Tag="es" />
                                                <ComboBoxItem Content="Deutsch" Tag="de" />
                                                <ComboBoxItem Content="Türkçe" Tag="tr" />
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,164" ColumnSpacing="14" VerticalAlignment="Center">
                                            <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock x:Name="TxtModalThemeLabel" Text="Theme" FontWeight="Normal" FontSize="14" />
                                                <TextBlock x:Name="TxtModalThemeDesc" Text="Light, Dark, or follow Windows system theme" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ComboBox x:Name="ComboModalTheme" Grid.Column="2" HorizontalAlignment="Stretch" AutomationProperties.Name="Modal Theme Selector">
                                                <ComboBoxItem Content="System Default" Tag="SystemDefault" />
                                                <ComboBoxItem Content="Dark" Tag="Dark" />
                                                <ComboBoxItem Content="Light" Tag="Light" />
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                            <FontIcon Grid.Column="0" Glyph="&#xE945;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock x:Name="TxtModalAnimationsLabel" Text="Fluid Motion &amp; Animations" FontWeight="Normal" FontSize="14" />
                                                <TextBlock x:Name="TxtModalAnimationsDesc" Text="Enable smooth visual transitions and interactive physics" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="SwitchModalEnableAnimations" Grid.Column="2" IsOn="True" OffContent="" OnContent="" MinWidth="0" Margin="0" AutomationProperties.Name="Modal Animations Toggle" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                                <FontIcon Grid.Column="0" Glyph="&#xE793;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtModalMasterOpacityLabel" Grid.Column="1" Text="Window Opacity" FontWeight="Normal" FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtModalMasterOpacityPercent" Grid.Column="2" Text="95%" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                            <Slider x:Name="SliderModalMasterOpacity" Minimum="50" Maximum="100" Value="95" StepFrequency="1" AutomationProperties.Name="Modal Master Opacity Slider" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Artwork & Dynamic Background -->
                                    <TextBlock x:Name="TxtModalSectionArtwork" Text="Artwork &amp; Dynamic Background" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="2,14,0,4" />

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                            <FontIcon Grid.Column="0" Glyph="&#xEB9F;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock x:Name="TxtModalArtworkDynamicBgLabel" Text="Dynamic Ambient Background Layer" FontWeight="Normal" FontSize="14" />
                                                <TextBlock x:Name="TxtModalArtworkDynamicBgDesc" Text="Subtle, fluidly tinted blurred artwork atmosphere" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="SwitchModalArtworkDynamicBg" Grid.Column="2" IsOn="True" OffContent="" OnContent="" MinWidth="0" Margin="0" AutomationProperties.Name="Modal Dynamic Ambient Background Toggle" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock x:Name="TxtModalArtworkSaturationLabel" Text="Ambient Background Saturation" FontWeight="Normal" FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtModalArtworkSaturationPercent" Grid.Column="1" Text="100%" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                            <Slider x:Name="SliderModalArtworkSaturation" Minimum="10" Maximum="150" Value="100" StepFrequency="5" AutomationProperties.Name="Modal Artwork Saturation Slider" />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock x:Name="TxtModalArtworkRadiusLabel" Text="Artwork Corner Radius" FontWeight="Normal" FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtModalArtworkRadiusValue" Grid.Column="1" Text="12 px" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                            <Slider x:Name="SliderModalArtworkCornerRadius" Minimum="4" Maximum="24" Value="12" StepFrequency="1" AutomationProperties.Name="Modal Artwork Corner Radius Slider" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Audio Engine & Edge Light -->
                                    <TextBlock x:Name="TxtModalSectionAudio" Text="Audio Engine &amp; Edge Light" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="2,14,0,4" />

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                            <FontIcon Grid.Column="0" Glyph="&#xE793;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock x:Name="TxtModalAmbientGlowLabel" Text="Edge Light" FontWeight="Normal" FontSize="14" />
                                                <TextBlock x:Name="TxtModalAmbientGlowDesc" Text="4-edge music reactive screen lighting" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="SwitchModalAmbientEdgeGlow" Grid.Column="2" IsOn="False" OffContent="" OnContent="" MinWidth="0" Margin="0" AutomationProperties.Name="Modal Ambient Edge Glow Toggle" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock x:Name="TxtModalGlowIntensityLabel" Text="Edge Light Brightness" FontWeight="Normal" FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtModalGlowIntensityPercent" Grid.Column="1" Text="80%" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                            <Slider x:Name="SliderModalGlowIntensity" Minimum="10" Maximum="100" Value="80" StepFrequency="5" AutomationProperties.Name="Modal Glow Intensity Slider" />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock x:Name="TxtModalGlowThicknessLabel" Text="Edge Light Thickness" FontWeight="Normal" FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtModalGlowThicknessValue" Grid.Column="1" Text="24 px" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                            <Slider x:Name="SliderModalGlowThickness" Minimum="0" Maximum="64" Value="24" StepFrequency="1" AutomationProperties.Name="Modal Glow Thickness Slider" />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtModalSyncAlbumArtLabel" Text="Sync Edge Light with Album Art" FontWeight="Normal" FontSize="14" VerticalAlignment="Center" />
                                            <ToggleSwitch x:Name="SwitchModalSyncWithAlbumArt" Grid.Column="1" IsOn="True" OffContent="" OnContent="" MinWidth="0" Margin="0" AutomationProperties.Name="Modal Sync Glow with Album Art" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="*,164" ColumnSpacing="12" VerticalAlignment="Center">
                                            <StackPanel Spacing="2">
                                                <TextBlock x:Name="TxtModalFftSizeLabel" Text="FFT Analysis Window Size" FontWeight="Normal" FontSize="14" />
                                                <TextBlock x:Name="TxtModalFftSizeDesc" Text="Sample window for frequency analysis" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ComboBox x:Name="ComboModalFftSize" Grid.Column="1" SelectedIndex="1" HorizontalAlignment="Stretch" AutomationProperties.Name="Modal FFT Size Selector">
                                                <ComboBoxItem Content="1024 samples" Tag="1024" />
                                                <ComboBoxItem Content="2048 samples (Standard)" Tag="2048" />
                                                <ComboBoxItem Content="4096 samples (High Res)" Tag="4096" />
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- TAB 2: LYRICS (Şarkı Sözleri) -->
                                <StackPanel x:Name="ModalSectionLyrics" Spacing="4" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtModalSectionLyrics" Text="Lyrics" FontWeight="SemiBold" FontSize="20" Margin="0,0,0,10" />

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                            <FontIcon Grid.Column="0" Glyph="&#xE706;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock x:Name="TxtModalLyricsGlowLabel" Text="Lyrics Glow Effect" FontWeight="Normal" FontSize="14" />
                                                <TextBlock x:Name="TxtModalLyricsGlowDesc" Text="Soft luminous aura on active synchronized lyrics" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="SwitchModalLyricsGlow" Grid.Column="2" IsOn="False" OffContent="" OnContent="" MinWidth="0" Margin="0" AutomationProperties.Name="Modal Lyrics Glow Toggle" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                                <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtModalBackdropOpacityLabel" Grid.Column="1" Text="Lyrics Backdrop Opacity" FontWeight="Normal" FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtModalBackdropOpacityPercent" Grid.Column="2" Text="85%" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                            <Slider x:Name="SliderModalBackdropOpacity" Minimum="40" Maximum="100" Value="85" StepFrequency="5" AutomationProperties.Name="Modal Lyrics Backdrop Opacity Slider" />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                                <FontIcon Grid.Column="0" Glyph="&#xE8D2;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtModalFocusedFontLabel" Grid.Column="1" Text="Active Lyric Font Size" FontWeight="Normal" FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtModalFocusedFontValue" Grid.Column="2" Text="28 px" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                            <Slider x:Name="SliderModalFocusedFontSize" Minimum="18" Maximum="42" Value="28" StepFrequency="1" AutomationProperties.Name="Modal Active Lyric Font Size Slider" />

                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Margin="0,4,0,0">
                                                <FontIcon Grid.Column="0" Glyph="&#xE8D2;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtModalUnfocusedFontLabel" Grid.Column="1" Text="Inactive Lyric Font Size" FontWeight="Normal" FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtModalUnfocusedFontValue" Grid.Column="2" Text="20 px" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                            <Slider x:Name="SliderModalUnfocusedFontSize" Minimum="14" Maximum="32" Value="20" StepFrequency="1" AutomationProperties.Name="Modal Inactive Lyric Font Size Slider" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- TAB 3: SYSTEM & NOTIFICATIONS (Sistem ve Bildirimler, Güncellemeler, Kısayollar, Hakkında) -->
                                <StackPanel x:Name="ModalSectionSystem" Spacing="4" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtModalSectionSystem" Text="System &amp; Notifications" FontWeight="SemiBold" FontSize="20" Margin="0,0,0,10" />

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                            <FontIcon Grid.Column="0" Glyph="&#xE7E8;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock x:Name="TxtModalStartupLabel" Text="Launch on Windows Startup" FontWeight="Normal" FontSize="14" />
                                                <TextBlock x:Name="TxtModalStartupDesc" Text="Start Lyrow automatically when signing into Windows" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="SwitchModalStartWithWindows" Grid.Column="2" IsOn="False" OffContent="" OnContent="" MinWidth="0" Margin="0" AutomationProperties.Name="Modal Launch on Startup" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                            <FontIcon Grid.Column="0" Glyph="&#xE756;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock x:Name="TxtModalSystemTrayLabel" Text="System Tray Integration" FontWeight="Normal" FontSize="14" />
                                                <TextBlock x:Name="TxtModalSystemTrayDesc" Text="Keep Lyrow accessible in the Windows notification area" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="SwitchModalSystemTray" Grid.Column="2" IsOn="True" OffContent="" OnContent="" MinWidth="0" Margin="0" AutomationProperties.Name="Modal System Tray Toggle" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                            <FontIcon Grid.Column="0" Glyph="&#xE921;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock x:Name="TxtModalMinimizeToTrayLabel" Text="Minimize to System Tray" FontWeight="Normal" FontSize="14" />
                                                <TextBlock x:Name="TxtModalMinimizeToTrayDesc" Text="Hide to the system tray when closing the window" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="SwitchModalMinimizeToTray" Grid.Column="2" IsOn="True" OffContent="" OnContent="" MinWidth="0" Margin="0" AutomationProperties.Name="Modal Minimize to Tray Toggle" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                            <FontIcon Grid.Column="0" Glyph="&#xEA8F;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock x:Name="TxtModalNotificationsLabel" Text="Desktop Notifications" FontWeight="Normal" FontSize="14" />
                                                <TextBlock x:Name="TxtModalNotificationsDesc" Text="Show notifications for updates and system events" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="SwitchModalNotifications" Grid.Column="2" IsOn="True" OffContent="" OnContent="" MinWidth="0" Margin="0" AutomationProperties.Name="Modal Desktop Notifications Toggle" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                            <FontIcon Grid.Column="0" Glyph="&#xE8D6;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock x:Name="TxtModalNotifyOnTrackChangeLabel" Text="Notify on Track Change" FontWeight="Normal" FontSize="14" />
                                                <TextBlock x:Name="TxtModalNotifyOnTrackChangeDesc" Text="Display a brief notification when the playing track changes" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="SwitchModalNotifyOnTrackChange" Grid.Column="2" IsOn="True" OffContent="" OnContent="" MinWidth="0" Margin="0" AutomationProperties.Name="Modal Notify on Track Change Toggle" />
                                        </Grid>
                                    </Border>

                                    <!-- Updates -->
                                    <TextBlock x:Name="TxtModalSectionUpdates" Text="Updates" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="2,14,0,4" />

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                            <StackPanel Spacing="2">
                                                <TextBlock x:Name="TxtModalAutoUpdatesLabel" Text="Automatic Update Checks" FontWeight="Normal" FontSize="14" />
                                                <TextBlock x:Name="TxtModalAutoUpdatesDesc" Text="Check GitHub Releases in the background" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="SwitchModalAutoUpdate" Grid.Column="1" IsOn="True" OffContent="" OnContent="" MinWidth="0" Margin="0" AutomationProperties.Name="Modal Auto Update Toggle" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="*,164" ColumnSpacing="12" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtModalUpdateFreqLabel" Text="Check Frequency" FontWeight="Normal" FontSize="14" VerticalAlignment="Center" />
                                            <ComboBox x:Name="ComboModalUpdateFrequency" Grid.Column="1" HorizontalAlignment="Stretch" AutomationProperties.Name="Modal Update Frequency Selector">
                                                <ComboBoxItem Content="On Startup" Tag="OnStartup" />
                                                <ComboBoxItem Content="Daily" Tag="Daily" />
                                                <ComboBoxItem Content="Weekly" Tag="Weekly" />
                                                <ComboBoxItem Content="Monthly" Tag="Monthly" />
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtModalUpdateStatus" Text="Lyrow v4.3 — Release channel: GitHub Releases" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <Button x:Name="BtnModalCheckUpdates" Grid.Column="1" Content="Check for Updates" AutomationProperties.Name="Modal Check for Updates" />
                                        </Grid>
                                    </Border>

                                    <!-- Shortcuts -->
                                    <TextBlock x:Name="TxtModalSectionShortcuts" Text="Shortcuts" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="2,14,0,4" />

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtModalShortcutGlowLabel" Text="Toggle Edge Light" FontWeight="Normal" VerticalAlignment="Center" FontSize="14" />
                                            <TextBox x:Name="TxtModalHotkeyGlow" Grid.Column="1" Width="160" PlaceholderText="e.g. Ctrl+Alt+G" AutomationProperties.Name="Modal Hotkey Glow" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtModalShortcutLyricsLabel" Text="Toggle Lyrics" FontWeight="Normal" VerticalAlignment="Center" FontSize="14" />
                                            <TextBox x:Name="TxtModalHotkeyLyrics" Grid.Column="1" Width="160" PlaceholderText="e.g. Ctrl+Alt+L" AutomationProperties.Name="Modal Hotkey Lyrics" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                                        <Button x:Name="BtnModalClearHotkeys" Content="Clear" AutomationProperties.Name="Modal Clear Shortcuts" />
                                        <Button x:Name="BtnModalSaveHotkeys" Content="Apply Shortcuts" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.Name="Modal Apply Shortcuts" />
                                    </StackPanel>

                                    <!-- About & Diagnostics -->
                                    <TextBlock x:Name="TxtModalSectionAbout" Text="About" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="2,14,0,4" />

                                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Spacing="10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Lyrow v4.3" FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock x:Name="TxtModalAboutSubtitle" Text="Native Windows Ambient Edge Lighting &amp; Synchronized Lyrics" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                <Button x:Name="BtnModalResetSettings" Content="Reset to Defaults" AutomationProperties.Name="Modal Reset Settings" />
                                                <Button x:Name="BtnModalOpenLogs" Content="Open Diagnostic Log" AutomationProperties.Name="Modal Open Logs" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
