                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalAlignment="Center">
                                                <Image x:Name="ImgModalAboutLogo" Grid.Column="0" Width="44" Height="44" Stretch="Uniform" VerticalAlignment="Center" AutomationProperties.Name="Lyrow Logo">
                                                    <Image.Source>
                                                        <BitmapImage UriSource="ms-appx:///Assets/lyrow-logo-300.png" DecodePixelWidth="88" />
                                                    </Image.Source>
                                                </Image>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="Lyrow v5.0" FontWeight="SemiBold" FontSize="15" />
                                                    <TextBlock x:Name="TxtModalAboutSubtitle" Text="Synchronized lyrics and music visualization for Windows" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="TxtModalAboutLicense" Text="MIT License — Open Source" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                <Button x:Name="BtnModalShowWelcomeAbout" Content="Show Welcome Screen" AutomationProperties.Name="Show Welcome Screen" />
                                                <Button x:Name="BtnModalResetSettings" Content="Reset to Defaults" AutomationProperties.Name="Modal Reset Settings" />
                                                <Button x:Name="BtnModalOpenLogs" Content="Open Diagnostic Log" AutomationProperties.Name="Modal Open Logs" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Group 2: Updates (Consolidated from removed Updates tab) -->
                                    <TextBlock x:Name="TxtModalSectionUpdates" Text="Updates" FontWeight="SemiBold" FontSize="15" Margin="2,8,0,2" />

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                            <StackPanel Spacing="2">
                                                <TextBlock x:Name="TxtModalAutoUpdatesLabel" Text="Automatic Update Checks" FontWeight="Normal" FontSize="14" />
                                                <TextBlock x:Name="TxtModalAutoUpdatesDesc" Text="Check GitHub Releases in the background" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="SwitchModalAutoUpdate" Grid.Column="1" IsOn="True" OffContent="" OnContent="" MinWidth="0" Margin="0" AutomationProperties.Name="Modal Auto Update Toggle" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="*,164" ColumnSpacing="12" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtModalUpdateFreqLabel" Text="Check Frequency" FontWeight="Normal" FontSize="14" VerticalAlignment="Center" />
                                            <ComboBox x:Name="ComboModalUpdateFrequency" Grid.Column="1" HorizontalAlignment="Stretch" AutomationProperties.Name="Modal Update Frequency Selector">
                                                <ComboBoxItem Content="On Startup" Tag="OnStartup" />
                                                <ComboBoxItem Content="Daily" Tag="Daily" />
                                                <ComboBoxItem Content="Weekly" Tag="Weekly" />
                                                <ComboBoxItem Content="Monthly" Tag="Monthly" />
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                            <ProgressRing x:Name="RingModalUpdateChecking" Grid.Column="0" Width="16" Height="16" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtModalUpdateStatus" Grid.Column="1" Text="Lyrow v5.0 — Release channel: GitHub Releases" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <Button x:Name="BtnModalCheckUpdates" Grid.Column="2" Content="Check for Updates" AutomationProperties.Name="Modal Check for Updates" />
                                        </Grid>
                                    </Border>

                                    <!-- Update Available / Progress / Error Details Card (shown dynamically by UpdateCoordinator) -->
                                    <Border x:Name="BorderModalUpdateDetails" Visibility="Collapsed"
                                            Padding="16,14" CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock x:Name="TxtModalUpdateVersionTitle" Grid.Column="0" Text="" FontWeight="SemiBold" FontSize="14.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtModalUpdatePublishedDate" Grid.Column="1" Text="" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            </Grid>

                                            <TextBlock x:Name="TxtModalUpdateReleaseNotes" Text="" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis"
                                                       Visibility="Collapsed" />

                                            <ProgressBar x:Name="ProgressModalUpdate" Minimum="0" Maximum="100" Value="0" Height="4"
                                                         HorizontalAlignment="Stretch" Visibility="Collapsed" />
                                            <TextBlock x:Name="TxtModalUpdateProgressDetails" Text="" FontSize="11.5"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       TextWrapping="Wrap" Visibility="Collapsed" />

                                            <TextBlock x:Name="TxtModalUpdateError" Text="" FontSize="12"
                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                       TextWrapping="Wrap" Visibility="Collapsed" />

                                            <StackPanel x:Name="PanelModalUpdateActions" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                <Button x:Name="BtnModalInstallUpdate" Content="Install New Version"
                                                        Style="{ThemeResource AccentButtonStyle}"
                                                        Visibility="Collapsed"
                                                        AutomationProperties.Name="Install New Version" />
                                                <Button x:Name="BtnModalRetryUpdate" Content="Retry"
                                                        Style="{ThemeResource AccentButtonStyle}"
                                                        Visibility="Collapsed"
                                                        AutomationProperties.Name="Retry Update" />
                                                <Button x:Name="BtnModalViewRelease" Content="View Release"
                                                        Visibility="Collapsed"
                                                        AutomationProperties.Name="View Release on GitHub" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
