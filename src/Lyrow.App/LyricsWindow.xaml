                                            <Slider x:Name="SliderModalArtworkSaturation" Minimum="10" Maximum="150" Value="100" StepFrequency="5" AutomationProperties.Name="Modal Artwork Saturation Slider" />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock x:Name="TxtModalArtworkRadiusLabel" Text="Artwork Corner Radius" FontWeight="Normal" FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtModalArtworkRadiusValue" Grid.Column="1" Text="24 px" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                            <Slider x:Name="SliderModalArtworkCornerRadius" Minimum="0" Maximum="64" Value="24" StepFrequency="1" AutomationProperties.Name="Modal Artwork Corner Radius Slider" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- TAB 3: LIGHTING (Işık: Ses Motoru, Ses Efektleri, Ses Çıkışı ve Kenar Işığı) -->
                                <StackPanel x:Name="ModalSectionLighting" Spacing="4" Visibility="Collapsed">
