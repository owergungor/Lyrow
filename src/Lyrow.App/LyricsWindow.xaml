<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lyrow.App.LyricsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Lyrow Lyrics"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout">
        <!-- Ambient Dynamic Artwork Gradient Background with Cinematic Vignette (Preserved) -->
        <Grid x:Name="AmbientBackgroundLayer" IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush x:Name="AmbientBrush" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="StopTopLeft" Color="#121218" Offset="0.0" />
                    <GradientStop x:Name="StopCenter" Color="#0C0E14" Offset="0.5" />
                    <GradientStop x:Name="StopBottomRight" Color="#08080C" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Rectangle Fill="#50000000" />
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                        <GradientStop Color="#00000000" Offset="0.0" />
                        <GradientStop Color="#30000000" Offset="0.6" />
                        <GradientStop Color="#70000000" Offset="1.0" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Main Window Container -->
        <Grid RowDefinitions="Auto,*">
            <!-- Custom WinUI 3 TitleBar -->
            <TitleBar x:Name="LyricsTitleBar" Grid.Row="0" Canvas.ZIndex="100" Title="Lyrow — Synchronized Lyrics">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="Assets/lyrow.ico" />
                </TitleBar.IconSource>
            </TitleBar>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" x:Name="MainViewportArea">
                <!-- VIEW 1: HORIZONTAL 50/50 PLAYER & LYRICS -->
                <Grid x:Name="HorizontalView" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColPlayer" Width="*" />
                        <ColumnDefinition x:Name="ColLyrics" Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column (50%): Player / Artwork Container -->
                    <Grid x:Name="PlayerColumnContainer" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,12">
                        <StackPanel x:Name="PlayerInnerPanel" Width="300" HorizontalAlignment="Center" Spacing="0">
                            <!-- 1. Album Artwork -->
                            <Border x:Name="BorderTrackArtwork" Width="300" Height="300" CornerRadius="16"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <Grid>
                                    <Image x:Name="ImgTrackArtwork" Stretch="UniformToFill" />
                                    <FontIcon x:Name="IconArtworkPlaceholder" Glyph="&#xE8D6;" FontSize="64"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- 2. Song Title -->
                            <TextBlock x:Name="TxtSongTitle" Text="Waiting for playback..." FontWeight="Bold"
                                       FontSize="22" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"
                                       Width="300" Margin="0,16,0,0" />

                            <!-- 3. Artist / Album -->
                            <TextBlock x:Name="TxtArtistAlbum" Text="No active media session" FontSize="14"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"
                                       Width="300" Margin="0,4,0,0" />

                            <!-- 4. Playback Progress Bar (Interactive Click/Drag Seek) -->
                            <Grid x:Name="GridProgressHitBox" Width="300" Height="16" Margin="0,10,0,0" Background="Transparent">
                                <ProgressBar x:Name="ProgressTimeline" Width="300" Height="4" CornerRadius="2"
                                             Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>

                            <!-- 5. Elapsed / Remaining Time -->
                            <Grid x:Name="GridTimestamps" Width="300" Margin="0,2,0,0">
                                <TextBlock x:Name="TxtElapsed" Text="0:00" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" />
                                <TextBlock x:Name="TxtRemaining" Text="-0:00" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- 6. Playback Device (Ghost Dropdown Selector) -->
                            <DropDownButton x:Name="BtnDeviceSelector"
                                            HorizontalAlignment="Center"
                                            Margin="0,8,0,0"
                                            Padding="10,4,10,4"
                                            CornerRadius="8"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Opacity="0.75"
                                            ToolTipService.ToolTip="Audio Output &amp; Analysis Endpoint (Click to change)">
                                <DropDownButton.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon x:Name="IconDevice" Glyph="&#xE767;" FontSize="12"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="TxtDevice" Text="Speakers" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   MaxWidth="240" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DropDownButton.Content>
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="FlyoutAudioDevices" Placement="Bottom">
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <!-- 7. Controls Row: Dar Mod button on left, Prev/Play/Next centered, Fullscreen button on right -->
                            <Grid x:Name="GridControlsRow" Width="300" Margin="0,12,0,0">
                                <!-- Dar Mod (Compact) Button: Y-aligned with Prev, X at artwork left edge -->
                                <Button x:Name="BtnDarMod" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Width="34" Height="34" Padding="0" CornerRadius="8"
                                        ToolTipService.ToolTip="Compact Player (Dar Mod)"
                                        AutomationProperties.Name="Compact Player">
                                    <FontIcon Glyph="&#xEE49;" FontSize="13" />
                                </Button>

                                <!-- Playback Controls Centered -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                                    <Button x:Name="BtnPrev" Width="36" Height="36" Padding="0" CornerRadius="18"
                                            ToolTipService.ToolTip="Previous Track" AutomationProperties.Name="Previous Track">
                                        <FontIcon Glyph="&#xE892;" FontSize="14" />
                                    </Button>
                                    <Button x:Name="BtnPlayPause" Width="46" Height="46" Padding="0" CornerRadius="23"
                                            Style="{ThemeResource AccentButtonStyle}" ToolTipService.ToolTip="Play / Pause"
                                            AutomationProperties.Name="Play or Pause">
                                        <FontIcon x:Name="IconPlayPause" Glyph="&#xE768;" FontSize="17" />
                                    </Button>
                                    <Button x:Name="BtnNext" Width="36" Height="36" Padding="0" CornerRadius="18"
                                            ToolTipService.ToolTip="Next Track" AutomationProperties.Name="Next Track">
                                        <FontIcon Glyph="&#xE893;" FontSize="14" />
                                    </Button>
                                </StackPanel>

                                <!-- Fullscreen Button: Y-aligned with Next, X at artwork right edge -->
                                <Button x:Name="BtnFullscreen" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Width="34" Height="34" Padding="0" CornerRadius="8"
                                        ToolTipService.ToolTip="Fullscreen (F11)"
                                        AutomationProperties.Name="Toggle Fullscreen">
                                    <FontIcon x:Name="IconFullscreen" Glyph="&#xE740;" FontSize="13" />
                                </Button>
                            </Grid>

                            <!-- 8. Volume Bar (Centered, width equals artwork) -->
                            <Grid x:Name="GridVolumeRow" Width="300" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnVolumeMute" Grid.Column="0" Width="28" Height="28" Padding="0"
                                        CornerRadius="6" Background="Transparent" BorderThickness="0"
                                        ToolTipService.ToolTip="Mute / Unmute" AutomationProperties.Name="Mute or Unmute">
                                    <FontIcon x:Name="IconVolumeMute" Glyph="&#xE767;" FontSize="12" />
                                </Button>
                                <Slider x:Name="SliderVolume" Grid.Column="1" Margin="6,0" Minimum="0" Maximum="100"
                                        Value="78" StepFrequency="1" IsThumbToolTipEnabled="False"
                                        AutomationProperties.Name="Volume Slider" />
                                <TextBlock x:Name="TxtVolumePercent" Grid.Column="2" Text="78%" FontSize="11" Width="32"
                                           VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>

                            <!-- 9. Below Volume Bar: Offset controls on left, Lyrics Toggle button on right edge -->
                            <Grid x:Name="GridOffsetRow" Width="300" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="4">
                                    <Button x:Name="BtnOffsetMinus" AutomationProperties.Name="Decrease Lyrics Offset by 250 ms" Content="−" Width="24" Height="24" Padding="0"
                                            CornerRadius="4" FontSize="11" ToolTipService.ToolTip="−250ms Delay" />
                                    <TextBlock x:Name="TxtOffsetMs" Text="0 ms" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0" />
                                    <Button x:Name="BtnOffsetPlus" AutomationProperties.Name="Increase Lyrics Offset by 250 ms" Content="+" Width="24" Height="24" Padding="0"
                                            CornerRadius="4" FontSize="11" ToolTipService.ToolTip="+250ms Advance" />
                                </StackPanel>

                                <!-- Lyrics Toggle Button: Below volume bar, X at artwork right edge -->
                                <Button x:Name="BtnToggleLyrics" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Width="34" Height="34" Padding="0" CornerRadius="8"
                                        ToolTipService.ToolTip="Toggle Lyrics Panel"
                                        AutomationProperties.Name="Toggle Lyrics">
                                    <FontIcon x:Name="IconToggleLyrics" Glyph="&#xEC4F;" FontSize="14" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Right Column (50%): Lyrics Viewport -->
                    <Grid x:Name="LyricsColumnContainer" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent">
                        <ScrollViewer x:Name="LyricsScrollViewer"
                                      VerticalScrollMode="Enabled"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollMode="Disabled"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsTabStop="True"
                                      Background="Transparent">
                            <StackPanel x:Name="LyricsPanel" Spacing="20" HorizontalAlignment="Stretch" Background="Transparent" />
                        </ScrollViewer>

                        <!-- Empty State Message -->
                        <Border x:Name="PanelEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                CornerRadius="16" Padding="32,28" MaxWidth="380"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                Visibility="Visible" IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" Spacing="14">
                                <Border Width="56" Height="56" CornerRadius="28"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center">
                                    <FontIcon x:Name="IconEmptyState" Glyph="&#xEC4F;" FontSize="26"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtEmptyState" Text="Waiting for playback..."
                                               FontWeight="SemiBold" FontSize="15"
                                               HorizontalAlignment="Center" TextAlignment="Center" />
                                    <TextBlock x:Name="TxtEmptyStateSub" Text="Play a song in Spotify, Apple Music, or your browser"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12.5"
                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" LineHeight="18" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- VIEW 2: DAR MOD (Compact Player Window Mode — Target Horizontal Reference Layout) -->
                <Grid x:Name="CompactPlayerView" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="12,20,12,6">
                    <Border x:Name="CompactPlayerCard" CornerRadius="0" Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="0">
                        <Grid x:Name="CompactGridContent" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Left Artwork + Right Song Title, Artist/Album, and Progress Scrubber with Elapsed/Remaining Time -->
                            <Grid x:Name="CompactTopRow" Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Album Artwork on the Left (~90x90 px at 150% DPI) -->
                                <Border x:Name="BorderTrackArtworkCompact" Width="60" Height="60" CornerRadius="8"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Grid>
                                        <Image x:Name="ImgTrackArtworkCompact" Stretch="UniformToFill" />
                                        <FontIcon x:Name="IconArtworkPlaceholderCompact" Glyph="&#xE8D6;" FontSize="22"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Right Side: Song Title (top), Artist/Album (below title), Progress Bar + Timestamps (below artist) -->
                                <StackPanel x:Name="CompactTrackAndProgressPanel" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1" HorizontalAlignment="Stretch">
                                    <TextBlock x:Name="TxtSongTitleCompact" Text="Waiting for playback..." FontWeight="SemiBold"
                                               FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock x:Name="TxtArtistAlbumCompact" Text="No active media session" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />

                                    <!-- Scrubber Progress Bar and Elapsed (bottom-left) / Remaining (bottom-right) Time -->
                                    <Grid x:Name="GridProgressCompactContainer" Margin="0,3,0,0" HorizontalAlignment="Stretch">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid x:Name="GridProgressCompactHitBox" Height="8" Background="Transparent" HorizontalAlignment="Stretch">
                                            <ProgressBar x:Name="ProgressTimelineCompact" Height="3" CornerRadius="1.5"
                                                         Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsHitTestVisible="False" />
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,1,0,0" HorizontalAlignment="Stretch">
                                            <TextBlock x:Name="TxtElapsedCompact" Text="0:00" FontSize="9.5"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                                            <TextBlock x:Name="TxtRemainingCompact" Text="-0:00" FontSize="9.5"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Row 1: Expandable Middle Lyrics Area (Strictly 3 Lines: Previous, Active, Next) -->
                            <Grid x:Name="GridCompactLyrics" Grid.Row="1" Visibility="Collapsed" Height="60" Margin="0,4,0,0">
                                <ScrollViewer x:Name="CompactLyricsScrollViewer" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="CompactLyricsPanel" Spacing="2" VerticalAlignment="Center"
                                                HorizontalAlignment="Stretch" Padding="4,0" />
                                </ScrollViewer>
                            </Grid>

                            <!-- Row 2: Bottom Horizontal Control Bar: Left Volume/Device, Center Prev/Play-Pause/Next, Right Lyrics & Normal Mode -->
                            <Grid x:Name="CompactControlsRow" Grid.Row="2" Margin="0,4,0,0" ColumnDefinitions="*,Auto,*">
                                <!-- Left: Volume/Mute + Audio Output Device Selector -->
                                <StackPanel x:Name="CompactLeftControlsPanel" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="2">
                                    <Button x:Name="BtnVolumeMuteCompact" Width="26" Height="26" Padding="0" CornerRadius="6"
                                            Background="Transparent" BorderThickness="0"
                                            ToolTipService.ToolTip="Volume"
                                            AutomationProperties.Name="Volume">
                                        <FontIcon x:Name="IconVolumeMuteCompact" Glyph="&#xE767;" FontSize="11"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Button.Flyout>
                                            <Flyout x:Name="FlyoutVolumeCompact" Placement="TopEdgeAlignedLeft" ShouldConstrainToRootBounds="False">
                                                <Flyout.FlyoutPresenterStyle>
                                                    <Style TargetType="FlyoutPresenter">
                                                        <Setter Property="Padding" Value="10,4,10,4" />
                                                        <Setter Property="MinWidth" Value="204" />
                                                        <Setter Property="MaxWidth" Value="228" />
                                                        <Setter Property="MinHeight" Value="38" />
                                                        <Setter Property="CornerRadius" Value="12" />
                                                        <Setter Property="Background" Value="#F21C1E26" />
                                                        <Setter Property="BorderBrush" Value="#38FFFFFF" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                    </Style>
                                                </Flyout.FlyoutPresenterStyle>
                                                <Grid x:Name="GridVolumePopupCompact" Width="192" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                                    <Button x:Name="BtnPopupMuteCompact" Grid.Column="0" Width="26" Height="26" Padding="0"
                                                            CornerRadius="6" Background="Transparent" BorderThickness="0"
                                                            ToolTipService.ToolTip="Mute / Unmute" AutomationProperties.Name="Mute or Unmute">
                                                        <FontIcon x:Name="IconPopupMuteCompact" Glyph="&#xE74F;" FontSize="12"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Button>
                                                    <Slider x:Name="SliderVolumeCompact" Grid.Column="1" Minimum="0" Maximum="100" Value="80"
                                                            VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                                                    <Button x:Name="BtnPopupVolumeMaxCompact" Grid.Column="2" Width="26" Height="26" Padding="0"
                                                            CornerRadius="6" Background="Transparent" BorderThickness="0"
                                                            ToolTipService.ToolTip="Volume" AutomationProperties.Name="Max Volume">
                                                        <FontIcon x:Name="IconPopupVolumeRightCompact" Glyph="&#xE767;" FontSize="12"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Button>
                                                </Grid>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <DropDownButton x:Name="BtnDeviceSelectorCompact"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Padding="4,2,4,2"
                                                    CornerRadius="6"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="0"
                                                    Opacity="0.8"
                                                    ToolTipService.ToolTip="Audio Output &amp; Analysis Endpoint (Click to change)">
                                        <DropDownButton.Content>
                                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                <FontIcon x:Name="IconDeviceCompact" Glyph="&#xE767;" FontSize="10"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Name="TxtDeviceCompact" Text="Speakers" FontSize="10.5"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="82" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DropDownButton.Content>
                                        <DropDownButton.Flyout>
                                            <MenuFlyout x:Name="FlyoutAudioDevicesCompact" Placement="Bottom">
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </StackPanel>

                                <!-- Center: Prev, Play/Pause, Next -->
                                <StackPanel x:Name="CompactCenterTransportPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                    <Button x:Name="BtnPrevCompact" Width="26" Height="26" Padding="0" CornerRadius="6"
                                            ToolTipService.ToolTip="Previous Track" AutomationProperties.Name="Previous Track">
                                        <FontIcon Glyph="&#xE892;" FontSize="11" />
                                    </Button>
                                    <Button x:Name="BtnPlayPauseCompact" Width="30" Height="30" Padding="0" CornerRadius="8"
                                            Style="{ThemeResource AccentButtonStyle}" ToolTipService.ToolTip="Play / Pause"
                                            AutomationProperties.Name="Play or Pause">
                                        <FontIcon x:Name="IconPlayPauseCompact" Glyph="&#xE768;" FontSize="12" />
                                    </Button>
                                    <Button x:Name="BtnNextCompact" Width="26" Height="26" Padding="0" CornerRadius="6"
                                            ToolTipService.ToolTip="Next Track" AutomationProperties.Name="Next Track">
                                        <FontIcon Glyph="&#xE893;" FontSize="11" />
                                    </Button>
                                </StackPanel>

                                <!-- Right: Lyrics Toggle button & Normal Mode / List View button -->
                                <StackPanel x:Name="CompactRightControlsPanel" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                                    <Button x:Name="BtnExpandFromCompact" Width="26" Height="26" Padding="0" CornerRadius="6"
                                            ToolTipService.ToolTip="Toggle Compact Lyrics"
                                            AutomationProperties.Name="Toggle Compact Lyrics">
                                        <FontIcon x:Name="IconExpandFromCompact" Glyph="&#xEC4F;" FontSize="11" />
                                    </Button>
                                    <Button x:Name="BtnNormalModeCompact" Width="26" Height="26" Padding="0" CornerRadius="6"
                                            ToolTipService.ToolTip="Normal mode"
                                            AutomationProperties.Name="Normal mode">
                                        <FontIcon x:Name="IconNormalModeCompact" Glyph="&#xE8FD;" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Window-Scoped Toast Notification Overlay for LyricsWindow & Compact Player -->
                <StackPanel x:Name="LyricsToastContainer"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                            Margin="0,12,16,0"
                            Spacing="8"
                            Canvas.ZIndex="1000" />
            </Grid>
        </Grid>
    </Grid>
</Window>
