<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lyrow.App.LyricsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Lyrow Lyrics"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout">
        <!-- Ambient Dynamic Artwork Gradient Background with Cinematic Vignette (Preserved) -->
        <Grid x:Name="AmbientBackgroundLayer" IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush x:Name="AmbientBrush" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="StopTopLeft" Color="#121218" Offset="0.0" />
                    <GradientStop x:Name="StopCenter" Color="#0C0E14" Offset="0.5" />
                    <GradientStop x:Name="StopBottomRight" Color="#08080C" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Rectangle Fill="#50000000" />
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                        <GradientStop Color="#00000000" Offset="0.0" />
                        <GradientStop Color="#30000000" Offset="0.6" />
                        <GradientStop Color="#70000000" Offset="1.0" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Main Window Container -->
        <Grid RowDefinitions="Auto,*">
            <!-- Custom WinUI 3 TitleBar -->
            <TitleBar x:Name="LyricsTitleBar" Grid.Row="0" Title="Lyrow — Synchronized Lyrics">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="Assets/lyrow.ico" />
                </TitleBar.IconSource>
            </TitleBar>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" x:Name="MainViewportArea">
                <!-- VIEW 1: HORIZONTAL 50/50 PLAYER & LYRICS -->
                <Grid x:Name="HorizontalView" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColPlayer" Width="*" />
                        <ColumnDefinition x:Name="ColLyrics" Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column (50%): Player / Artwork Container -->
                    <Grid x:Name="PlayerColumnContainer" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,12">
                        <StackPanel x:Name="PlayerInnerPanel" Width="300" HorizontalAlignment="Center" Spacing="0">
                            <!-- 1. Album Artwork -->
                            <Border Width="300" Height="300" CornerRadius="16"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <Grid>
                                    <Image x:Name="ImgTrackArtwork" Stretch="UniformToFill" />
                                    <FontIcon x:Name="IconArtworkPlaceholder" Glyph="&#xE8D6;" FontSize="64"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- 2. Song Title -->
                            <TextBlock x:Name="TxtSongTitle" Text="Waiting for playback..." FontWeight="Bold"
                                       FontSize="22" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"
                                       Width="300" Margin="0,16,0,0" />

                            <!-- 3. Artist / Album -->
                            <TextBlock x:Name="TxtArtistAlbum" Text="No active media session" FontSize="14"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"
                                       Width="300" Margin="0,4,0,0" />

                            <!-- 4. Playback Progress Bar -->
                            <ProgressBar x:Name="ProgressTimeline" Width="300" Height="4" CornerRadius="2"
                                         Minimum="0" Maximum="100" Value="0" Margin="0,14,0,0" />

                            <!-- 5. Elapsed / Remaining Time -->
                            <Grid Width="300" Margin="0,4,0,0">
                                <TextBlock x:Name="TxtElapsed" Text="0:00" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" />
                                <TextBlock x:Name="TxtRemaining" Text="-0:00" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- 6. Playback Device (Centered: [Icon] Device Name) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,10,0,0">
                                <FontIcon x:Name="IconDevice" Glyph="&#xE767;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TxtDevice" Text="Speakers" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           MaxWidth="260" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- 7. Controls Row: Dar Mod button on left, Prev/Play/Next centered, Fullscreen button on right -->
                            <Grid Width="300" Margin="0,12,0,0">
                                <!-- Dar Mod (Compact) Button: Y-aligned with Prev, X at artwork left edge -->
                                <Button x:Name="BtnDarMod" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Width="34" Height="34" Padding="0" CornerRadius="8"
                                        ToolTipService.ToolTip="Compact Player (Dar Mod)"
                                        AutomationProperties.Name="Compact Player">
                                    <FontIcon Glyph="&#xEE49;" FontSize="13" />
                                </Button>

                                <!-- Playback Controls Centered -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                                    <Button x:Name="BtnPrev" Width="36" Height="36" Padding="0" CornerRadius="18"
                                            ToolTipService.ToolTip="Previous Track" AutomationProperties.Name="Previous Track">
                                        <FontIcon Glyph="&#xE892;" FontSize="14" />
                                    </Button>
                                    <Button x:Name="BtnPlayPause" Width="46" Height="46" Padding="0" CornerRadius="23"
                                            Style="{ThemeResource AccentButtonStyle}" ToolTipService.ToolTip="Play / Pause"
                                            AutomationProperties.Name="Play or Pause">
                                        <FontIcon x:Name="IconPlayPause" Glyph="&#xE768;" FontSize="17" />
                                    </Button>
                                    <Button x:Name="BtnNext" Width="36" Height="36" Padding="0" CornerRadius="18"
                                            ToolTipService.ToolTip="Next Track" AutomationProperties.Name="Next Track">
                                        <FontIcon Glyph="&#xE893;" FontSize="14" />
                                    </Button>
                                </StackPanel>

                                <!-- Fullscreen Button: Y-aligned with Next, X at artwork right edge -->
                                <Button x:Name="BtnFullscreen" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Width="34" Height="34" Padding="0" CornerRadius="8"
                                        ToolTipService.ToolTip="Fullscreen (F11)"
                                        AutomationProperties.Name="Toggle Fullscreen">
                                    <FontIcon x:Name="IconFullscreen" Glyph="&#xE740;" FontSize="13" />
                                </Button>
                            </Grid>

                            <!-- 8. Volume Bar (Centered, width equals artwork = 300px) -->
                            <Grid Width="300" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnVolumeMute" Grid.Column="0" Width="28" Height="28" Padding="0"
                                        CornerRadius="6" Background="Transparent" BorderThickness="0"
                                        ToolTipService.ToolTip="Mute / Unmute" AutomationProperties.Name="Mute or Unmute">
                                    <FontIcon x:Name="IconVolumeMute" Glyph="&#xE767;" FontSize="12" />
                                </Button>
                                <Slider x:Name="SliderVolume" Grid.Column="1" Margin="6,0" Minimum="0" Maximum="100"
                                        Value="78" StepFrequency="1" IsThumbToolTipEnabled="False"
                                        AutomationProperties.Name="Volume Slider" />
                                <TextBlock x:Name="TxtVolumePercent" Grid.Column="2" Text="78%" FontSize="11" Width="32"
                                           VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>

                            <!-- 9. Below Volume Bar: Offset controls on left, Lyrics Toggle button on right edge -->
                            <Grid Width="300" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="4">
                                    <Button x:Name="BtnOffsetMinus" Content="−" Width="24" Height="24" Padding="0"
                                            CornerRadius="4" FontSize="11" ToolTipService.ToolTip="−250ms Delay" />
                                    <TextBlock x:Name="TxtOffsetMs" Text="0 ms" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0" />
                                    <Button x:Name="BtnOffsetPlus" Content="+" Width="24" Height="24" Padding="0"
                                            CornerRadius="4" FontSize="11" ToolTipService.ToolTip="+250ms Advance" />
                                </StackPanel>

                                <!-- Lyrics Toggle Button: Below volume bar, X at artwork right edge -->
                                <Button x:Name="BtnToggleLyrics" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Width="34" Height="34" Padding="0" CornerRadius="8"
                                        ToolTipService.ToolTip="Toggle Lyrics Panel"
                                        AutomationProperties.Name="Toggle Lyrics">
                                    <FontIcon x:Name="IconToggleLyrics" Glyph="&#xEC4F;" FontSize="14" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Right Column (50%): Lyrics Viewport -->
                    <Grid x:Name="LyricsColumnContainer" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent">
                        <ScrollViewer x:Name="LyricsScrollViewer"
                                      VerticalScrollMode="Enabled"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollMode="Disabled"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsTabStop="True"
                                      Background="Transparent">
                            <StackPanel x:Name="LyricsPanel" Spacing="20" HorizontalAlignment="Stretch" Background="Transparent" />
                        </ScrollViewer>

                        <!-- Empty State Message -->
                        <StackPanel x:Name="PanelEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="12" Visibility="Visible" IsHitTestVisible="False">
                            <FontIcon Glyph="&#xEC4F;" FontSize="38" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="TxtEmptyState" Text="Play a song in Spotify, Apple Music, or your browser"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14"
                                       HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="320" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- VIEW 2: DAR MOD (Compact Player Window Mode — Apple Music Reference) -->
                <Grid x:Name="CompactPlayerView" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="14,8,14,12">
                    <Border CornerRadius="14" Padding="14,10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="64,*">
                            <!-- Album Artwork on the Left -->
                            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="64" Height="64" CornerRadius="10"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Grid>
                                    <Image x:Name="ImgTrackArtworkCompact" Stretch="UniformToFill" />
                                    <FontIcon x:Name="IconArtworkPlaceholderCompact" Glyph="&#xE8D6;" FontSize="24"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Right Side: Song Title & Artist -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSongTitleCompact" Text="Waiting for playback..." FontWeight="Bold"
                                           FontSize="15" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="TxtArtistAlbumCompact" Text="No active media session" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Scrubber Progress Bar and Elapsed / Remaining Time -->
                            <Grid Grid.Row="1" Grid.Column="1" Margin="14,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ProgressBar x:Name="ProgressTimelineCompact" Height="3" CornerRadius="1.5"
                                             Minimum="0" Maximum="100" Value="0" />
                                <Grid Grid.Row="1" Margin="0,3,0,0">
                                    <TextBlock x:Name="TxtElapsedCompact" Text="0:00" FontSize="10"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TxtRemainingCompact" Text="-0:00" FontSize="10"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>

                            <!-- Bottom Row: Device Info on left, Centered Prev/Play/Next, Expand/Lyrics button on right -->
                            <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                <!-- Left: [Speaker/Headphone Icon] Device Name -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="5">
                                    <FontIcon x:Name="IconDeviceCompact" Glyph="&#xE767;" FontSize="11"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtDeviceCompact" Text="Speakers" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Center: Prev, Play/Pause, Next -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                    <Button x:Name="BtnPrevCompact" Width="30" Height="30" Padding="0" CornerRadius="6"
                                            ToolTipService.ToolTip="Previous Track" AutomationProperties.Name="Previous Track">
                                        <FontIcon Glyph="&#xE892;" FontSize="11" />
                                    </Button>
                                    <Button x:Name="BtnPlayPauseCompact" Width="34" Height="34" Padding="0" CornerRadius="8"
                                            Style="{ThemeResource AccentButtonStyle}" ToolTipService.ToolTip="Play / Pause"
                                            AutomationProperties.Name="Play or Pause">
                                        <FontIcon x:Name="IconPlayPauseCompact" Glyph="&#xE768;" FontSize="13" />
                                    </Button>
                                    <Button x:Name="BtnNextCompact" Width="30" Height="30" Padding="0" CornerRadius="6"
                                            ToolTipService.ToolTip="Next Track" AutomationProperties.Name="Next Track">
                                        <FontIcon Glyph="&#xE893;" FontSize="11" />
                                    </Button>
                                </StackPanel>

                                <!-- Right: Volume & Expand to Horizontal Lyrics Window -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                                    <Button x:Name="BtnVolumeCompact" Width="28" Height="28" Padding="0" CornerRadius="6"
                                            ToolTipService.ToolTip="Volume / Mute" AutomationProperties.Name="Volume Mute">
                                        <FontIcon x:Name="IconVolumeCompact" Glyph="&#xE767;" FontSize="11" />
                                    </Button>
                                    <Button x:Name="BtnExpandFromCompact" Width="28" Height="28" Padding="0" CornerRadius="6"
                                            ToolTipService.ToolTip="Expand to Lyrics Window (♫)"
                                            AutomationProperties.Name="Expand to Lyrics Window">
                                        <FontIcon Glyph="&#xEC4F;" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
