<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lyrow.App.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="LyrowWindowBackground" Color="#181825" />
                    <SolidColorBrush x:Key="LyrowCardBackground" Color="#1E1E2E" />
                    <SolidColorBrush x:Key="LyrowInnerContainerBackground" Color="#11111B" />
                    <SolidColorBrush x:Key="LyrowBorderBrush" Color="#313244" />
                    <SolidColorBrush x:Key="LyrowTextPrimary" Color="#CDD6F4" />
                    <SolidColorBrush x:Key="LyrowTextSecondary" Color="#A6ADC8" />
                    <SolidColorBrush x:Key="LyrowTextMuted" Color="#6C7086" />
                    <SolidColorBrush x:Key="LyrowSubtleButtonBackground" Color="#252538" />
                    <SolidColorBrush x:Key="LyrowBadgeBackground" Color="#1E1E2E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="LyrowWindowBackground" Color="#181825" />
                    <SolidColorBrush x:Key="LyrowCardBackground" Color="#1E1E2E" />
                    <SolidColorBrush x:Key="LyrowInnerContainerBackground" Color="#11111B" />
                    <SolidColorBrush x:Key="LyrowBorderBrush" Color="#313244" />
                    <SolidColorBrush x:Key="LyrowTextPrimary" Color="#CDD6F4" />
                    <SolidColorBrush x:Key="LyrowTextSecondary" Color="#A6ADC8" />
                    <SolidColorBrush x:Key="LyrowTextMuted" Color="#6C7086" />
                    <SolidColorBrush x:Key="LyrowSubtleButtonBackground" Color="#252538" />
                    <SolidColorBrush x:Key="LyrowBadgeBackground" Color="#1E1E2E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="LyrowWindowBackground" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="LyrowCardBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LyrowInnerContainerBackground" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="LyrowBorderBrush" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="LyrowTextPrimary" Color="#0F172A" />
                    <SolidColorBrush x:Key="LyrowTextSecondary" Color="#334155" />
                    <SolidColorBrush x:Key="LyrowTextMuted" Color="#64748B" />
                    <SolidColorBrush x:Key="LyrowSubtleButtonBackground" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="LyrowBadgeBackground" Color="#E2E8F0" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        
        <!-- Neumorphic & Modern Dashboard Styling -->
        <Style Selector="Border.neumorphic-card">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.module-card">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,8" />
        </Style>

        <Style Selector="Button.action-button">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="TextBlock.header">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="TextBlock.subheader">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>
    </Application.Styles>
</Application>